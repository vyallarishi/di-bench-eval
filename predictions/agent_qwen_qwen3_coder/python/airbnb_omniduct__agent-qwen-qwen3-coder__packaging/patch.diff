+#!/usr/bin/env python3
+
+# Test script to verify dependencies functionality works without packaging
+
+try:
+    from omniduct.utils.dependencies import check_dependencies, _is_package_installed
+    print("Successfully imported dependencies module")
+    
+    # Test basic functionality
+    result = _is_package_installed("numpy")
+    print(f"_is_package_installed('numpy') returned: {result}")
+    
+    # Test with version spec (if numpy is installed)
+    result = _is_package_installed("numpy>=1.0.0")
+    print(f"_is_package_installed('numpy>=1.0.0') returned: {result}")
+    
+    print("All tests passed!")
+    
+except Exception as e:
+    print(f"Error: {e}")
+    import traceback
+    traceback.print_exc()
