+#!/usr/bin/env python3
+
+"""
+Script to verify that our changes work correctly by running a simple test.
+"""
+
+import sys
+import torch
+try:
+    import torchode as to
+    from torchode.problems import InitialValueProblem
+    from torchode.single_step_methods.runge_kutta import ButcherTableau
+    
+    def test_basic_functionality():
+        """Test that basic functionality still works after removing torchtyping."""
+        
+        # Test that we can create tensor types
+        from torchode.typing import DataTensor, TimeTensor
+        
+        # Test that we can create coefficient vectors
+        from torchode.single_step_methods.runge_kutta import CoefficientVector, RungeKuttaMatrix, WeightVector
+        
+        # Create a simple ODE problem
+        def f(t, y):
+            return -y
+        
+        # Test creating tensors
+        t_data = torch.tensor([1.0, 2.0])
+        y_data = torch.tensor([[1.0], [2.0]])
+        
+        print("Basic functionality test passed!")
+        return True
+        
+    if __name__ == "__main__":
+        if test_basic_functionality():
+            print("All tests passed!")
+            sys.exit(0)
+        else:
+            print("Tests failed!")
+            sys.exit(1)
+            
+except ImportError as e:
+    print(f"Import error: {e}")
+    sys.exit(1)
+    
+    print("Basic functionality test passed!")
+
+if __name__ == "__main__":
