@@ -0,0 +1,46 @@
+import sys
+import os
+import pytest
+from datetime import datetime, timedelta
+import zoneinfo
+
+# Add the src directory to the path so we can import aioclock
+sys.path.insert(0, os.path.join(os.path.dirname(__file__)))
+
+# Test our custom cron implementation
+def test_custom_cron_parsing():
+    from aioclock.triggers import Cron
+    
+    # Test basic cron validation
+    assert Cron._is_valid_cron("0 12 * * *") == True
+    assert Cron._is_valid_cron("invalid") == False
+    assert Cron._is_valid_cron("* * * *") == False  # Too few parts
+    
+    # Test cron part validation
+    assert Cron._is_valid_cron_part("*", 0) == True
+    assert Cron._is_valid_cron_part("0", 0) == True
+    assert Cron._is_valid_cron_part("*/5", 0) == True
+    assert Cron._is_valid_cron_part("1-5", 0) == True
+    assert Cron._is_valid_cron_part("1,3,5", 0) == True
+    
+    # Test value matching
+    assert Cron._matches_cron_part(5, "5") == True
+    assert Cron._matches_cron_part(5, "*") == True
+    assert Cron._matches_cron_part(5, "*/5") == True
+    assert Cron._matches_cron_part(3, "*/5") == False
+    assert Cron._matches_cron_part(3, "1-5") == True
+    assert Cron._matches_cron_part(7, "1-5") == False
+    assert Cron._matches_cron_part(3, "1,3,5") == True
+    assert Cron._matches_cron_part(4, "1,3,5") == False
+
+if __name__ == "__main__":
+    test_custom_cron_parsing()
+    print("All tests passed!")
+    assert Cron._matches_cron_part(3, "1-5") == True
+    assert Cron._matches_cron_part(7, "1-5") == False
+    assert Cron._matches_cron_part(3, "1,3,5") == True
+    assert Cron._matches_cron_part(4, "1,3,5") == False
+
+if __name__ == "__main__":
+    test_custom_cron_parsing()
+    print("All tests passed!")
