+"""
+Simple dependency injection implementation to replace fast_depends.
+"""
+
+import asyncio
+import inspect
+from typing import Any, Awaitable, Callable, Dict, Optional, TypeVar, Union, get_type_hints
+
+from aioclock.provider import get_provider
+
+T = TypeVar("T")
+P = TypeVar("P")
+
+
+class Depends:
+    """Dependency marker for function parameters."""
+
+    def __init__(self, dependency: Callable[..., Any], *, use_cache: bool = True):
+        self.dependency = dependency
+        self.use_cache = use_cache
+
+
+def _get_annotation_type(annotation: Any) -> Optional[type]:
+    """Extract the actual type from annotations."""
+    if hasattr(annotation, "__origin__"):
+        # Handle generic types like List[int], Optional[str], etc.
+        return annotation.__origin__
+    return annotation
+
+
+def _is_coroutine_function(func: Callable[..., Any]) -> bool:
+    """Check if a function is a coroutine function."""
+    return asyncio.iscoroutinefunction(func) or (
+        hasattr(func, "__call__") and asyncio.iscoroutinefunction(func.__call__)
+    )
+
+
+async def _resolve_dependencies(
+    func: Callable[..., Any], overrides: Optional[Dict[Callable[..., Any], Callable[..., Any]]] = None
+) -> Dict[str, Any]:
+    """Resolve dependencies for a function."""
+    if overrides is None:
+        overrides = {}
+        
+    # Get function signature
+    sig = inspect.signature(func)
+    hints = get_type_hints(func)
+    
+    resolved_deps = {}
+    provider = get_provider()
+    
+    for param_name, param in sig.parameters.items():
+        # Check if parameter has a Depends annotation
+        if param_name in hints and hasattr(hints[param_name], '__metadata__'):
+            # Handle Annotated types (Python 3.9+)
+            annotation = hints[param_name]
+            if hasattr(annotation, '__metadata__'):
+                for meta in annotation.__metadata__:
+                    if isinstance(meta, Depends):
+                        dep_func = meta.dependency
+                        
+                        # Check for override
+                        if dep_func in overrides:
+                            dep_func = overrides[dep_func]
+                        
+                        # Resolve the dependency
+                        if _is_coroutine_function(dep_func):
+                            resolved_deps[param_name] = await dep_func()
+                        else:
+                            resolved_deps[param_name] = dep_func()
+                        break
+        elif param.default is not inspect.Parameter.empty:
+            # Handle default values
+            if isinstance(param.default, Depends):
+                dep_func = param.default.dependency
+                
+                # Check for override
+                if dep_func in overrides:
+                    dep_func = overrides[dep_func]
+                
+                # Resolve the dependency
+                if _is_coroutine_function(dep_func):
+                    resolved_deps[param_name] = await dep_func()
+                else:
+                    resolved_deps[param_name] = dep_func()
+    
+    return resolved_deps
+
+
+def inject(
+    func: Callable[..., T],
+    dependency_overrides_provider: Optional[Callable[[], Dict[Callable[..., Any], Callable[..., Any]]]] = None,
+) -> Callable[..., Union[T, Awaitable[T]]]:
+    """Inject dependencies into a function."""
+    
+    def wrapper(*args, **kwargs):
+        overrides = {}
+        if dependency_overrides_provider:
+            overrides = dependency_overrides_provider()
+        
+        async def async_wrapper():
+            # Resolve dependencies
+            deps = asyncio.run(_resolve_dependencies(func, overrides))
+            # Merge with provided kwargs
+            final_kwargs = {**deps, **kwargs}
+            
+            # Call the original function
+            result = func(*args, **final_kwargs)
+            if asyncio.iscoroutine(result):
+                return await result
+            return result
+            
+        # If the original function is sync, we can run it directly
+        if not asyncio.iscoroutinefunction(func):
+            # For sync functions, we need to resolve dependencies synchronously
+            deps = asyncio.run(_resolve_dependencies(func, overrides))
+            final_kwargs = {**deps, **kwargs}
+            return func(*args, **final_kwargs)
+        else:
+            # For async functions, return a coroutine
+            return async_wrapper()
+            
+    return wrapper
