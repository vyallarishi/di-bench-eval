+def resize(array, shape: Tuple[int, int]):
+    """Resize a 2D array to a given shape."""
+    old_height, old_width = len(array), len(array[0]) if array else 0
+    new_height, new_width = shape
+    
+    # Create new array filled with zeros
+    result = [[0.0 for _ in range(new_width)] for _ in range(new_height)]
+    
+    # Calculate scaling factors
+    height_ratio = old_height / new_height
+    width_ratio = old_width / new_width
+    
+    # Resize using nearest neighbor interpolation
+    for i in range(new_height):
+        for j in range(new_width):
+            old_i = min(int(i * height_ratio), old_height - 1)
+            old_j = min(int(j * width_ratio), old_width - 1)
+            result[i][j] = array[old_i][old_j]
+            
+    return result
