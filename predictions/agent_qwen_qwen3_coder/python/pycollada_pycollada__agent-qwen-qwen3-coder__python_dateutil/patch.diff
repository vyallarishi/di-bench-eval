+#!/usr/bin/env python
+
+import datetime
+import sys
+import os
+
+# Test our date parsing implementation
+def _parse_date(date_string):
+    """Parse ISO format date string to datetime object."""
+    if not date_string:
+        return None
+        
+    try:
+        # Handle the 'Z' suffix by replacing it with '+00:00'
+        if date_string.endswith('Z'):
+            date_string = date_string[:-1] + '+00:00'
+        return datetime.datetime.fromisoformat(date_string)
+    except (ValueError, AttributeError):
+        # Fall back to manual parsing for older Python versions
+        try:
+            # Remove Z suffix and parse
+            if date_string.endswith('Z'):
+                date_string = date_string[:-1]
+            return datetime.datetime.strptime(date_string, '%Y-%m-%dT%H:%M:%S')
+        except ValueError:
+            return None
+
+# Test cases from the actual data
+test_cases = [
+    ('2006-08-23T22:29:59Z', datetime.datetime(2006, 8, 23, 22, 29, 59)),
+    ('2007-02-21T22:52:44Z', datetime.datetime(2007, 2, 21, 22, 52, 44)),
+]
+
+print("Testing date parsing implementation...")
+all_passed = True
+
+for input_str, expected in test_cases:
+    result = _parse_date(input_str)
+    match = result == expected
+    print(f"Input: {input_str}")
+    print(f"Expected: {expected}")
+    print(f"Result: {result}")
+    print(f"Match: {match}")
+    if not match:
+        print("ERROR: Date parsing failed!")
+        all_passed = False
+    print()
+
+if all_passed:
+    print("SUCCESS: All date parsing tests passed!")
+else:
+    print("FAILURE: Some date parsing tests failed!")
+    sys.exit(1)
