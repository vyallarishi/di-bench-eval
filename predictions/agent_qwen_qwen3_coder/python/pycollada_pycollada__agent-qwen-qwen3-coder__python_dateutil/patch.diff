+#!/usr/bin/env python
+
+import sys
+import os
+
+# Check that dateutil is not imported anywhere
+print("Checking for dateutil imports...")
+
+# Search for any remaining dateutil imports
+import glob
+
+files_with_dateutil = []
+for py_file in glob.glob("**/*.py", recursive=True):
+    try:
+        with open(py_file, 'r') as f:
+            content = f.read()
+            if 'dateutil' in content and 'from dateutil' in content:
+                files_with_dateutil.append(py_file)
+                print(f"Found dateutil import in: {py_file}")
+    except Exception:
+        pass  # Skip files that can't be read
+
+if files_with_dateutil:
+    print("ERROR: Found remaining dateutil imports!")
+    sys.exit(1)
+else:
+    print("SUCCESS: No dateutil imports found!")
+
+# Check pyproject.toml doesn't list python-dateutil
+try:
+    with open('pyproject.toml', 'r') as f:
+        content = f.read()
+        if 'python-dateutil' in content:
+            print("ERROR: python-dateutil still listed in pyproject.toml!")
+            sys.exit(1)
+        else:
+            print("SUCCESS: python-dateutil removed from pyproject.toml!")
+except Exception as e:
+    print(f"Error checking pyproject.toml: {e}")
+    sys.exit(1)
