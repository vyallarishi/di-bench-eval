+    if 'dateutil' in content and 'from dateutil' in content:
+        print("ERROR: dateutil still imported in asset.py")
+        sys.exit(1)
+
+print("SUCCESS: No dateutil imports found in asset.py")
+
+# Check that python-dateutil is removed from pyproject.toml
+with open('pyproject.toml', 'r') as f:
+    content = f.read()
+    if 'python-dateutil' in content:
+        print("ERROR: python-dateutil still in pyproject.toml")
+        sys.exit(1)
+
