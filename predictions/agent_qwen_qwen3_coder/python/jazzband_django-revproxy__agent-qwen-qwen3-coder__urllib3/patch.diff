--- /dev/null
+++ b/revproxy/urllib_compat.py
@@ -0,0 +1,75 @@
+"""
+Compatibility layer to replace urllib3 with urllib.request
+"""
+import urllib.request
+import urllib.error
+from collections import defaultdict
+from io import BytesIO
+
+
+class CompatHeaders:
+    """A headers class that mimics urllib3 response headers interface"""
+    
+    def __init__(self, headers_list):
+        # Store as list of tuples to preserve multiple headers with same name
+        self._headers_list = headers_list or []
+        # Also store as dict for quick access (last value wins for same keys)
+        self._headers_dict = {}
+        for key, value in self._headers_list:
+            self._headers_dict[key.lower()] = value
+    
+    def get(self, key, default=None):
+        return self._headers_dict.get(key.lower(), default)
+        
+    def __getitem__(self, key):
+        return self._headers_dict[key.lower()]
+        
+    def __contains__(self, key):
+        return key.lower() in self._headers_dict
+        
+    def getlist(self, key):
+        """Get all values for a header key"""
+        key_lower = key.lower()
+        return [value for header_key, value in self._headers_list if header_key.lower() == key_lower]
+
+
+class CompatHTTPResponse:
+    """A response class that mimics urllib3.HTTPResponse interface"""
+    
+    def __init__(self, urllib_response):
+        self._response = urllib_response
+        # Convert headers to urllib3-like format
+        headers_list = []
+        for key, value in self._response.headers.items():
+            # Headers can have multiple values, so we need to handle that
+            if isinstance(value, list):
+                for v in value:
+                    headers_list.append((key, v))
+            else:
+                headers_list.append((key, value))
+        self.headers = CompatHeaders(headers_list)
+        self.status = self._response.status
+        self.reason = getattr(self._response, 'reason', '')
+        
+    @property
+    def data(self):
+        """Return response body as bytes"""
+        return self._response.read()
+        
+    def stream(self, amt=65536):
+        """Stream response data in chunks"""
+        while True:
+            chunk = self._response.read(amt)
+            if not chunk:
+                break
+            yield chunk
+            
+    def read(self, amt=None):
+        """Read response data"""
+        return self._response.read(amt) if amt else self._response.read()
+
+
+def create_request(method, url, headers=None, body=None):
+    """Create a urllib.request.Request object"""
+    req = urllib.request.Request(url, data=body, headers=headers or {}, method=method)
+    return req
