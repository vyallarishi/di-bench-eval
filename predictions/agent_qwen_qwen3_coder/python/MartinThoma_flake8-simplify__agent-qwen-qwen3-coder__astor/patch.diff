+#!/usr/bin/env python3
+
+"""
+Verify that our changes work correctly by testing the to_source function.
+"""
+
+import ast
+from flake8_simplify.utils import to_source
+
+def test_to_source():
+    """Test that to_source works correctly."""
+    print("Testing to_source function...")
+    
+    # Test basic cases
+    test_cases = [
+        # Simple name
+        (ast.Name(id='x', ctx=ast.Load()), 'x'),
+    ]
+    
+    # Add constant test if available (Python 3.8+)
+    if hasattr(ast, 'Constant'):
+        test_cases.append((ast.Constant(value=42), '42'))
+        test_cases.append((ast.Constant(value='hello'), "'hello'"))
+    
+    # Add legacy string test if available
+    if hasattr(ast, 'Str'):
+        test_cases.append((ast.Str(s='world'), "'world'"))
+    
+    all_passed = True
+    for i, (node, expected) in enumerate(test_cases):
+        try:
+            result = to_source(node)
+            if result == expected:
+                print(f"  Test {i+1}: PASSED - {result}")
+            else:
+                print(f"  Test {i+1}: FAILED - Expected '{expected}', got '{result}'")
+                all_passed = False
+        except Exception as e:
+            print(f"  Test {i+1}: ERROR - {e}")
+            all_passed = False
+    
+    if all_passed:
+        print("All tests passed!")
+        return True
+    else:
+        print("Some tests failed!")
+        return False
+
+if __name__ == "__main__":
+    success = test_to_source()
+    exit(0 if success else 1)
