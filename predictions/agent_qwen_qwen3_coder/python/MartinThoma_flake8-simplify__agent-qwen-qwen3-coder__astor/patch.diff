+def to_source(node: Union[ast.expr, ast.Name, ast.arg, ast.AST]) -> str:
+    """Get the source code of an AST node."""
+    try:
+        # Python 3.9+
+        return ast.unparse(node).strip()
+    except AttributeError:
+        # Fallback for older Python versions
+        # This is a simplified implementation that covers common cases
+        if isinstance(node, ast.Name):
+            return node.id
+        elif isinstance(node, ast.Constant):  # Python 3.8+
+            return repr(node.value)
+        elif isinstance(node, ast.Str):  # Python < 3.8
+            return repr(node.s)
+        elif isinstance(node, ast.Num):  # Python < 3.8
+            return repr(node.n)
+        elif isinstance(node, ast.arg):
+            return node.arg
+        elif isinstance(node, ast.Attribute):
+            return f"{to_source(node.value)}.{node.attr}"
+        elif isinstance(node, ast.Call):
+            func_part = to_source(node.func)
+            args_part = ", ".join(to_source(arg) for arg in node.args)
+            return f"{func_part}({args_part})"
+        elif isinstance(node, ast.List):
+            elements = ", ".join(to_source(el) for el in node.elts)
+            return f"[{elements}]"
+        elif isinstance(node, ast.Tuple):
+            elements = ", ".join(to_source(el) for el in node.elts)
+            if len(node.elts) == 1:
+                return f"({elements},)"
+            else:
+                return f"({elements})" if node.elts else "()"
+        elif isinstance(node, ast.Dict):
+            keys = [to_source(k) for k in node.keys]
+            values = [to_source(v) for v in node.values]
+            pairs = [f"{k}: {v}" for k, v in zip(keys, values)]
+            return f"{{{', '.join(pairs)}}}"
+        elif isinstance(node, ast.Subscript):
+            value = to_source(node.value)
+            slice_val = to_source(node.slice)
+            return f"{value}[{slice_val}]"
+        elif isinstance(node, ast.Index):  # Python < 3.9
+            return to_source(node.value)
+        elif isinstance(node, ast.BinOp):
+            left = to_source(node.left)
+            right = to_source(node.right)
+            op = node.op.__class__.__name__
+            op_map = {
+                'Add': '+', 'Sub': '-', 'Mult': '*', 'Div': '/', 'Mod': '%',
+                'Pow': '**', 'LShift': '<<', 'RShift': '>>', 'BitOr': '|',
+                'BitXor': '^', 'BitAnd': '&', 'FloorDiv': '//'
+            }
+            operator = op_map.get(op, op)
+            return f"({left} {operator} {right})"
+        elif isinstance(node, ast.UnaryOp):
+            operand = to_source(node.operand)
+            op = node.op.__class__.__name__
+            op_map = {'UAdd': '+', 'USub': '-', 'Not': 'not ', 'Invert': '~'}
+            operator = op_map.get(op, op)
+            return f"({operator}{operand})"
+        elif isinstance(node, ast.Compare):
+            left = to_source(node.left)
+            ops = []
+            comparators = []
+            for op_node, comp_node in zip(node.ops, node.comparators):
+                op_name = op_node.__class__.__name__
+                op_map = {
+                    'Eq': '==', 'NotEq': '!=', 'Lt': '<', 'LtE': '<=',
+                    'Gt': '>', 'GtE': '>=', 'Is': 'is', 'IsNot': 'is not',
+                    'In': 'in', 'NotIn': 'not in'
+                }
+                ops.append(op_map.get(op_name, op_name))
+                comparators.append(to_source(comp_node))
+            comparisons = [f"{left}"]
+            for op, comp in zip(ops, comparators):
+                comparisons.append(f" {op} {comp}")
+            return "".join(comparisons)
+        else:
+            # For unsupported node types, fall back to a basic representation
+            return f"<{node.__class__.__name__}>"
 
 
