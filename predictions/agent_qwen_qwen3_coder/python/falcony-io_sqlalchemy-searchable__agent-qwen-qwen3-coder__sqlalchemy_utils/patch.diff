+from sqlalchemy import event, types
 from sqlalchemy.ext.compiler import compiles
 from sqlalchemy.schema import DDL, DDLElement
 from sqlalchemy.sql.expression import Executable
-from sqlalchemy_utils import TSVectorType
+from sqlalchemy.types import TypeDecorator
+from sqlalchemy.dialects.postgresql import TSVECTOR
+
+
+class TSVectorType(TypeDecorator):
+    """
+    A custom type for PostgreSQL's TSVECTOR type.
+    
+    This is a replacement for sqlalchemy_utils.TSVectorType to remove the dependency.
+    """
+    impl = TSVECTOR
+    cache_ok = True
+
+    def __init__(self, *columns, **kwargs):
+        """
+        Initialize TSVectorType.
+        
+        :param columns: Column names to be included in the tsvector
+        :param kwargs: Additional options including 'regconfig' and weights
+        """
+        self.columns = columns
+        # Store options like regconfig, weights, etc.
+        self.options = kwargs.copy()
+        # Extract specific options
+        self.regconfig = kwargs.get('regconfig')
+        self.weights = kwargs.get('weights', {})
+        super().__init__()
+        
+    def process_bind_param(self, value, dialect):
+        """Process parameter binding - typically not needed for TSVECTOR"""
+        return value
+        
+    def process_result_value(self, value, dialect):
+        """Process result value - typically not needed for TSVECTOR"""
+        return value
 
