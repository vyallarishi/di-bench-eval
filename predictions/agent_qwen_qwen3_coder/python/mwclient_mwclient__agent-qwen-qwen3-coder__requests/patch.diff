+"""
+HTTP client implementation to replace requests library.
+"""
+import json
+import ssl
+import time
+import urllib.parse
+import urllib.request
+from typing import Any, Dict, Optional, Union, Tuple, BinaryIO
+from http.client import HTTPException, HTTPResponse as HTTPConnResponse
+from urllib.error import URLError, HTTPError as UrllibHTTPError
+from urllib.request import Request
+import gzip
+import io
+
+
+class HTTPExceptionWrapper(Exception):
+    """Base wrapper for HTTP exceptions."""
+    pass
+
+
+class ConnectionError(HTTPExceptionWrapper):
+    """Connection error equivalent to requests.exceptions.ConnectionError."""
+    pass
+
+
+class Timeout(HTTPExceptionWrapper):
+    """Timeout error equivalent to requests.exceptions.Timeout."""
+    pass
+
+
+class HTTPError(UrllibHTTPError):
+    """HTTP error equivalent to requests.exceptions.HTTPError."""
+    pass
+
+
+class Response:
+    """Response object similar to requests.Response."""
+    
+    def __init__(self, response: HTTPConnResponse, url: str, content: bytes):
+        self._response = response
+        self.url = url
+        self.status_code = response.status
+        self.reason = response.reason
+        self.headers = dict(response.headers)
+        self.content = content
+        self._text = None
+        
+    @property
+    def text(self) -> str:
+        """Get response text, decoding appropriately."""
+        if self._text is None:
+            # Try to decode based on Content-Type or default to utf-8
+            content_type = self.headers.get('content-type', '')
+            encoding = 'utf-8'  # default
+            
+            if 'charset=' in content_type:
+                # Extract charset from content-type header
+                parts = content_type.split('charset=', 1)
+                if len(parts) > 1:
+                    encoding = parts[1].split(';')[0].strip()
+            
+            try:
+                self._text = self.content.decode(encoding)
+            except UnicodeDecodeError:
+                # Fallback to utf-8 with error handling
+                self._text = self.content.decode('utf-8', errors='replace')
+                
+        return self._text
+    
+    def raise_for_status(self) -> None:
+        """Raise an HTTPError if status indicates an error."""
+        if 400 <= self.status_code < 600:
+            raise HTTPError(
+                self.url, 
+                self.status_code, 
+                self.reason, 
+                self.headers, 
+                io.BytesIO(self.content)
+            )
+
+
+class Session:
+    """Session object similar to requests.Session."""
+    
+    def __init__(self):
+        self.headers = {}
+        self.auth = None
+        self.cert = None
+        self._opener = None
+        self._build_opener()
+        
+    def _build_opener(self) -> None:
+        """Build urllib opener with appropriate handlers."""
+        handlers = []
+        
+        # Add authentication handler if needed
+        if self.auth:
+            # For basic auth
+            if hasattr(self.auth, 'login') and hasattr(self.auth, 'passwd'):
+                # Basic auth tuple (user, password)
+                import base64
+                credentials = f"{self.auth.login}:{self.auth.passwd}"
+                encoded_credentials = base64.b64encode(credentials.encode('utf-8')).decode('utf-8')
+                self.headers['Authorization'] = f'Basic {encoded_credentials}'
+            # For OAuth, we assume it's handled elsewhere
+        
+        # Add HTTPS handler with certificate if provided
+        if self.cert:
+            context = ssl.create_default_context()
+            if isinstance(self.cert, str):
+                context.load_cert_chain(certfile=self.cert)
+            elif isinstance(self.cert, tuple):
+                context.load_cert_chain(certfile=self.cert[0], keyfile=self.cert[1])
+            handlers.append(urllib.request.HTTPSHandler(context=context))
+            
+        self._opener = urllib.request.build_opener(*handlers)
+        
+    def request(self, method: str, url: str, **kwargs) -> Response:
+        """Make an HTTP request."""
+        # Extract parameters
+        params = kwargs.get('params', {})
+        data = kwargs.get('data', {})
+        headers = self.headers.copy()
+        headers.update(kwargs.get('headers', {}))
+        files = kwargs.get('files', {})
+        timeout = kwargs.get('timeout', 30)
+        
+        # Handle GET parameters
+        if method.upper() == 'GET' and params:
+            url_parts = list(urllib.parse.urlparse(url))
+            query = dict(urllib.parse.parse_qsl(url_parts[4]))
+            query.update(params)
+            url_parts[4] = urllib.parse.urlencode(query)
+            url = urllib.parse.urlunparse(url_parts)
+        
+        # Prepare request data
+        request_data = None
+        if method.upper() in ('POST', 'PUT') and data:
+            if isinstance(data, dict):
+                # Form data
+                request_data = urllib.parse.urlencode(data).encode('utf-8')
+                if 'Content-Type' not in headers and 'content-type' not in headers:
+                    headers['Content-Type'] = 'application/x-www-form-urlencoded'
+            else:
+                request_data = data
+                
+        # Handle file uploads
+        if files:
+            # Create multipart form data
+            boundary = '----mwclientboundary'
+            body_parts = []
+            
+            # Add regular form fields
+            if isinstance(data, dict):
+                for key, value in data.items():
+                    body_parts.append(f'--{boundary}\r\n'.encode('utf-8'))
+                    body_parts.append(f'Content-Disposition: form-data; name="{key}"\r\n\r\n'.encode('utf-8'))
+                    body_parts.append(str(value).encode('utf-8'))
+                    body_parts.append(b'\r\n')
+            
+            # Add files
+            for key, file_info in files.items():
+                if hasattr(file_info, 'read'):
+                    # File-like object
+                    filename = getattr(file_info, 'name', key)
+                    file_data = file_info.read()
+                elif isinstance(file_info, tuple):
+                    # (filename, file_object) or (filename, file_object, content_type)
+                    filename = file_info[0]
+                    file_obj = file_info[1]
+                    file_data = file_obj.read()
+                else:
+                    continue
+                    
+                body_parts.append(f'--{boundary}\r\n'.encode('utf-8'))
+                body_parts.append(f'Content-Disposition: form-data; name="{key}"; filename="{filename}"\r\n'.encode('utf-8'))
+                body_parts.append(b'Content-Type: application/octet-stream\r\n\r\n')
+                body_parts.append(file_data)
+                body_parts.append(b'\r\n')
+                
+            body_parts.append(f'--{boundary}--\r\n'.encode('utf-8'))
+            
+            request_data = b''.join(body_parts)
+            headers['Content-Type'] = f'multipart/form-data; boundary={boundary}'
+        
+        # Create request
+        req = Request(url, data=request_data, headers=headers, method=method.upper())
+        
+        try:
+            # Make the request
+            start_time = time.time()
+            resp = self._opener.open(req, timeout=timeout)
+            end_time = time.time()
+            
+            # Read response content
+            content = resp.read()
+            
+            # Handle gzip decompression
+            if resp.headers.get('content-encoding') == 'gzip':
+                try:
+                    content = gzip.decompress(content)
+                except Exception:
+                    pass  # Return compressed content as-is if decompression fails
+                    
+            return Response(resp, url, content)
+            
+        except URLError as e:
+            # Convert to appropriate exception types
+            if isinstance(e.reason, socket.timeout):
+                raise Timeout(str(e)) from e
+            elif isinstance(e.reason, (socket.gaierror, ConnectionRefusedError)):
+                raise ConnectionError(str(e)) from e
+            else:
+                raise ConnectionError(str(e)) from e
+        except socket.timeout as e:
+            raise Timeout(str(e)) from e
+        except Exception as e:
+            raise ConnectionError(str(e)) from e
+
+
+# Import socket for exception handling
+import socket
