+    def _flask_websocket_view(self, f):
+        """Create a Flask view function for WebSocket handling."""
+        @wraps(f)
+        def view_func(*args, **kwargs):
+            ws = Server.accept(request.environ, 
+                              **current_app.config.get('SOCK_SERVER_OPTIONS', {}))
+            f(ws, *args, **kwargs)
+        return view_func
+
+    def _standalone_wsgi_app(self, environ, start_response):
+        """Standalone WSGI application for non-Flask usage."""
+        # Simple fallback for standalone mode
+        response = WerkzeugResponse('WebSocket server running', status=200)
+        return response(environ, start_response)
+
+    def __call__(self, environ, start_response):
+        """Make this class callable as a WSGI app."""
+        if self.standalone_mode or (not FLASK_AVAILABLE):
+            return self._standalone_wsgi_app(environ, start_response)
+        else:
+            # Pass through to Flask app
+            return self.app.wsgi_app(environ, start_response)
