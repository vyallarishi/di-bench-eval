+#!/usr/bin/env python3
+"""Standalone CLI for executing Jupyter notebooks."""
+
+import argparse
+import sys
+from pathlib import Path
+from typing import List
+
+from .nb_run import NotebookRun
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Execute Jupyter notebooks")
+    parser.add_argument("notebooks", nargs="+", help="Notebook files to execute")
+    parser.add_argument(
+        "--timeout", type=int, default=300, help="Default cell timeout in seconds"
+    )
+    parser.add_argument(
+        "--verbose", action="store_true", help="Enable verbose output"
+    )
+    parser.add_argument("--kernel", help="Kernel name to use")
+    
+    args = parser.parse_args()
+    
+    results = []
+    exit_code = 0
+    
+    for notebook_path in args.notebooks:
+        path = Path(notebook_path)
+        if not path.exists():
+            print(f"Error: Notebook file '{notebook_path}' not found")
+            exit_code = 1
+            continue
+            
+        runner = NotebookRun(
+            filename=path,
+            default_timeout=args.timeout,
+            verbose=args.verbose,
+            kernel=args.kernel
+        )
+        
+        print(f"Executing {notebook_path}...")
+        result = runner.execute()
+        
+        if result.error:
+            print(f"  FAILED: {result.error}")
+            exit_code = 1
+        else:
+            print(f"  PASSED")
+            
+        results.append((notebook_path, result))
+    
+    return exit_code
+
+
+if __name__ == "__main__":
+    sys.exit(main())
