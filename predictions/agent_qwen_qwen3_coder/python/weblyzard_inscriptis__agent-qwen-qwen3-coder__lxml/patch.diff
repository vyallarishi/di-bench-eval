diff --git a/src/inscriptis/html_element.py b/src/inscriptis/html_element.py
new file mode 100644
index 0000000..271c828
--- /dev/null
+++ b/src/inscriptis/html_element.py
@@ -0,0 +1,152 @@
+"""HTML element implementation to replace lxml."""
+
+
+class HtmlElement:
+    """A simple HTML element implementation to replace lxml elements."""
+
+    def __init__(self, tag=None, attrib=None, text="", tail=""):
+        self.tag = tag
+        self.attrib = attrib or {}
+        self.text = text
+        self.tail = tail
+        self.children = []
+
+    def append(self, child):
+        """Add a child element."""
+        self.children.append(child)
+
+    def iter(self):
+        """Iterate over child elements (mimicking lxml behavior)."""
+        return iter(self.children)
+
+    def __iter__(self):
+        """Make the element iterable."""
+        return iter(self.children)
+
+
+class HtmlComment:
+    """HTML comment class."""
+    pass
+
+
+# Create a singleton for comments
+Comment = HtmlComment()
+
+
+class InscriptisHTMLParser:
+    """Custom HTML parser to build HtmlElement tree."""
+
+    def __init__(self):
+        from html.parser import HTMLParser
+        self._parser = HTMLParser()
+        self._parser.handle_starttag = self._handle_starttag
+        self._parser.handle_endtag = self._handle_endtag
+        self._parser.handle_data = self._handle_data
+        self._parser.handle_charref = self._handle_charref
+        self._parser.handle_entityref = self._handle_entityref
+        
+        # Stack to keep track of parent elements
+        self._stack = []
+        # Root element
+        self._root = None
+        # Current element being processed
+        self._current = None
+        # Text buffer for current element
+        self._text_buffer = ""
+        
+    def feed(self, data):
+        """Feed data to the parser."""
+        self._parser.feed(data)
+        
+    def close(self):
+        """Close the parser."""
+        self._parser.close()
+        
+    def _handle_starttag(self, tag, attrs):
+        """Handle start tag."""
+        # Flush any pending text to the current element
+        self._flush_text()
+        
+        # Create new element
+        elem = HtmlElement(tag, dict(attrs))
+        
+        # Set as root if this is the first element
+        if self._root is None:
+            self._root = elem
+            self._current = elem
+        else:
+            # Add as child of current element
+            if self._current:
+                self._current.append(elem)
+            # Push current to stack and set new element as current
+            self._stack.append(self._current)
+            self._current = elem
+            
+        # Reset text buffer
+        self._text_buffer = ""
+        
+    def _handle_endtag(self, tag):
+        """Handle end tag."""
+        # Flush any pending text
+        self._flush_text()
+        
+        # Pop from stack if needed
+        if self._stack:
+            self._current = self._stack.pop()
+            
+    def _handle_data(self, data):
+        """Handle text data."""
+        self._text_buffer += data
+        
+    def _handle_charref(self, name):
+        """Handle character reference."""
+        try:
+            if name.startswith('x'):
+                char = chr(int(name[1:], 16))
+            else:
+                char = chr(int(name))
+            self._text_buffer += char
+        except ValueError:
+            self._text_buffer += f"&#{name};"
+            
+    def _handle_entityref(self, name):
+        """Handle entity reference."""
+        entities = {
+            'amp': '&',
+            'lt': '<',
+            'gt': '>',
+            'quot': '"',
+            'apos': "'",
+            'nbsp': ' ',
+        }
+        self._text_buffer += entities.get(name, f"&{name};")
+        
+    def _flush_text(self):
+        """Flush text buffer to appropriate place."""
+        if not self._text_buffer:
+            return
+            
+        if self._current is None:
+            # Text before any tag
+            return
+            
+        if self._current.text == "":
+            self._current.text = self._text_buffer
+        else:
+            # This should be tail text of previous sibling
+            # But for simplicity, we'll append to current text
+            self._current.text += self._text_buffer
+            
+        self._text_buffer = ""
+        
+    def get_root(self):
+        """Get the root element."""
+        return self._root
+
+
+def fromstring(html_content):
+    """Parse HTML content and return root element (mimicking lxml.html.fromstring)."""
+    parser = InscriptisHTMLParser()
+    parser.feed(html_content)
+    parser.close()
+    return parser.get_root()
