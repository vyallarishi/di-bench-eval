+++ b/flake8_pytest_style/plugin_utils.py
@@ -0,0 +1,85 @@
+"""Reimplementation of flake8_plugin_utils functionality."""
+
+import ast
+from typing import Any, Dict, Generic, List, Optional, Set, Tuple, Type, TypeVar, Union
+
+# Type variables
+T = TypeVar('T')
+ConfigType = TypeVar('ConfigType')
+
+
+class Error:
+    """Base class for plugin errors."""
+
+    code: str
+    message: str
+    defaults: Optional[Tuple[Any, ...]] = None
+
+    def __init__(self, *args: Any) -> None:
+        self.args = args
+
+    def format_message(self) -> str:
+        """Format the error message with arguments."""
+        if self.defaults is not None:
+            # Combine defaults with provided args
+            combined_args = list(self.defaults)
+            combined_args.extend(self.args)
+            return self.message.format(*combined_args)
+        return self.message.format(*self.args)
+
+
+class Visitor(Generic[ConfigType]):
+    """Base visitor class."""
+
+    def __init__(self, config: Optional[ConfigType] = None) -> None:
+        self.config = config or self.get_default_config()
+        self.errors: List[Tuple[int, int, str, Type[Any]]] = []
+
+    def get_default_config(self) -> ConfigType:
+        """Get default configuration."""
+        # This should be overridden by subclasses if needed
+        raise NotImplementedError("Subclasses should implement get_default_config()")
+
+    def error_from_node(
+        self, error_class: Type[Error], node: ast.AST, *args: Any, **kwargs: Any
+    ) -> None:
+        """Record an error from an AST node."""
+        error_instance = error_class(*args, **kwargs)
+        message = f"{error_class.code} {error_instance.format_message()}"
+        self.errors.append((node.lineno, node.col_offset, message, type(self)))
+
+
+def is_none(node: ast.AST) -> bool:
+    """Check if an AST node represents None."""
+    return isinstance(node, ast.Constant) and node.value is None
+
+
+def is_false(node: ast.AST) -> bool:
+    """Check if an AST node represents False."""
+    return isinstance(node, ast.Constant) and node.value is False
+
+
+def check_equivalent_nodes(node1: ast.AST, node2: ast.AST) -> bool:
+    """Check if two AST nodes are equivalent."""
+    # Simple comparison based on AST dump
+    return ast.dump(node1) == ast.dump(node2)
+
+
+class Plugin(Generic[ConfigType]):
+    """Base plugin class."""
+    
+    name: str
+    version: str
+    visitors: List[Type[Visitor[ConfigType]]] = []
+    
+    @classmethod
+    def add_options(cls, option_manager: Any) -> None:
+        """Add plugin options."""
+        pass
+    
+    @classmethod
+    def parse_options_to_config(
+        cls, option_manager: Any, options: Any, args: List[str]
+    ) -> ConfigType:
+        """Parse options to config."""
+        raise NotImplementedError("Subclasses should implement parse_options_to_config()")
