+        if hasattr(self, 'initialize_traits'):
+            self.initialize_traits(**kwargs)
+    
+    def trait_names(self):
+        """Return names of all traits"""
+        cls = self.__class__
+        names = []
+        for attr_name in dir(cls):
+            attr = getattr(cls, attr_name)
+            if isinstance(attr, TraitType):
+                names.append(attr_name)
+        return names
+    
+    def trait_metadata(self, name, key, default=None):
+        """Get metadata for a trait"""
+        cls = self.__class__
+        if hasattr(cls, name):
+            trait = getattr(cls, name)
+            if isinstance(trait, TraitType):
+                return trait.metadata.get(key, default)
+        return default
