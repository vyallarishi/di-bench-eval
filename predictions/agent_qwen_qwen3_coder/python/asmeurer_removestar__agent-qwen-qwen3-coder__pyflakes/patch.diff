+class StarImportVisitor(ast.NodeVisitor):
+    """AST visitor to find star imports and name usages."""
+    
+    def __init__(self):
+        self.star_imports = []  # (lineno, modname)
+        self.name_usages = []   # (lineno, name)
+        self.imported_names = set()
+        
+    def visit_ImportFrom(self, node):
+        """Handle 'from module import *' statements."""
+        if node.names and node.names[0].name == '*':
+            self.star_imports.append((node.lineno, node.module))
+        else:
+            # Track explicitly imported names
+            for alias in node.names:
+                self.imported_names.add(alias.asname or alias.name)
+        self.generic_visit(node)
+    
+    def visit_Import(self, node):
+        """Handle regular import statements."""
+        for alias in node.names:
+            self.imported_names.add(alias.asname or alias.name)
+        self.generic_visit(node)
+    
+    def visit_Name(self, node):
+        """Handle name references."""
+        if isinstance(node.ctx, ast.Load):
+            # This is a name usage (not a definition)
+            # Skip if it's a built-in or explicitly imported name
+            if node.id not in MAGIC_GLOBALS:
+                self.name_usages.append((node.lineno, node.id))
+        self.generic_visit(node)
+    
+    def visit_FunctionDef(self, node):
+        """Handle function definitions to track local variables."""
+        # Add function name to imported names to avoid treating it as usage
+        self.imported_names.add(node.name)
+        self.generic_visit(node)
+    
+    def visit_ClassDef(self, node):
+        """Handle class definitions to track local variables."""
+        # Add class name to imported names to avoid treating it as usage
+        self.imported_names.add(node.name)
+        self.generic_visit(node)
+    
+    def visit_Assign(self, node):
+        """Handle assignments to track local variables."""
+        # For simple assignments like 'x = 1', add target names
+        for target in node.targets:
+            if isinstance(target, ast.Name):
+                self.imported_names.add(target.id)
+        self.generic_visit(node)
 
 
