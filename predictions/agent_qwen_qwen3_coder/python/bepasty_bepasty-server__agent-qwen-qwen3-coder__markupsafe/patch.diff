+++ b/test_markup_replacement.py
@@ -0,0 +1,34 @@
+import html
+
+# Test cases similar to how Markup is used in the codebase
+# Image tag example
+src = "/download/image.png"
+rendered_content = html.escape(f'<img src="{src}" alt="the image" width="800">')
+print(f"Image tag: {rendered_content}")
+
+# Audio tag example
+src = "/download/audio.mp3"
+alt_msg = 'html5 audio element not supported by your browser.'
+rendered_content = html.escape(f'<audio controls src="{src}">{alt_msg}</audio>')
+print(f"Audio tag: {rendered_content}")
+
+# PDF link example
+src = "/inline/document.pdf"
+link_txt = 'Click to see PDF'
+rendered_content = html.escape(f'<a href="{src}">{link_txt}</a>')
+print(f"PDF link: {rendered_content}")
+
+# Multi-line HTML content (like in error handlers)
+error_body = """\
+<p>
+    You are not allowed to access the requested URL.
+</p>
+<p>
+    If you entered the URL manually please check your spelling and try again.
+</p>
+<p>
+    Also check if you maybe forgot to log in or if your permissions are insufficient for this.
+</p>
+"""
+escaped_error_body = html.escape(error_body)
+print(f"Error body: {escaped_error_body}")
