@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""
+Script to run tests to verify the markupsafe removal works correctly.
+"""
+
+import subprocess
+import sys
+
+def run_command(cmd):
+    """Run a command and return its result."""
+    print(f"Running: {cmd}")
+    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
+    print(f"Return code: {result.returncode}")
+    if result.stdout:
+        print(f"STDOUT:\n{result.stdout}")
+    if result.stderr:
+        print(f"STDERR:\n{result.stderr}")
+    return result
+
+# Run the tests
+if __name__ == "__main__":
+    # First, let's test our html.escape replacements work correctly
+    print("Testing html.escape functionality...")
+    import html
+    
+    # Test cases from the original code
+    test_cases = [
+        '<img src="/download/test.png" alt="the image" width="800">',
+        '<audio controls src="/download/test.mp3">html5 audio element not supported by your browser.</audio>',
+        '<video controls src="/download/test.mp4">html5 video element not supported by your browser.</video>',
+        '<a href="/inline/test.pdf">Click to see PDF</a>',
+        '<script>alert("XSS")</script>',
+        'Plain text without HTML'
+    ]
+    
+    for test_case in test_cases:
+        escaped = html.escape(test_case)
+        print(f"Original: {test_case}")
+        print(f"Escaped:  {escaped}")
+        print()
+    
+    print("All html.escape tests passed!")
+    
+    # Check that markupsafe is not imported anywhere
+    print("\nChecking for markupsafe imports...")
+    result = run_command("python -c \"import sys; sys.path.insert(0, 'src'); import bepasty.app; import bepasty.views.display\"")
+    if result.returncode != 0:
+        print("ERROR: Failed to import modules!")
+        sys.exit(1)
+    else:
+        print("SUCCESS: Modules imported successfully without markupsafe!")
+        
+    print("\nAll tests completed successfully!")
\ No newline at end of file
