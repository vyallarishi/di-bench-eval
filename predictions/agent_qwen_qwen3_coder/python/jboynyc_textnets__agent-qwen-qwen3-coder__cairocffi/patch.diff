@@ -0,0 +1,32 @@
+#!/usr/bin/env python3
+"""
+Test if textnets plotting works without Cairo dependencies.
+"""
+
+try:
+    import textnets as tn
+    print("textnets imported successfully")
+    
+    # Create a minimal corpus
+    corpus = tn.Corpus(["This is a test document", "This is another test"], vector_backend="count")
+    print("Corpus created successfully")
+    
+    # Create a textnet
+    t = tn.Textnet(corpus)
+    print("Textnet created successfully")
+    
+    # Try to plot
+    try:
+        with open('/tmp/test_plot.png', 'wb') as f:
+            result = t.plot()
+            print("Plotting completed successfully!")
+            
+    except Exception as e:
+        print(f"Plotting failed: {e}")
+        import traceback
+        traceback.print_exc()
+        
+except ImportError as e:
+    print(f"Import failed: {e}")
+    import traceback
+    traceback.print_exc()
