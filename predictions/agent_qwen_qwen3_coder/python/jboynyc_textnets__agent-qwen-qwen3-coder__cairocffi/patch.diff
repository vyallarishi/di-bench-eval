@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""
+Quick test to see if igraph works without Cairo dependencies.
+"""
+
+import igraph as ig
+import tempfile
+import os
+
+# Create a simple graph
+g = ig.Graph.Erdos_Renyi(10, 0.3)
+
+# Try to plot it
+try:
+    with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as f:
+        temp_filename = f.name
+    
+    # This should work if igraph can render without Cairo
+    plot = ig.plot(g, target=temp_filename)
+    print("Plotting successful!")
+    
+    # Clean up
+    if os.path.exists(temp_filename):
+        os.unlink(temp_filename)
+        
+except Exception as e:
+    print(f"Plotting failed: {e}")
+    import traceback
+    traceback.print_exc()
