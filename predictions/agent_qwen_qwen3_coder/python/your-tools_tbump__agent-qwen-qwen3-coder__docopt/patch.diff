+import argparse
+import sys
+from pathlib import Path
+from typing import List, Optional, cast
+
+from tbump.cli import (
+    BumpOptions,
+    Command,
+    GivenCliArguments,
+)
+
+
+def _parse_arguments(args: List[str]) -> GivenCliArguments:
+    parser = argparse.ArgumentParser(prog="tbump")
+    parser.add_argument("--version", action="store_true")
+    parser.add_argument("--help", "-h", action="store_true")
+    
+    # Commands
+    subparsers = parser.add_subparsers(dest="command")
+    
+    # bump command (default)
+    bump_parser = subparsers.add_parser("bump")
+    bump_parser.add_argument("new_version", help="The new version to bump to")
+    bump_parser.add_argument("--cwd", "-C", type=Path, help="Set working directory to <path>")
+    bump_parser.add_argument("--config", "-c", type=Path, help="Use specified toml config file")
+    bump_parser.add_argument("--non-interactive", action="store_true", help="Never prompt for confirmation")
+    bump_parser.add_argument("--dry-run", action="store_true", help="Only display the changes that would be made")
+    bump_parser.add_argument("--tag-message", help="Message to use for tag instead of being based on the tag template")
+    bump_parser.add_argument("--only-patch", action="store_true", help="Only patches files, skipping any git operations or hook commands")
+    bump_parser.add_argument("--no-tag", action="store_true", help="Do not create a tag")
+    bump_parser.add_argument("--no-push", action="store_true", help="Do not push after creating the commit and/or tag")
+    bump_parser.add_argument("--no-tag-push", action="store_true", help="Create a tag, but don't push it")
+    
+    # current-version command
+    current_version_parser = subparsers.add_parser("current-version")
+    current_version_parser.add_argument("--cwd", "-C", type=Path, help="Set working directory to <path>")
+    current_version_parser.add_argument("--config", "-c", type=Path, help="Use specified toml config file")
+    
+    # init command
+    init_parser = subparsers.add_parser("init")
+    init_parser.add_argument("current_version", help="The current version to initialize with")
+    init_parser.add_argument("--pyproject", action="store_true", help="Use pyproject.toml instead of tbump.toml")
+    init_parser.add_argument("--cwd", "-C", type=Path, help="Set working directory to <path>")
+    init_parser.add_argument("--config", "-c", type=Path, help="Use specified toml config file")
+    
+    # Special handling for the original tbump syntax where the first argument could be the command or version
+    if args and not args[0].startswith("-"):
+        if args[0] in ("init", "current-version"):
+            # Handle special cases where first arg is actually a command
+            pass
+        elif len(args) >= 2 and args[1] == "init":
+            # Handle 'tbump <version> init' pattern
+            args = ["init"] + args[:1] + args[2:]
+        elif args[0] not in ("bump", "current-version", "init"):
+            # Default to bump command with version
+            args = ["bump"] + args
+    
+    parsed_args = parser.parse_args(args)
+    
+    # Convert to Command enum
+    if parsed_args.version:
+        command = Command.version
+    elif parsed_args.help:
+        command = Command.version  # Help is handled by argparse itself
+    elif parsed_args.command == "init" or (hasattr(parsed_args, 'current_version') and parsed_args.current_version):
+        command = Command.init
+    elif parsed_args.command == "current-version":
+        command = Command.current_version
+    else:
+        command = Command.bump
+    
+    return GivenCliArguments(
+        command=command,
+        bump_new_version=getattr(parsed_args, 'new_version', None),
+        init_current_version=getattr(parsed_args, 'current_version', None),
+        init_pyproject=getattr(parsed_args, 'pyproject', False),
+        working_path=getattr(parsed_args, 'cwd', None),
+        config_path=getattr(parsed_args, 'config', None),
+        non_interactive=getattr(parsed_args, 'non_interactive', False),
+        dry_run=getattr(parsed_args, 'dry_run', False),
+        only_patch=getattr(parsed_args, 'only_patch', False),
+        tag_message=getattr(parsed_args, 'tag_message', None),
+        no_tag=getattr(parsed_args, 'no_tag', False),
+        no_push=getattr(parsed_args, 'no_push', False),
+        no_tag_push=getattr(parsed_args, 'no_tag_push', False),
+    )
\ No newline at end of file
