+#!/usr/bin/env python3
+
+import sys
+import subprocess
+
+def run_tests():
+    # Install test dependencies
+    subprocess.check_call([sys.executable, "-m", "pip", "install", "pytest", "numpy"])
+    
+    # Run the tests
+    result = subprocess.run([sys.executable, "-m", "pytest", "test/", "-v"])
+    return result.returncode
+
+if __name__ == "__main__":
+    sys.exit(run_tests())
