+++ b/temp_flake8_isort.py
@@ -0,0 +1,176 @@
+from contextlib import redirect_stdout
+from difflib import unified_diff
+from importlib.metadata import PackageNotFoundError
+from importlib.metadata import version
+from io import StringIO
+from pathlib import Path
+import traceback
+import warnings
+
+try:
+    import isort
+    ISORT_AVAILABLE = True
+except ImportError:
+    isort = None
+    ISORT_AVAILABLE = False
+
+try:
+    from isort import SortImports
+except ImportError:
+    SortImports = None
+
+try:
+    from isort.api import check_code_string as check_code
+    from isort.api import sort_code_string as sort_code
+except ImportError:
+    check_code = None
+    sort_code = None
+
+try:
+    from isort.exceptions import FileSkipComment, FileSkipSetting
+except ImportError:
+    FileSkipComment = None
+    FileSkipSetting = None
+
+try:
+    from isort.settings import Config
+except ImportError:
+    Config = None
+
+
+def _version():
+    try:
+        return version('flake8_isort')
+    except PackageNotFoundError:
+        return 'dev'  # for local development if package is not installed yet
+
+
+class Flake8IsortBase:
+    name = 'flake8_isort'
+    version = _version()
+    isort_unsorted = 'I001 isort found an import in the wrong position'
+    no_config_msg = 'I002 no configuration found (.isort.cfg or [isort] in configs)'
+    isort_blank_req = 'I003 isort expected 1 blank line in imports, found 0'
+    isort_blank_unexp = 'I004 isort found an unexpected blank line in imports'
+    isort_add_unexp = 'I005 isort found an unexpected missing import'
+
+    show_traceback = False
+    no_skip_gitignore = False
+    stdin_display_name = None
+    search_current = True
+
+    def __init__(self, tree, filename, lines):
+        self.filename = filename
+        self.lines = lines
+
+    @staticmethod
+    def add_options(option_manager):
+        option_manager.add_option(
+            '--isort-show-traceback',
+            action='store_true',
+            parse_from_config=True,
+            help='Show full traceback with diff from isort',
+        )
+        option_manager.add_option(
+            '--isort-no-skip-gitignore',
+            action='store_true',
+            parse_from_config=True,
+            help=(
+                "Temporarily override the set value of isort's `skip_gitignore` option "
+                'with `False`. This can cause flake8-isort to run significantly faster '
+                "at the cost of making flake8-isort's behavior differ slightly from "
+                'the behavior of `isort --check`.'
+            ),
+        )
+
+    @classmethod
+    def parse_options(cls, option_manager, options, args):
+        cls.stdin_display_name = options.stdin_display_name
+        cls.show_traceback = options.isort_show_traceback
+        cls.no_skip_gitignore = options.isort_no_skip_gitignore
+
+
+class Flake8Isort5(Flake8IsortBase):
+    """class for isort >=5"""
+
+    def run(self):
+        # If isort is not available, silently skip checking
+        if not ISORT_AVAILABLE or SortImports is None or check_code is None:
+            return
+            yield  # This makes it a generator function
+
+        try:
+            if self.filename == self.stdin_display_name:
+                file_path = None
+            else:
+                file_path = Path(self.filename)
+
+            if self.no_skip_gitignore and Config is not None:
+                settings = Config(path=file_path, skip_gitignore=False)
+            else:
+                settings = Config(path=file_path) if Config is not None else {}
+
+            with redirect_stdout(StringIO()) as stdout:
+                isort_changed = check_code(
+                    ''.join(self.lines),
+                    file_path=self.filename,
+                    **({'config': settings} if Config is not None else {})
+                )
+
+            if isort_changed:
+                if self.no_skip_gitignore and Config is not None:
+                    settings = Config(path=file_path, skip_gitignore=False)
+                else:
+                    settings = Config(path=file_path) if Config is not None else {}
+                
+                with redirect_stdout(StringIO()):
+                    input_stream = StringIO(''.join(self.lines))
+                    output_stream = StringIO()
+                    sort_code(
+                        input_stream.read(),
+                        output=output_stream,
+                        file_path=self.filename,
+                        **({'config': settings} if Config is not None else {})
+                    )
+                    output_stream.seek(0)
+                    isort_diff = ''.join(unified_diff(
+                        self.lines, output_stream.readlines(), self.filename, self.filename
+                    ))
+
+                for line_num, message in self.isort_linenum_msg(isort_diff):
+                    yield line_num, 0, message, type(self)
+
+        except (
+            (FileSkipComment if FileSkipComment is not None else Exception),
+            (FileSkipSetting if FileSkipSetting is not None else Exception)
+        ):
+            pass
+
+        except Exception as e:
+            if self.show_traceback:
+                warnings.warn(traceback.format_exc())
+            else:
+                warnings.warn(str(e))
+
+    def isort_linenum_msg(self, udiff):
+        if not ISORT_AVAILABLE:
+            return
+            yield  # This makes it a generator function
+            
+        for line in udiff.splitlines():
+            if line.startswith('@@'):
+                line_num = int(line.split()[1].split(',')[0][1:])
+                if line_num <= 0:
+                    line_num = 1
+                yield line_num, self.isort_unsorted
+            elif line.startswith('+') or line.startswith('-'):
+                if line[1:].strip() == '':
+                    # Look for context lines before and after to determine error type
+                    continue
+                elif line.startswith('-'):
+                    yield None, self.isort_blank_unexp
+                elif line.startswith('+'):
+                    yield None, self.isort_add_unexp
+
+
+Flake8Isort = Flake8Isort5
