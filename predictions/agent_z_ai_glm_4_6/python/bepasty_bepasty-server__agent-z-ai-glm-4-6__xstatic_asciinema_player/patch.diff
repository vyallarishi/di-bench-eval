diff --git a/src/bepasty/static/app/js/asciinema-player.js b/src/bepasty/static/app/js/asciinema-player.js
new file mode 100644
index 0000000..c722f53
--- /dev/null
+++ b/src/bepasty/static/app/js/asciinema-player.js
@@ -0,0 +1,95 @@
+/**
+ * Minimal asciinema player replacement
+ * Provides basic functionality to display .cast files
+ */
+(function() {
+    'use strict';
+
+    function AsciinemaPlayer(element, options) {
+        this.element = element;
+        this.options = options || {};
+        this.src = options.src;
+        this.title = options.title || '';
+        this.theme = options.theme || 'asciinema';
+        this.autoplay = options.autoplay || false;
+        
+        this.init();
+    }
+
+    AsciinemaPlayer.prototype.init = function() {
+        if (!this.src) {
+            this.element.innerHTML = '<div class="asciinema-error">No source file specified</div>';
+            return;
+        }
+
+        // Create a simple container that shows download link and basic info
+        var container = document.createElement('div');
+        container.className = 'asciinema-player-container';
+        container.style.cssText = [
+            'border: 1px solid #ccc;',
+            'border-radius: 4px;',
+            'padding: 20px;',
+            'background: #f9f9f9;',
+            'font-family: monospace;',
+            'text-align: center;'
+        ].join(' ');
+
+        var title = this.title || 'asciinema recording';
+        var downloadLink = document.createElement('a');
+        downloadLink.href = this.src;
+        downloadLink.textContent = 'Download ' + title;
+        downloadLink.style.cssText = [
+            'display: inline-block;',
+            'padding: 10px 20px;',
+            'background: #007cba;',
+            'color: white;',
+            'text-decoration: none;',
+            'border-radius: 3px;',
+            'margin: 10px 0;'
+        ].join(' ');
+
+        var info = document.createElement('div');
+        info.innerHTML = [
+            '<p><strong>' + title + '</strong></p>',
+            '<p>This is an asciinema recording (.cast file).</p>',
+            '<p>Download the file to view it with the asciinema player.</p>'
+        ].join('');
+        info.style.cssText = 'margin-bottom: 15px;';
+
+        container.appendChild(info);
+        container.appendChild(downloadLink);
+        
+        this.element.innerHTML = '';
+        this.element.appendChild(container);
+    };
+
+    // Auto-initialize from <asciinema-player> tags
+    function init() {
+        var players = document.getElementsByTagName('asciinema-player');
+        for (var i = 0; i < players.length; i++) {
+            var element = players[i];
+            var src = element.getAttribute('src');
+            var title = element.getAttribute('title') || '';
+            var theme = element.getAttribute('theme') || 'asciinema';
+            var autoplay = element.hasAttribute('autoplay');
+            
+            new AsciinemaPlayer(element, {
+                src: src,
+                title: title,
+                theme: theme,
+                autoplay: autoplay
+            });
+        }
+    }
+
+    // Initialize when DOM is ready
+    if (document.readyState === 'loading') {
+        document.addEventListener('DOMContentLoaded', init);
+    } else {
+        init();
+    }
+
+    // Export for potential manual use
+    window.AsciinemaPlayer = AsciinemaPlayer;
+
+})();
