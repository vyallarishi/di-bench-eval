+/**
+ * Minimal asciinema player CSS replacement
+ * Basic styling for our custom asciinema player
+ */
+
+.asciinema-player-container {
+    border: 1px solid #ccc;
+    border-radius: 4px;
+    padding: 20px;
+    background: #f9f9f9;
+    font-family: monospace;
+    text-align: center;
+    margin: 10px 0;
+}
+
+.asciinema-player-container a {
+    display: inline-block;
+    padding: 10px 20px;
+    background: #007cba;
+    color: white;
+    text-decoration: none;
+    border-radius: 3px;
+    margin: 10px 0;
+    transition: background-color 0.2s;
+}
+
+.asciinema-player-container a:hover {
+    background: #005a87;
+}
+
+.asciinema-player-container p {
+    margin: 10px 0;
+    color: #333;
+}
+
+.asciinema-error {
+    color: #d32f2f;
+    padding: 10px;
+    border: 1px solid #d32f2f;
+    border-radius: 3px;
+    background: #ffebee;
+}
