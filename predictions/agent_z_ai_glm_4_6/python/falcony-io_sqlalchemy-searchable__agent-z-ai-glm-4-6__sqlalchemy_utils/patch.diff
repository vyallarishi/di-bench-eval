+class TSVectorType(TypeDecorator):
+    """A TSVector type that mimics sqlalchemy_utils.TSVectorType.
+    
+    This is a simplified replacement for sqlalchemy_utils.TSVectorType
+    that provides the same interface for this package.
+    """
+    impl = TSVECTOR
+    
+    def __init__(self, *columns, **options):
+        """Initialize TSVectorType.
+        
+        Args:
+            *columns: Column names to include in the search vector
+            **options: Additional options for the vector
+        """
+        self.columns = columns
+        self.options = options
+        super().__init__()
+    
+    def process_bind_param(self, value, dialect):
+        # Just pass through the value as-is for TSVECTOR
+        return value
+    
