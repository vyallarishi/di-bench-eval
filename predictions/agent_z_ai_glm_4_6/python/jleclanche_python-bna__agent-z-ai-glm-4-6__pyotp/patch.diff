+import base64
+import hashlib
+import hmac
+import struct
+import time
+import urllib.parse
+class TOTP:
+	"""
+	Time-based One-Time Password implementation
+	"""
+	
+	def __init__(self, secret: str, digits: int = 6):
+		"""
+		Initialize TOTP with a secret and number of digits
+		"""
+		self.secret = secret
+		self.digits = digits
+	
+	def _hotp(self, counter: int) -> str:
+		"""
+		Generate HMAC-based One-Time Password
+		"""
+		# Decode base32 secret
+		try:
+			key = base64.b32decode(self.secret, casefold=True)
+		except Exception:
+			# If decoding fails, assume it's already in bytes
+			key = self.secret.encode()
+		
+		# Convert counter to bytes (big-endian)
+		counter_bytes = struct.pack('>Q', counter)
+		
+		# Calculate HMAC-SHA1
+		hmac_hash = hmac.new(key, counter_bytes, hashlib.sha1).digest()
+		
+		# Dynamic truncation
+		offset = hmac_hash[-1] & 0x0F
+		code = struct.unpack('>I', hmac_hash[offset:offset+4])[0]
+		code &= 0x7FFFFFFF
+		
+		# Get last digits digits
+		return str(code % (10 ** self.digits)).zfill(self.digits)
+	
+	def at(self, timestamp: int) -> str:
+		"""
+		Get TOTP code at specific timestamp
+		"""
+		# TOTP uses 30-second time steps
+		counter = timestamp // 30
+		return self._hotp(counter)
+	
+	def now(self) -> str:
+		"""
+		Get current TOTP code
+		"""
+		return self.at(int(time.time()))
+	
+	def provisioning_uri(self, name: str, issuer_name: str = None) -> str:
+		"""
+		Generate otpauth:// URI
+		"""
+		params = {
+			'secret': self.secret,
+			'digits': str(self.digits),
+		}
+		if issuer_name:
+			params['issuer'] = issuer_name
+		
+		query = urllib.parse.urlencode(params)
+		if issuer_name:
+			label = f"{issuer_name}:{urllib.parse.quote(name)}"
+		else:
+			label = urllib.parse.quote(name)
+		return f"otpauth://totp/{label}?{query}"
 
 
