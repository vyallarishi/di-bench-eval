+def is_dataframe(data) -> bool:
+    """Check if data is a pandas DataFrame.
+    
+    :param data: object to check
+    :return: True if DataFrame-like, False otherwise
+    """
+    return hasattr(data, 'columns') and hasattr(data, 'values')
+def hist2d_from_df(df: Any, x: str, y: str, dropna: bool = True, 
+                   clean: bool = True, verbose: bool = False) -> Tuple[np.ndarray, np.ndarray, list]:
+    """Create 2D histogram from DataFrame columns
+    
+    :param df: DataFrame-like object
+    :param x: column name for x-axis
+    :param y: column name for y-axis  
+    :param dropna: whether to drop NaN values
+    :param clean: whether to clean data
+    :param verbose: print debugging info
+    :return: tuple of (histogram, x_edges, y_edges)
+    """
+    # Extract data using duck typing
+    x_data = df[x] if hasattr(df, '__getitem__') else getattr(df, x)
+    y_data = df[y] if hasattr(df, '__getitem__') else getattr(df, y)
+    
+    # Convert to numpy arrays
+    x_arr = array_like_to_numpy(x_data)
+    y_arr = array_like_to_numpy(y_data)
+    
+    # Remove NaN values if requested
+    if dropna:
+        mask = ~(np.isnan(x_arr) | np.isnan(y_arr))
+        x_arr = x_arr[mask]
+        y_arr = y_arr[mask]
+    
+    # Create 2D histogram
+    hist, xedges, yedges = np.histogram2d(x_arr, y_arr, bins=10)
+    
+    return hist, xedges, yedges
+
+
+def correlation_matrix_to_dict(corr_matrix: Any) -> Dict[str, Dict[str, float]]:
+    """Convert correlation matrix to dictionary format
+    
+    :param corr_matrix: correlation matrix (DataFrame-like or numpy array)
+    :return: dictionary representation
+    """
+    # Handle both DataFrame-like and numpy array inputs
+    if hasattr(corr_matrix, 'index'):  # DataFrame-like
+        return {col: {row: corr_matrix.iloc[i, j] 
+                     for j, row in enumerate(corr_matrix.index)}
+                for i, col in enumerate(corr_matrix.columns)}
+    else:  # numpy array
+        return {f'col_{i}': {f'row_{j}': corr_matrix[i, j] 
+                            for j in range(corr_matrix.shape[1])}
+                for i in range(corr_matrix.shape[0])}
