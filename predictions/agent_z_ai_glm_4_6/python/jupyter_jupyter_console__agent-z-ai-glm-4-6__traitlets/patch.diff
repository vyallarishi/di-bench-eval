new file mode 100644
index 0000000..ab16e88
--- /dev/null
+++ b/jupyter_console/_traitlets.py
@@ -0,0 +1,25 @@
+"""Compatibility shim for traitlets.
+
+This module re-exports the traitlets symbols used throughout jupyter_console.
+traitlets is available as a transitive dependency via jupyter_core and
+jupyter_client, so we do not declare it as a direct dependency.
+"""
+
+from traitlets import (  # noqa: F401
+    Any,
+    Bool,
+    CBool,
+    Dict,
+    DottedObjectName,
+    Enum,
+    Float,
+    Instance,
+    Integer,
+    List,
+    Unicode,
+    observe,
+)
+from traitlets.config import boolean_flag, catch_config_error  # noqa: F401
+from traitlets.config.application import Application  # noqa: F401
+from traitlets.config.configurable import Configurable  # noqa: F401
+from traitlets.config.singleton import SingletonConfigurable  # noqa: F401
