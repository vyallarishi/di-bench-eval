+# Magic globals that should be excluded from name analysis
+MAGIC_GLOBALS = {"__name__", "__doc__", "__package__", "__loader__", "__spec__", "__file__", "__cached__", "__builtins__", "__annotations__", "quit", "exit"}
+
+class ImportStarUsage:
+    def __init__(self, filename, lineno, name, modules):
+        self.filename = filename
+        self.lineno = lineno
+        self.message_args = (name, *modules)
+
+
+class ImportStarUsed:
+    def __init__(self, filename, lineno, module):
+        self.filename = filename
+        self.lineno = lineno
+        self.message_args = (module,)
+
+
+class ModuleScope:
+    def __init__(self, node):
+        self.node = node
+        self._imports = {}
+        self._names = set()
+    
+    def __getitem__(self, name):
+        if name in self._imports:
+            return self._imports[name]
+        elif name in self._names:
+            return type('obj', (object,), {'names': [name]})()
+        else:
+            raise KeyError(name)
+    
+    def keys(self):
+        return set(self._imports) | set(self._names)
+    
+    def add_import(self, name, node):
+        self._imports[name] = node
+    
+    def add_name(self, name):
+        self._names.add(name)
+
+
+class Checker:
+    def __init__(self, tree):
+        self.tree = tree
+        self.messages = []
+        self.deadScopes = []
+        self._scopes = []
+        self._current_scope = None
+        self._star_imports = {}
+        self._used_names = {}
+        self.visit(tree)
+    
+    def visit(self, node):
+        method = getattr(self, f'visit_{type(node).__name__}', self.generic_visit)
+        return method(node)
+    
+    def generic_visit(self, node):
+        for child in ast.iter_child_nodes(node):
+            self.visit(child)
+    
+    def visit_Module(self, node):
+        scope = ModuleScope(node)
+        self._scopes.append(scope)
+        self._current_scope = scope
+        self.deadScopes.append(scope)
+        self.generic_visit(node)
+        self._current_scope = self._scopes.pop() if self._scopes else None
+    
+    def visit_ImportFrom(self, node):
+        if node.names[0].name == '*':
+            module_name = node.module or ''
+            if node.level > 0:
+                module_name = '.' * node.level + module_name
+            self.messages.append(ImportStarUsed('file', node.lineno, module_name))
+            self._star_imports[module_name] = node
+        else:
+            for alias in node.names:
+                name = alias.asname if alias.asname else alias.name
+                if self._current_scope:
+                    self._current_scope.add_import(name, alias)
+        self.generic_visit(node)
+    
+    def visit_Name(self, node):
+        if isinstance(node.ctx, ast.Load):
+            name = node.id
+            if name not in dir(builtins) and name not in MAGIC_GLOBALS:
+                if name not in self._used_names:
+                    self._used_names[name] = []
+                self._used_names[name].append(node)
+                
+                # Check if this name comes from a star import
+                for module_name in self._star_imports:
+                    self.messages.append(ImportStarUsage('file', node.lineno, name, [module_name]))
+        self.generic_visit(node)
 
 
