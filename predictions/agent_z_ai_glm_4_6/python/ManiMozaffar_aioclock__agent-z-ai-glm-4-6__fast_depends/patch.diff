+"""
+Simple dependency injection system to replace fast_depends.
+"""
+
+from typing import Any, Callable, TypeVar, cast
+from functools import wraps
+import inspect
+
+T = TypeVar("T")
+
+
+class Depends:
+    """Dependency injection marker."""
+    
+    def __init__(self, dependency: Callable[..., Any]) -> None:
+        self.dependency = dependency
+
+
+class SimpleProvider:
+    """Simple dependency provider."""
+    
+    def __init__(self) -> None:
+        self._dependencies: dict[str, Callable[..., Any]] = {}
+    
+    def provide(self, param_name: str, dependency: Callable[..., Any]) -> None:
+        """Register a dependency for a parameter name."""
+        self._dependencies[param_name] = dependency
+    
+    def resolve(self, param_name: str) -> Callable[..., Any] | None:
+        """Get a dependency for a parameter name."""
+        return self._dependencies.get(param_name)
+
+
+# Global provider instance
+_provider = SimpleProvider()
+
+
+def get_provider() -> SimpleProvider:
+    """Get the global dependency provider."""
+    return _provider
+
+
+async def inject(func: Callable[..., Any], dependency_overrides_provider: SimpleProvider | None = None) -> Callable[[], Any]:
+    """Inject dependencies into a function and return a callable that executes it."""
+    
+    sig = inspect.signature(func)
+    parameters = sig.parameters
+    
+    # Build kwargs for the function
+    kwargs: dict[str, Any] = {}
+    
+    for param_name, param in parameters.items():
+        if param.default is inspect.Parameter.empty:
+            continue  # No default, skip
+            
+        # Check if the default is a Depends instance
+        if isinstance(param.default, Depends):
+            dependency = param.default.dependency
+            # Call the dependency to get the value
+            if inspect.iscoroutinefunction(dependency):
+                kwargs[param_name] = await dependency()
+            else:
+                kwargs[param_name] = dependency()
+    
+    @wraps(func)
+    async def wrapper() -> Any:
+        return await func(**kwargs)
+    
+    return wrapper
