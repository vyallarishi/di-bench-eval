@@ -0,0 +1,21 @@
+import unittest
+from unittest.mock import patch, MagicMock
+import pflake8
+
+
+class TestBasic(unittest.TestCase):
+    @patch('pflake8.flake8.main.cli.main')
+    @patch('pflake8.flake8.options.config')
+    def test_main_function_exists(self, mock_config, mock_main):
+        # Mock the config module's __file__ attribute
+        mock_config.__file__ = '/fake/path/to/config.py'
+        mock_main.return_value = 0
+        
+        # Test that main function can be called without error
+        result = pflake8.main()
+        mock_main.assert_called_once()
+        self.assertEqual(result, 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
