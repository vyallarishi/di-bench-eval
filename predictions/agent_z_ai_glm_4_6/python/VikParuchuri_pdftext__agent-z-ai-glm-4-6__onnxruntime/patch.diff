+from .settings import SETTINGS
+
+
+def get_model(
+    model_name: str,
+    device: Optional[str] = None,
+    *,
+    repo_id: Optional[str] = None,
+    force_download: bool = False,
+    config: Optional[dict] = None,
+) -> torch.nn.Module:
+    """
+    Load a model from HuggingFace Hub or local cache.
+
+    Args:
+        model_name: Name of the model file (without .pth extension)
+        device: Device to load the model on (auto-detect if None)
+        repo_id: HuggingFace repository ID (defaults to SETTINGS.model_repo)
+        force_download: Whether to force re-download
+        config: Optional model configuration
+
+    Returns:
+        Loaded PyTorch model
+    """
+    if device is None:
+        device = "cuda" if torch.cuda.is_available() else "cpu"
+
+    if repo_id is None:
+        repo_id = SETTINGS.model_repo
+
+    # Try to get the model from HuggingFace Hub
+    try:
+        model_path = hf_hub_download(
+            repo_id=repo_id,
+            filename=f"{model_name}.pth",
+            force_download=force_download,
+        )
+    except HfHubHTTPError:
+        # Fallback to local models directory
+        local_model_dir = Path(SETTINGS.models_dir) / model_name
+        model_path = local_model_dir / f"{model_name}.pth"
+        
+        if not model_path.exists():
+            raise FileNotFoundError(
+                f"Model {model_name} not found in HuggingFace Hub or locally at {model_path}"
+            )
+
+    # Load the PyTorch model
+    model = torch.load(model_path, map_location=device)
+    model.eval()
+    model.to(device)
+
+    return model
+
+
+def get_tokenizer(model_name: str, *, repo_id: Optional[str] = None) -> "PreTrainedTokenizer":
+    """
+    Get the tokenizer for a model from HuggingFace Hub.
+
+    Args:
+        model_name: Name of the model
+        repo_id: HuggingFace repository ID (defaults to SETTINGS.model_repo)
+
+    Returns:
+        HuggingFace tokenizer
+    """
+    from transformers import AutoTokenizer
+
+    if repo_id is None:
+        repo_id = SETTINGS.model_repo
+
+    try:
+        # Try to download from HuggingFace Hub
+        tokenizer_path = snapshot_download(repo_id=repo_id)
+        tokenizer = AutoTokenizer.from_pretrained(tokenizer_path)
+    except HfHubHTTPError:
+        # Fallback to local models directory
+        local_model_dir = Path(SETTINGS.models_dir) / model_name
+        if local_model_dir.exists():
+            tokenizer = AutoTokenizer.from_pretrained(str(local_model_dir))
+        else:
+            raise FileNotFoundError(
+                f"Tokenizer for model {model_name} not found in HuggingFace Hub or locally"
+            )
+
+    return tokenizer
