diff --git a/src/inscriptis/html_tree.py b/src/inscriptis/html_tree.py
new file mode 100644
index 0000000..175ff1f
--- /dev/null
+++ b/src/inscriptis/html_tree.py
@@ -0,0 +1,145 @@
+"""Pure-Python HTML tree builder replacing lxml.html.
+
+Provides a minimal ``HtmlElement`` tree and a ``fromstring`` parser
+that are API-compatible with the subset of lxml used by inscriptis.
+"""
+
+from html.parser import HTMLParser
+from typing import Dict, List, Optional
+
+
+class _Comment:
+    """Singleton sentinel for comment nodes (mirrors lxml.etree.Comment)."""
+
+    def __repr__(self) -> str:
+        return "Comment"
+
+
+Comment = _Comment()
+
+
+class ParserError(Exception):
+    """Raised when HTML parsing fails (mirrors lxml.etree.ParserError)."""
+
+
+class HtmlElement:
+    """A minimal HTML element node compatible with the lxml subset used.
+
+    Attributes:
+        tag: The tag name (str), or ``Comment`` for comment nodes.
+        attrib: A dict of HTML attributes.
+        text: The text content directly inside this element (before any child).
+        tail: The text content following this element's closing tag.
+    """
+
+    __slots__ = ("tag", "attrib", "text", "tail", "_children")
+
+    def __init__(
+        self,
+        tag: str,
+        attrib: Optional[Dict[str, str]] = None,
+        text: Optional[str] = None,
+        tail: Optional[str] = None,
+    ):
+        self.tag = tag
+        self.attrib = attrib or {}
+        self.text = text
+        self.tail = tail
+        self._children: List["HtmlElement"] = []
+
+    # -- list-like interface so ``for node in tree`` works --
+    def __iter__(self):
+        return iter(self._children)
+
+    def __len__(self) -> int:
+        return len(self._children)
+
+    def append(self, child: "HtmlElement") -> None:
+        self._children.append(child)
+
+    def __repr__(self) -> str:
+        return f"HtmlElement({self.tag!r})"
+
+
+class _TreeBuilder(HTMLParser):
+    """SAX-style HTMLParser that builds an HtmlElement tree."""
+
+    def __init__(self):
+        super().__init__(convert_charrefs=True)
+        self.root: Optional[HtmlElement] = None
+        self._stack: List[HtmlElement] = []
+
+    # -- helpers ----------------------------------------------------------
+
+    def _current(self) -> HtmlElement:
+        return self._stack[-1]
+
+    # -- parser callbacks -------------------------------------------------
+
+    def handle_starttag(self, tag: str, attrs: List[tuple]) -> None:
+        attrib = {k: v for k, v in attrs if v is not None}
+        elem = HtmlElement(tag, attrib)
+        if self._stack:
+            self._current().append(elem)
+        else:
+            self.root = elem
+        self._stack.append(elem)
+
+    def handle_endtag(self, tag: str) -> None:
+        # Pop up to the matching open tag (handles mismatched tags).
+        for i in range(len(self._stack) - 1, 0, -1):
+            if self._stack[i].tag == tag:
+                self._stack = self._stack[:i]
+                return
+        # No match found – pop one level if possible.
+        if len(self._stack) > 1:
+            self._stack.pop()
+
+    def handle_data(self, data: str) -> None:
+        if not self._stack:
+            # Text before any tag – wrap in a <span>.
+            elem = HtmlElement("span", text=data)
+            self.root = elem
+            self._stack.append(elem)
+            return
+        cur = self._current()
+        if cur._children:
+            # Data after children is tail of the last child.
+            last = cur._children[-1]
+            last.tail = (last.tail or "") + data
+        else:
+            cur.text = (cur.text or "") + data
+
+    def handle_comment(self, data: str) -> None:
+        comment = HtmlElement(Comment)  # type: ignore[arg-type]
+        comment.text = data
+        if self._stack:
+            self._current().append(comment)
+        else:
+            self.root = comment
+        # Comments don't go on the stack.
+
+    def handle_startendtag(self, tag: str, attrs: List[tuple]) -> None:
+        """Self-closing tags (e.g. <br/>)."""
+        attrib = {k: v for k, v in attrs if v is not None}
+        elem = HtmlElement(tag, attrib)
+        if self._stack:
+            self._current().append(elem)
+        else:
+            self.root = elem
+
+
+def fromstring(html: str) -> HtmlElement:
+    """Parse an HTML string and return the root ``HtmlElement``.
+
+    Raises:
+        ParserError: If the input cannot be parsed.
+    """
+    builder = _TreeBuilder()
+    try:
+        builder.feed(html)
+    except Exception as exc:
+        raise ParserError(str(exc)) from exc
+    if builder.root is None:
+        raise ParserError("No content parsed")
+    return builder.root
