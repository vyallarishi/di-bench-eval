+  def _try_setup(self, shallow: bool = False) -> None:
+    """Tries to setup module if scope is available and setup has not been called yet."""
+    if (
+      self.scope
+      and not self._state.in_setup
+      and self._state.setup_called != SetupState.DONE
+    ):
