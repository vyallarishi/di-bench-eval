+    Module._module_checks(self)
+
+    _, v_out = self.init_with_output(
+      rngs,
+      *args,
+      method=method,
+      mutable=mutable,
+      capture_intermediates=capture_intermediates,
+      **kwargs,
+    )
+    return v_out
