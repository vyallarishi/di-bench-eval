+    leaf_vals = get_variable_p.bind(
+      hijax_var,
+      treedef=hijax_var._treedef,
+      avals=leaf_avals,
+      var_type=hijax_var._var_type,
+      has_qdd=hijax_var.has_qdd,
+    )
+    variable = jax.tree.unflatten(hijax_var._treedef, leaf_vals)
+
+  return variable
