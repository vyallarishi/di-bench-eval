+        raise ValueError(
+          'Causal padding is only implemented for 1D convolutions.'
+        )
+      left_pad = kernel_dilation[0] * (kernel_size[0] - 1)
+      pads = [(0, 0), (left_pad, 0), (0, 0)]
+      inputs = jnp.pad(inputs, pads)
+      padding_lax = 'VALID'
