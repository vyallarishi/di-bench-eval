+def to_flat_state(state: State) -> FlatState:
+  """Convert state into flat state
+
+  Arguments:
+    state: A :class:`State` object.
+  Returns:
+    Flat state :class:`FlatState`
+  """
+  return FlatState(traversals.flatten_to_sequence(state._mapping), sort=True)
