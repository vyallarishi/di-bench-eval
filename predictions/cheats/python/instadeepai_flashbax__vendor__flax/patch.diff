+class GraphDefState(struct.PyTreeNode):
+  graphdef: graphlib.GraphDef[tp.Any] = struct.field(pytree_node=False)
+  state: State = struct.field(pytree_node=True)
+
+S = tp.TypeVar(
+  'S', bound=State | graphlib.GraphFlatState | list[tp.Any]
+)
