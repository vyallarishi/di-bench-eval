+@tp.overload
+def unpack(
+    node: A,
+    filter1: filterlib.Filter,
+    filter2: filterlib.Filter,
+    /,
+    *filters: filterlib.Filter,
+    graph: bool | None = None,
+) -> tuple[GraphState[A], ...]: ...
