+    def test_timer(self):
+        """Test :func:`humanfriendly.Timer`."""
+        for seconds, text in ((1, '1 second'),
+                              (2, '2 seconds'),
+                              (60, '1 minute'),
+                              (60 * 2, '2 minutes'),
+                              (60 * 60, '1 hour'),
