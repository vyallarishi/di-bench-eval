+        # hooks to adjust requests and responses.
+        self.compliance_hook = {
+            "access_token_response": set(),
+            "refresh_token_response": set(),
+            "protected_request": set(),
+            "refresh_token_request": set(),
+            "access_token_request": set(),
+        }
