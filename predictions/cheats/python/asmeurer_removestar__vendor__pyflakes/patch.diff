+
+        @overload
+        def f(s: None) -> None:
+            pass
+
+        @overload
+        def f(s: int) -> int:
+            pass
+
+        def f(s):
+            return s
+
+        @typing_extensions.overload
+        def g(s: None) -> None:
+            pass
+
+        @typing_extensions.overload
