+def test_keyed_memoize_method_with_uncached():
+    from pytools import keyed_memoize_method
+
+    class SomeClass:
+        def __init__(self):
+            self.run_count = 0
+
+        @keyed_memoize_method(key=lambda x, y, z: x)
+        def f(self, x, y, z):
+            del x, y, z
+            self.run_count += 1
+            return 17
+
+    sc = SomeClass()
+    sc.f(17, 18, z=19)
+    sc.f(17, 19, z=20)
+    assert sc.run_count == 1
+    sc.f(18, 19, z=20)
+    assert sc.run_count == 2
+
+    sc.f.clear_cache(sc)
