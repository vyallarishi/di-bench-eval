+# {{{ numpy dtype mangling
+
+def common_dtype(dtypes: Iterator[DTypeLike],
+                 default: DTypeLike | None = None) -> np.dtype[Any]:
+    import numpy as np
+
+    ddtypes = [np.dtype(dtype) for dtype in dtypes]
+    if ddtypes:
+        return argmax2((dtype, dtype.num) for dtype in ddtypes)
+
+    if default is not None:
+        return np.dtype(default)
+
+    raise ValueError("cannot find common dtype of empty dtype list")
+
+
+def to_uncomplex_dtype(dtype):
+    import numpy as np
+    return np.array(1, dtype=dtype).real.dtype.type
+
+
+def match_precision(dtype, dtype_to_match):
+    import numpy
+
+    tgt_is_double = dtype_to_match in [
+            numpy.float64, numpy.complex128]
+
+    dtype_is_complex = dtype.kind == "c"
+    if dtype_is_complex:
+        if tgt_is_double:
+            return numpy.dtype(numpy.complex128)
+        return numpy.dtype(numpy.complex64)
+    if tgt_is_double:
+        return numpy.dtype(numpy.float64)
+    return numpy.dtype(numpy.float32)
+
+# }}}
