+def shift(vec: MutableSequence[T], dist: int) -> Sequence[T]:
+    """Return a copy of *vec* shifted by *dist* such that
+
+    .. code:: python
+
+        shift(a, i)[j] == a[(i+j) % len(a)]
+    """
+
+    result = vec[:]
+
+    n = len(vec)
+    dist = dist % n
+
+    # modulo only returns positive distances!
+    if dist > 0:
+        result[dist:] = vec[:n-dist]
+        result[:dist] = vec[n-dist:]
+
+    return result
