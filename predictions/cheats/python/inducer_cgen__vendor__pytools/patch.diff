+def average(iterable):
+    """Return the average of the values in iterable.
+
+    iterable may not be empty.
+    """
+    it = iterable.__iter__()
+
+    try:
+        s = next(it)
+        count = 1
+    except StopIteration:
+        raise ValueError("empty average") from None
+
+    for value in it:
+        s = s + value
+        count += 1
+
+    return s/count
+
