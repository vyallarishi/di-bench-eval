+                cache = self.cache
+                lock = self.cache_lock
+                cond = self.cache_condition
+                key = self.cache_key(*args, **kwargs)
+
+                with lock:
+                    cond.wait_for(lambda: key not in self.__pending)
+                    try:
+                        result = cache[key]
+                        self.__hits += 1
+                        return result
+                    except KeyError:
+                        self.__pending.add(key)
+                        self.__misses += 1
