+    ttl: Any = 600,
+    timer: Callable[[], _T] = ...,
+    typed: bool = False,
+) -> Callable[[Callable[_P, _R]], _cachetools_cache_wrapper[_P, _R]]: ...
+@overload
+def ttl_cache(
