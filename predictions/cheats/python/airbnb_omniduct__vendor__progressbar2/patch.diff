+# at import instead of per no_color() call, which runs for every widget on
+# every redraw.
+_ANSI_COLOR_RE: re.Pattern[str] = re.compile('\x1b\\[.*?[@-~]')
+_ANSI_COLOR_RE_BYTES: re.Pattern[bytes] = re.compile(
+    bytes(terminal.ESC, 'ascii') + b'\\[.*?[@-~]',
+)
