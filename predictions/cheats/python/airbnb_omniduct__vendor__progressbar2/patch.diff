+        [
+            type[BaseException],
+            BaseException,
+            TracebackType | None,
+        ],
+        None,
+    ]
+    wrapped_stdout: int = 0
+    wrapped_stderr: int = 0
+    wrapped_logging: int = 0
+    wrapped_excepthook: int = 0
