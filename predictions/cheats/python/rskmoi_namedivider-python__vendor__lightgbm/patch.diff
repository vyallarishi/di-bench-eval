+def _safe_call(ret: int) -> None:
+    """Check the return value from C API call.
+
+    Parameters
+    ----------
+    ret : int
+        The return value from C API calls.
+    """
+    if ret != 0:
+        raise LightGBMError(_LIB.LGBM_GetLastError().decode("utf-8"))
