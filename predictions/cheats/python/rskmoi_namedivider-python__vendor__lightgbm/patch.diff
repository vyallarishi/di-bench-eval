+class _TempFile:
+    """Proxy class to workaround errors on Windows."""
+
+    def __enter__(self) -> "_TempFile":
+        with NamedTemporaryFile(prefix="lightgbm_tmp_", delete=True) as f:
+            self.name = f.name
+            self.path = Path(self.name)
+        return self
