+# coding: utf-8
+"""Scikit-learn wrapper interface for LightGBM."""
+
+import copy
+import warnings
+from inspect import signature
+from pathlib import Path
+from typing import TYPE_CHECKING, Any, Callable, Dict, List, Optional, Tuple, Union
+
