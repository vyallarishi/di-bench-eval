+@with_numpy
+def test_memmap_persistence(tmpdir):
+    rnd = np.random.RandomState(0)
+    a = rnd.random_sample(10)
+    filename = tmpdir.join("test1.pkl").strpath
+    numpy_pickle.dump(a, filename)
