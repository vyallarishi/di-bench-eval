+
+def division(x, y):
+    return x / y
+
+
+def square(x):
+    return x**2
+
+
+class MyExceptionWithFinickyInit(Exception):
+    """An exception class with non trivial __init__"""
+
+    def __init__(self, a, b, c, d):
+        pass
+
+
+def exception_raiser(x, custom_exception=False):
+    if x == 7:
+        raise (
+            MyExceptionWithFinickyInit("a", "b", "c", "d")
+            if custom_exception
+            else ValueError
+        )
