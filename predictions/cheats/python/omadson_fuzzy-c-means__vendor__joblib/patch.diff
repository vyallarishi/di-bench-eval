+        self.old_parallel_config = getattr(_backend, "config", default_parallel_config)
+
+        backend = self._check_backend(backend, inner_max_num_threads, **backend_params)
+
+        new_config = {
+            "n_jobs": n_jobs,
+            "verbose": verbose,
+            "temp_folder": temp_folder,
+            "max_nbytes": max_nbytes,
+            "mmap_mode": mmap_mode,
+            "prefer": prefer,
+            "require": require,
+            "backend": backend,
+        }
