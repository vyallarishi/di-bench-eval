+def make_schema_id(schema: dict) -> tuple[str, str]:
+    schema_json = json.dumps(schema, separators=(",", ":"))
+    schema_id = hashlib.blake2b(schema_json.encode(), digest_size=16).hexdigest()
+    return schema_id, schema_json
