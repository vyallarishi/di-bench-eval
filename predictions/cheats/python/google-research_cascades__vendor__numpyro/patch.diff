+        return dist.LowRankMultivariateNormal(loc, cov_factor, cov_diag)
+
+    def median(self, params):
+        loc = self._get_reshape_transform()(params["{}_loc".format(self.prefix)])
+        return self._unpack_and_constrain(loc, params)
+
