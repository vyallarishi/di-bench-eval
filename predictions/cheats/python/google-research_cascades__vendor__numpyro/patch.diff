+class _SoftplusLowerCholesky(_LowerCholesky):
+    def feasible_like(self, prototype: NonScalarArray) -> NonScalarArray:
+        return jnp.broadcast_to(
+            jnp.eye(prototype.shape[-1]) * np.log(2), prototype.shape
+        )
