+def _to_logits_multinom(probs: ArrayLike) -> Array:
+    probs = jnp.asarray(probs)
+    safe_probs = jnp.where(probs > 0, probs, 1.0)
+    return jnp.where(probs > 0, jnp.log(safe_probs), -jnp.inf)
