+
+@vmap_over.register
+def _vmap_over_negative_binomial_probs(
+    dist: NegativeBinomialProbs, total_count=None, probs=None
+):
+    dist_axes = vmap_over.dispatch(GammaPoisson)(
+        dist, concentration=total_count, rate=probs
