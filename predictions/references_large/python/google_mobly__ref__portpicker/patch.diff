+def pick_unused_port():
+  """Returns a TCP and UDP port on the host that is currently free.
+
+  The port is chosen by the operating system (a bind to port 0), then checked
+  to be bindable for both protocols on all interfaces. A port returned here can
+  still be taken by another process before the caller binds it.
+  """
+  for _ in range(MAX_PORT_ALLOCATION_RETRY):
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as tcp:
+      tcp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+      tcp.bind(('', 0))
+      port = tcp.getsockname()[1]
+    try:
+      with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as udp:
+        udp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        udp.bind(('', port))
+    except OSError:
+      continue
+    return port
+  raise Error(
+      'Failed to find a free port after %d retries' % MAX_PORT_ALLOCATION_RETRY
+  )
+
