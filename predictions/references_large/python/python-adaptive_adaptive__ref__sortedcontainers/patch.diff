@@ -0,0 +1,248 @@
+"""Sorted containers for the learners: a dict iterated in key order with
+positional access, a set iterated in key order, and a list kept in key order.
+
+Built on ``bisect`` over a plain list, so insertion is O(n) rather than the
+O(log n) of a tree; the learners hold at most a few thousand points, where that
+difference is not measurable.
+"""
+
+from __future__ import annotations
+
+import bisect
+from collections.abc import KeysView, Set
+from typing import Any, Callable, Iterable, Optional
+
+
+class _KeysView:
+    """The keys of a SortedDict in order, indexable and sliceable."""
+
+    def __init__(self, keys: list):
+        self._keys = keys
+
+    def __getitem__(self, index):
+        return self._keys[index]
+
+    def __iter__(self):
+        return iter(self._keys)
+
+    def __len__(self):
+        return len(self._keys)
+
+    def __contains__(self, key):
+        i = bisect.bisect_left(self._keys, key)
+        return i < len(self._keys) and self._keys[i] == key
+
+    def __reversed__(self):
+        return reversed(self._keys)
+
+    def __eq__(self, other):
+        """Set equality against other key views and sets, sequence equality
+        against lists and tuples, as a dict's keys view compares."""
+        if isinstance(other, (list, tuple)):
+            return self._keys == list(other)
+        if isinstance(other, (_KeysView, KeysView, Set, frozenset, set)):
+            return set(self._keys) == set(other)
+        return NotImplemented
+
+    __hash__ = None
+
+    def __repr__(self):
+        return f"SortedKeysView({self._keys!r})"
+
+
+class SortedDict(dict):
+    """A dict whose keys are kept sorted: iteration, ``keys()``, ``values()`` and
+    ``items()`` run in key order, and ``index``, ``bisect_left`` and ``peekitem``
+    address keys by sorted position."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__()
+        self._keys: list = []
+        self.update(*args, **kwargs)
+
+    def __setitem__(self, key, value):
+        if key not in self:
+            bisect.insort(self._keys, key)
+        super().__setitem__(key, value)
+
+    def __delitem__(self, key):
+        super().__delitem__(key)
+        del self._keys[bisect.bisect_left(self._keys, key)]
+
+    def __iter__(self):
+        return iter(self._keys)
+
+    def __reversed__(self):
+        return reversed(self._keys)
+
+    def update(self, *args, **kwargs):
+        for key, value in dict(*args, **kwargs).items():
+            self[key] = value
+
+    def setdefault(self, key, default=None):
+        if key not in self:
+            self[key] = default
+        return self[key]
+
+    def pop(self, key, *default):
+        if key in self:
+            value = super().pop(key)
+            del self._keys[bisect.bisect_left(self._keys, key)]
+            return value
+        if default:
+            return default[0]
+        raise KeyError(key)
+
+    def popitem(self, index=-1):
+        key = self._keys[index]
+        return key, self.pop(key)
+
+    def peekitem(self, index=-1):
+        key = self._keys[index]
+        return key, self[key]
+
+    def clear(self):
+        super().clear()
+        self._keys.clear()
+
+    def copy(self):
+        return SortedDict(self)
+
+    def keys(self):
+        return _KeysView(self._keys)
+
+    def values(self):
+        return [self[key] for key in self._keys]
+
+    def items(self):
+        return [(key, self[key]) for key in self._keys]
+
+    def index(self, key):
+        i = bisect.bisect_left(self._keys, key)
+        if i == len(self._keys) or self._keys[i] != key:
+            raise ValueError(f"{key!r} is not in list")
+        return i
+
+    def bisect_left(self, key):
+        return bisect.bisect_left(self._keys, key)
+
+    def bisect_right(self, key):
+        return bisect.bisect_right(self._keys, key)
+
+    def __reduce__(self):
+        return (SortedDict, (dict(self.items()),))
+
+    def __repr__(self):
+        return f"SortedDict({dict(self.items())!r})"
+
+
+class SortedKeyList:
+    """A list kept ordered by ``key(value)``; equal keys keep insertion order."""
+
+    def __init__(self, iterable: Iterable = (), key: Optional[Callable[[Any], Any]] = None):
+        self._key = key
+        self._keys: list = []
+        self._values: list = []
+        for value in iterable:
+            self.add(value)
+
+    def add(self, value):
+        k = value if self._key is None else self._key(value)
+        i = bisect.bisect_right(self._keys, k)
+        self._keys.insert(i, k)
+        self._values.insert(i, value)
+
+    def pop(self, index=-1):
+        del self._keys[index]
+        return self._values.pop(index)
+
+    def remove(self, value):
+        del self[self._find(value)]
+
+    def discard(self, value):
+        try:
+            del self[self._find(value)]
+        except ValueError:
+            pass
+
+    def _find(self, value):
+        k = value if self._key is None else self._key(value)
+        i = bisect.bisect_left(self._keys, k)
+        while i < len(self._keys) and self._keys[i] == k:
+            if self._values[i] == value:
+                return i
+            i += 1
+        raise ValueError(f"{value!r} is not in list")
+
+    def __delitem__(self, index):
+        del self._keys[index]
+        del self._values[index]
+
+    def __getitem__(self, index):
+        return self._values[index]
+
+    def __contains__(self, value):
+        try:
+            self._find(value)
+            return True
+        except ValueError:
+            return False
+
+    def __iter__(self):
+        return iter(self._values)
+
+    def __reversed__(self):
+        return reversed(self._values)
+
+    def __len__(self):
+        return len(self._values)
+
+    def __reduce__(self):
+        return (type(self), (list(self._values), self._key))
+
+    def __repr__(self):
+        return f"{type(self).__name__}({self._values!r})"
+
+
+class SortedSet(SortedKeyList):
+    """A set iterated in order of ``key(value)``; adding a present value is a no-op."""
+
+    def __init__(self, iterable: Iterable = (), key: Optional[Callable[[Any], Any]] = None):
+        self._members: set = set()
+        super().__init__(iterable, key)
+
+    def add(self, value):
+        if value in self._members:
+            return
+        self._members.add(value)
+        super().add(value)
+
+    def update(self, *iterables):
+        for iterable in iterables:
+            for value in iterable:
+                self.add(value)
+
+    def discard(self, value):
+        if value in self._members:
+            self._members.discard(value)
+            super().remove(value)
+
+    def remove(self, value):
+        if value not in self._members:
+            raise KeyError(value)
+        self.discard(value)
+
+    def pop(self, index=-1):
+        value = super().pop(index)
+        self._members.discard(value)
+        return value
+
+    def __delitem__(self, index):
+        self._members.discard(self._values[index])
+        super().__delitem__(index)
+
+    def __contains__(self, value):
+        return value in self._members
+
+    def __reduce__(self):
+        return (SortedSet, (list(self._values), self._key))
