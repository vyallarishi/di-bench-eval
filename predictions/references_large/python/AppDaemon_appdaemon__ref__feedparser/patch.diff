diff --git a/tests/test_rss.py b/tests/test_rss.py
new file mode 100644
index 0000000..d445e87
--- /dev/null
+++ b/tests/test_rss.py
@@ -0,0 +1,38 @@
+from appdaemon import rss
+
+RSS2 = b"""<?xml version="1.0"?><rss version="2.0"><channel><title>CNN Top</title><link>http://cnn.com</link>
+<description>desc</description>
+<item><title>Story &amp; one</title><link>http://cnn.com/1</link>
+<description>&lt;p&gt;Hello &lt;b&gt;bold&lt;/b&gt;&lt;/p&gt;</description>
+<pubDate>Wed, 02 Oct 2024 08:00:00 GMT</pubDate><guid>g1</guid></item>
+<item><title>Two</title><link>http://cnn.com/2</link></item></channel></rss>"""
+
+ATOM = b"""<?xml version="1.0"?><feed xmlns="http://www.w3.org/2005/Atom"><title>A</title>
+<entry><title>E1</title><link href="http://x/1"/><summary>s</summary><updated>2024-10-02T08:00:00Z</updated></entry></feed>"""
+
+
+def test_rss2():
+    feed = rss.parse(RSS2)
+    assert "bozo_exception" not in feed
+    assert feed["feed"]["title"] == "CNN Top"
+    assert feed["feed"]["link"] == "http://cnn.com"
+    assert feed["feed"]["subtitle"] == "desc"
+    assert [e["title"] for e in feed["entries"]] == ["Story & one", "Two"]
+    assert feed["entries"][0]["summary"] == "<p>Hello <b>bold</b></p>"
+    assert feed["entries"][0]["link"] == "http://cnn.com/1"
+    assert feed["entries"][0]["published"] == "Wed, 02 Oct 2024 08:00:00 GMT"
+    assert feed["entries"][0]["id"] == "g1"
+    assert "summary" not in feed["entries"][1]
+
+
+def test_atom():
+    feed = rss.parse(ATOM)
+    assert feed["feed"]["title"] == "A"
+    assert feed["entries"] == [
+        {"title": "E1", "summary": "s", "updated": "2024-10-02T08:00:00Z", "link": "http://x/1"}
+    ]
+
+
+def test_bad_xml_and_bad_url_report_bozo_exception():
+    assert "bozo_exception" in rss.parse(b"<rss><channel><item><title>x</title></item>")
+    assert "bozo_exception" in rss.parse("http://127.0.0.1:9/nothing")
