diff --git a/appdaemon/rss.py b/appdaemon/rss.py
new file mode 100644
index 0000000..3abd6a8
--- /dev/null
+++ b/appdaemon/rss.py
@@ -0,0 +1,105 @@
+"""Minimal RSS/Atom feed reader for the dashboard's ``rss`` widget.
+
+The dashboard widget (``widgets/baserss/baserss.js``) reads ``feed.entries[i].title``
+and, optionally, ``summary`` / ``description``. ``http.py`` only checks for a
+``bozo_exception`` key and stores the whole result as entity state. ``parse``
+returns a plain dict with exactly that shape, so it drops in where
+``feedparser.parse`` was used:
+
+    {"feed": {"title": ..., "link": ..., "subtitle": ...},
+     "entries": [{"title": ..., "link": ..., "summary": ..., "published": ..., "id": ...}, ...],
+     "bozo": 0}
+
+Any fetch or XML error yields ``{"bozo": 1, "bozo_exception": <exception>,
+"entries": [], "feed": {}}``; the caller logs the exception and skips the feed.
+"""
+
+import os
+import xml.etree.ElementTree as ET
+
+import requests
+
+ATOM = "{http://www.w3.org/2005/Atom}"
+RDF = "{http://www.w3.org/1999/02/22-rdf-syntax-ns#}"
+RSS1 = "{http://purl.org/rss/1.0/}"
+DC = "{http://purl.org/dc/elements/1.1/}"
+CONTENT = "{http://purl.org/rss/1.0/modules/content/}"
+
+# (output key, [candidate element tags in priority order])
+_ENTRY_FIELDS = (
+    ("title", ("title", RSS1 + "title", ATOM + "title", DC + "title")),
+    ("summary", ("description", RSS1 + "description", ATOM + "summary", DC + "description")),
+    ("content", (CONTENT + "encoded",)),
+    ("published", ("pubDate", ATOM + "published", DC + "date")),
+    ("updated", (ATOM + "updated",)),
+    ("id", ("guid", ATOM + "id")),
+)
+_FEED_FIELDS = (
+    ("title", ("title", RSS1 + "title", ATOM + "title")),
+    ("subtitle", ("description", RSS1 + "description", ATOM + "subtitle")),
+)
+
+
+def _text(parent, tags):
+    for tag in tags:
+        el = parent.find(tag)
+        if el is not None:
+            return (el.text or "").strip()
+    return None
+
+
+def _link(parent):
+    """RSS puts the URL in <link>'s text; Atom in <link href=...>."""
+    for el in parent.findall("link") + parent.findall(RSS1 + "link"):
+        if el.text and el.text.strip():
+            return el.text.strip()
+    alternates = [el for el in parent.findall(ATOM + "link") if el.get("href")]
+    for el in alternates:
+        if el.get("rel", "alternate") == "alternate":
+            return el.get("href")
+    return alternates[0].get("href") if alternates else None
+
+
+def _fields(parent, spec):
+    out = {}
+    for key, tags in spec:
+        value = _text(parent, tags)
+        if value is not None:
+            out[key] = value
+    link = _link(parent)
+    if link is not None:
+        out["link"] = link
+    if "id" not in out and parent.get(RDF + "about"):  # RSS 1.0 items are identified by rdf:about
+        out["id"] = parent.get(RDF + "about")
+    return out
+
+
+def _fetch(source):
+    """A URL is fetched, an existing path is read, anything else is the document itself."""
+    if isinstance(source, bytes):
+        return source
+    if source.startswith(("http://", "https://")):
+        r = requests.get(source, headers={"User-Agent": "AppDaemon"}, timeout=30)
+        r.raise_for_status()
+        return r.content
+    if os.path.exists(source):
+        with open(source, "rb") as f:
+            return f.read()
+    return source.encode("utf-8")
+
+
+def parse(source):
+    try:
+        root = ET.fromstring(_fetch(source))
+        if root.tag == ATOM + "feed":
+            channel, items = root, root.findall(ATOM + "entry")
+        elif root.tag == RDF + "RDF":
+            channel = root.find(RSS1 + "channel")
+            items = root.findall(RSS1 + "item")
+        else:  # RSS 0.9x / 2.0
+            channel = root.find("channel")
+            items = root.findall("item") if channel is None else channel.findall("item")
+        feed = _fields(channel, _FEED_FIELDS) if channel is not None else {}
+        return {"feed": feed, "entries": [_fields(i, _ENTRY_FIELDS) for i in items], "bozo": 0}
+    except Exception as e:  # fetch or parse failure: the caller logs it and skips the feed
+        return {"feed": {}, "entries": [], "bozo": 1, "bozo_exception": e}
