index 0000000..8e9c5bd
--- /dev/null
+++ b/appdaemon/sun.py
@@ -0,0 +1,166 @@
+"""Sunrise, sunset and sun-elevation times for the scheduler.
+
+Solar position from the NOAA solar-calculator equations (Meeus), with the
+corrections the scheduler relied on: the sun's apparent radius, atmospheric
+refraction near the horizon, and the horizon dip for an elevated observer.
+Results are timezone-aware datetimes, in the location's zone when ``local``
+is true and in UTC otherwise. A ``ValueError`` is raised when the sun does not
+reach the requested zenith on that day (polar night or day, or an elevation
+the sun never attains at that latitude).
+"""
+
+import datetime
+import math
+from enum import Enum
+from zoneinfo import ZoneInfo
+
+SUN_APPARENT_RADIUS = 32.0 / (60.0 * 2.0)  # degrees
+EARTH_RADIUS = 6356900.0  # metres
+UTC = datetime.timezone.utc
+
+
+class SunDirection(Enum):
+    RISING = 1
+    SETTING = -1
+
+
+def _julian_day(date):
+    y, m = date.year, date.month
+    if m <= 2:
+        y, m = y - 1, m + 12
+    a = y // 100
+    b = 2 - a + a // 4
+    return int(365.25 * (y + 4716)) + int(30.6001 * (m + 1)) + date.day + b - 1524.5
+
+
+def _declination_and_equation_of_time(jc):
+    """Sun declination (degrees) and equation of time (minutes) at Julian century jc."""
+    l0 = (280.46646 + jc * (36000.76983 + jc * 0.0003032)) % 360.0
+    m = math.radians(357.52911 + jc * (35999.05029 - 0.0001537 * jc))
+    e = 0.016708634 - jc * (0.000042037 + 0.0000001267 * jc)
+    centre = (
+        math.sin(m) * (1.914602 - jc * (0.004817 + 0.000014 * jc))
+        + math.sin(2 * m) * (0.019993 - 0.000101 * jc)
+        + math.sin(3 * m) * 0.000289
+    )
+    omega = math.radians(125.04 - 1934.136 * jc)
+    apparent_long = math.radians(l0 + centre - 0.00569 - 0.00478 * math.sin(omega))
+    arcsec = 21.448 - jc * (46.815 + jc * (0.00059 - jc * 0.001813))
+    obliquity = math.radians(23.0 + (26.0 + arcsec / 60.0) / 60.0 + 0.00256 * math.cos(omega))
+    declination = math.asin(math.sin(obliquity) * math.sin(apparent_long))
+    y = math.tan(obliquity / 2.0) ** 2
+    l0r = math.radians(l0)
+    eot = 4.0 * math.degrees(
+        y * math.sin(2 * l0r)
+        - 2 * e * math.sin(m)
+        + 4 * e * y * math.sin(m) * math.cos(2 * l0r)
+        - 0.5 * y * y * math.sin(4 * l0r)
+        - 1.25 * e * e * math.sin(2 * m)
+    )
+    return math.degrees(declination), eot
+
+
+def _refraction(zenith):
+    """Atmospheric refraction (degrees) for a body at the given true zenith angle."""
+    elevation = 90.0 - zenith
+    if elevation >= 85.0:
+        return 0.0
+    te = math.tan(math.radians(elevation))
+    if elevation > 5.0:
+        r = 58.1 / te - 0.07 / te**3 + 0.000086 / te**5
+    elif elevation > -0.575:
+        r = 1735.0 + elevation * (-518.2 + elevation * (103.4 + elevation * (-12.79 + elevation * 0.711)))
+    else:
+        r = -20.774 / te
+    return r / 3600.0
+
+
+def _horizon_dip(observer_elevation):
+    if observer_elevation <= 0.0:
+        return 0.0
+    return math.degrees(math.acos(EARTH_RADIUS / (EARTH_RADIUS + observer_elevation)))
+
+
+def _transit(latitude, longitude, observer_elevation, date, zenith, direction):
+    """UTC time on ``date`` at which the sun crosses ``zenith`` going in ``direction``.
+
+    Two passes: the second re-evaluates declination and the equation of time at the
+    time found by the first.
+    """
+    latitude = max(-89.8, min(89.8, latitude))
+    zenith += _horizon_dip(observer_elevation)
+    zenith += _refraction(zenith)
+    lat, zen = math.radians(latitude), math.radians(zenith)
+    jd = _julian_day(date)
+    minutes = 0.0
+    for _ in range(2):
+        declination, eot = _declination_and_equation_of_time((jd + minutes / 1440.0 - 2451545.0) / 36525.0)
+        dec = math.radians(declination)
+        cos_ha = (math.cos(zen) - math.sin(lat) * math.sin(dec)) / (math.cos(lat) * math.cos(dec))
+        if cos_ha > 1.0:
+            raise ValueError("below")
+        if cos_ha < -1.0:
+            raise ValueError("above")
+        hour_angle = math.degrees(math.acos(cos_ha)) * direction.value
+        offset = (-longitude - hour_angle) * 4.0 - eot
+        if offset < -720.0:  # an event before 00:00 UTC belongs to the previous UTC day
+            offset += 1440.0
+        minutes = 720.0 + offset
+    return datetime.datetime(date.year, date.month, date.day, tzinfo=UTC) + datetime.timedelta(minutes=minutes)
+
+
+class SolarLocation:
+    """Sun times for one place: ``sunrise``, ``sunset`` and ``time_at_elevation``."""
+
+    def __init__(self, timezone, latitude, longitude):
+        self.timezone = timezone
+        self.tzinfo = ZoneInfo(timezone)
+        self.latitude = latitude
+        self.longitude = longitude
+
+    def _tz(self, local):
+        return self.tzinfo if local else UTC
+
+    def _date(self, date, local):
+        return date if date is not None else datetime.datetime.now(self._tz(local)).date()
+
+    def _horizon(self, date, local, observer_elevation, direction):
+        """Sunrise or sunset falling on ``date`` in the requested zone.
+
+        The transit is computed on the UTC day; if that lands on a different
+        civil date in the requested zone, the adjacent day is computed instead.
+        """
+        date = self._date(date, local)
+        tz = self._tz(local)
+        try:
+            dt = _transit(self.latitude, self.longitude, observer_elevation, date,
+                          90.0 + SUN_APPARENT_RADIUS, direction).astimezone(tz)
+            if dt.date() != date:
+                step = datetime.timedelta(days=1 if dt.date() < date else -1)
+                dt = _transit(self.latitude, self.longitude, observer_elevation, date + step,
+                              90.0 + SUN_APPARENT_RADIUS, direction).astimezone(tz)
+                if dt.date() != date:
+                    raise ValueError("Unable to find a %s time on the date specified"
+                                     % ("sunrise" if direction is SunDirection.RISING else "sunset"))
+        except ValueError as e:
+            if e.args[0] in ("above", "below"):
+                raise ValueError(f"Sun is always {e.args[0]} the horizon on this day, at this location.") from None
+            raise
+        return dt
+
+    def sunrise(self, date=None, local=True, observer_elevation=0.0):
+        return self._horizon(date, local, observer_elevation, SunDirection.RISING)
+
+    def sunset(self, date=None, local=True, observer_elevation=0.0):
+        return self._horizon(date, local, observer_elevation, SunDirection.SETTING)
+
+    def time_at_elevation(self, elevation, date=None, direction=SunDirection.RISING, local=True):
+        if elevation > 90.0:
+            elevation = 180.0 - elevation
+            direction = SunDirection.SETTING if direction is SunDirection.RISING else SunDirection.RISING
+        date = self._date(date, local)
+        try:
+            dt = _transit(self.latitude, self.longitude, 0.0, date, 90.0 - elevation, direction)
+        except ValueError:
+            raise ValueError(f"Sun never reaches an elevation of {elevation} degrees at this location.") from None
+        return dt.astimezone(self._tz(local))
