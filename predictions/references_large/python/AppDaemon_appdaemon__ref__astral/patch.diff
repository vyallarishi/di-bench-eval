diff --git a/tests/test_sun.py b/tests/test_sun.py
new file mode 100644
index 0000000..e1a2772
--- /dev/null
+++ b/tests/test_sun.py
@@ -0,0 +1,57 @@
+import datetime
+
+import pytest
+
+from appdaemon.sun import SolarLocation, SunDirection
+
+TOL = datetime.timedelta(milliseconds=1)
+
+
+def close(a, b):
+    return abs(a - b) < TOL and a.utcoffset() == b.utcoffset()
+
+
+def test_berlin_sunrise_sunset_with_observer_elevation():
+    loc = SolarLocation("Europe/Berlin", 52.52, 13.405)
+    d = datetime.date(2024, 10, 2)
+    assert close(
+        loc.sunrise(date=d, local=True, observer_elevation=35.0),
+        datetime.datetime.fromisoformat("2024-10-02T07:08:41.399644+02:00"),
+    )
+    assert close(
+        loc.sunrise(date=d, local=False, observer_elevation=35.0),
+        datetime.datetime.fromisoformat("2024-10-02T05:08:41.399644+00:00"),
+    )
+    assert close(
+        loc.sunset(date=d, local=True, observer_elevation=35.0),
+        datetime.datetime.fromisoformat("2024-10-02T18:41:30.621186+02:00"),
+    )
+
+
+def test_time_at_elevation():
+    loc = SolarLocation("Europe/Berlin", 52.52, 13.405)
+    dt = loc.time_at_elevation(elevation=10.0, direction=SunDirection.SETTING, date=datetime.date(2024, 10, 2), local=False)
+    assert close(dt, datetime.datetime.fromisoformat("2024-10-02T15:27:52.217590+00:00"))
+    rising = loc.time_at_elevation(elevation=10.0, direction=SunDirection.RISING, date=datetime.date(2024, 10, 2), local=False)
+    assert rising < dt
+
+
+def test_event_is_reported_on_the_requested_local_date():
+    # far-west longitude in a far-east zone: the UTC-day transit lands on the next local date
+    loc = SolarLocation("Pacific/Auckland", -22.9017, -125.6943)
+    dt = loc.sunrise(date=datetime.date(2020, 7, 16), local=True)
+    assert dt.date() == datetime.date(2020, 7, 16)
+    assert close(dt, datetime.datetime.fromisoformat("2020-07-16T03:03:11.117541+12:00"))
+
+
+def test_polar_night_and_unreachable_elevation_raise_value_error():
+    svalbard = SolarLocation("UTC", 78.2, 15.6)
+    with pytest.raises(ValueError, match="always below the horizon"):
+        svalbard.sunrise(date=datetime.date(2024, 12, 21), local=False)
+    with pytest.raises(ValueError, match="never reaches an elevation"):
+        svalbard.time_at_elevation(elevation=60, date=datetime.date(2024, 6, 21), local=False)
+
+
+def test_default_date_is_today_in_the_requested_zone():
+    loc = SolarLocation("UTC", 51.4733, -0.0008333)
+    assert loc.sunrise(local=False).date() == datetime.datetime.now(datetime.timezone.utc).date()
