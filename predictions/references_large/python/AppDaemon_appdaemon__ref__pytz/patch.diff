diff --git a/tests/test_timezone.py b/tests/test_timezone.py
new file mode 100644
index 0000000..2896159
--- /dev/null
+++ b/tests/test_timezone.py
@@ -0,0 +1,31 @@
+import datetime
+
+import pytest
+
+from appdaemon import timezone
+
+
+def test_zone_name_and_utc():
+    tz = timezone.timezone("Europe/Berlin")
+    assert tz.zone == "Europe/Berlin" and str(tz) == "Europe/Berlin"
+    assert timezone.utc.zone == "UTC"
+    now = timezone.utc.localize(datetime.datetime(2024, 7, 1, 12, 0))
+    assert now.utcoffset() == datetime.timedelta(0)
+
+
+def test_localize_normal_ambiguous_and_missing_times():
+    tz = timezone.timezone("Europe/Berlin")
+    assert tz.localize(datetime.datetime(2024, 7, 1, 12, 0)).isoformat() == "2024-07-01T12:00:00+02:00"
+    # 02:30 on 27 Oct 2024 happens twice: standard time (CET, +01:00) is chosen
+    assert tz.localize(datetime.datetime(2024, 10, 27, 2, 30)).isoformat() == "2024-10-27T02:30:00+01:00"
+    # 02:30 on 31 Mar 2024 never happens: read with the standard offset
+    assert tz.localize(datetime.datetime(2024, 3, 31, 2, 30)).isoformat() == "2024-03-31T02:30:00+01:00"
+    aware = tz.localize(datetime.datetime(2024, 7, 1, 12, 0))
+    assert aware.astimezone(timezone.utc).isoformat() == "2024-07-01T10:00:00+00:00"
+    with pytest.raises(ValueError):
+        tz.localize(aware)
+
+
+def test_unknown_zone():
+    with pytest.raises(timezone.UnknownTimeZoneError):
+        timezone.timezone("Mars/Olympus")
