new file mode 100644
index 0000000..336e73d
--- /dev/null
+++ b/appdaemon/timezone.py
@@ -0,0 +1,47 @@
+"""Time zones for AppDaemon, on the standard library's ``zoneinfo``.
+
+``timezone(name)`` returns a zone object; ``utc`` is the UTC zone. Each zone has a
+``zone`` attribute (its IANA name) and ``localize(naive_datetime)``, which attaches
+the zone to a naive wall-clock time the way the scheduler needs: an ambiguous time
+(the repeated hour when clocks go back) is taken as standard time, the later of the
+two instants, and a time that does not exist (the skipped hour when clocks go
+forward) is read with the standard-time offset. ``UnknownTimeZoneError`` is raised
+for a name the zone database does not know.
+"""
+
+import datetime
+import zoneinfo
+
+
+class UnknownTimeZoneError(KeyError):
+    """The zone database has no zone of that name."""
+
+
+class Timezone(zoneinfo.ZoneInfo):
+    @property
+    def zone(self):
+        return self.key
+
+    def localize(self, dt):
+        """Attach this zone to a naive datetime without converting it."""
+        if dt.tzinfo is not None:
+            raise ValueError("Not naive datetime (tzinfo is already set)")
+        first = dt.replace(tzinfo=self, fold=0)
+        second = dt.replace(tzinfo=self, fold=1)
+        if first.utcoffset() == second.utcoffset():
+            return first
+        # The two folds disagree: either the wall time happens twice (choose the
+        # later, standard-time instant) or it never happens (keep the standard
+        # offset, which is what the first fold holds in the skipped hour).
+        round_trip = first.astimezone(datetime.timezone.utc).astimezone(self)
+        return first if round_trip.replace(tzinfo=None) != dt else second
+
+
+def timezone(name):
+    try:
+        return Timezone(name)
+    except (zoneinfo.ZoneInfoNotFoundError, ValueError):
+        raise UnknownTimeZoneError(name) from None
+
+
+utc = timezone("UTC")
