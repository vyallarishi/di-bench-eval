index 0000000..6337fe5
--- /dev/null
+++ b/appdaemon/toml_writer.py
@@ -0,0 +1,85 @@
+"""Serialise a dict as TOML, for writing app configuration files.
+
+The layout matches the files this project used to write: top-level scalar and
+array keys first, then one ``[dotted.table]`` section per nested dict (a header
+is only emitted for a table that has scalar keys or is empty), arrays one
+element per line with a trailing comma, dicts inside arrays as inline tables.
+Values: str, bool, int, float (``inf``/``nan``), datetime/date/time, list,
+dict. Anything else, including ``None``, raises ``TypeError``.
+"""
+
+import datetime
+import math
+import re
+
+_BARE_KEY = re.compile(r"^[A-Za-z0-9_-]+$")
+_ESCAPES = {"\\": "\\\\", '"': '\\"', "\b": "\\b", "\f": "\\f", "\n": "\\n", "\r": "\\r"}
+
+
+def _string(s):
+    out = []
+    for ch in s:
+        if ch in _ESCAPES:
+            out.append(_ESCAPES[ch])
+        elif (ord(ch) < 0x20 and ch != "\t") or ch == "\x7f":
+            out.append(f"\\u{ord(ch):04X}")
+        else:
+            out.append(ch)
+    return '"' + "".join(out) + '"'
+
+
+def _key(k):
+    return k if _BARE_KEY.match(k) else _string(k)
+
+
+def _value(v, indent=""):
+    if isinstance(v, bool):
+        return "true" if v else "false"
+    if isinstance(v, int):
+        return str(v)
+    if isinstance(v, float):
+        if math.isnan(v):
+            return "nan"
+        if math.isinf(v):
+            return "inf" if v > 0 else "-inf"
+        return repr(v)
+    if isinstance(v, str):
+        return _string(v)
+    if isinstance(v, datetime.datetime):
+        return v.isoformat(sep=" ")
+    if isinstance(v, (datetime.date, datetime.time)):
+        return v.isoformat()
+    if isinstance(v, dict):
+        if not v:
+            return "{}"
+        return "{ " + ", ".join(f"{_key(k)} = {_value(x, indent)}" for k, x in v.items()) + " }"
+    if isinstance(v, (list, tuple)):
+        if not v:
+            return "[]"
+        inner = indent + "    "
+        return "[\n" + "".join(f"{inner}{_value(x, inner)},\n" for x in v) + indent + "]"
+    raise TypeError(f"Object of type {type(v)} is not TOML serializable")
+
+
+def _sections(d, path, out):
+    scalars = [(k, v) for k, v in d.items() if not isinstance(v, dict)]
+    tables = [(k, v) for k, v in d.items() if isinstance(v, dict)]
+    lines = []
+    if path and (scalars or not tables):
+        lines.append("[" + ".".join(_key(p) for p in path) + "]\n")
+    lines.extend(f"{_key(k)} = {_value(v)}\n" for k, v in scalars)
+    if lines:
+        out.append("".join(lines))
+    for k, v in tables:
+        _sections(v, path + [k], out)
+
+
+def dumps(obj):
+    out = []
+    _sections(obj, [], out)
+    return "\n".join(out)
+
+
+def dump(obj, fp):
+    """Write ``obj`` to a binary file object as UTF-8 TOML."""
+    fp.write(dumps(obj).encode("utf-8"))
