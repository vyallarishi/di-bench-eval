diff --git a/tests/test_toml_writer.py b/tests/test_toml_writer.py
new file mode 100644
index 0000000..d429faf
--- /dev/null
+++ b/tests/test_toml_writer.py
@@ -0,0 +1,106 @@
+import datetime
+import io
+import math
+
+import pytest
+import tomli
+
+from appdaemon import toml_writer
+
+SAMPLE = {
+    "top": "level",
+    "n": 1,
+    "apps": {
+        "hello_world": {"module": "hello", "class": "HelloWorld"},
+        "lights": {
+            "module": "lights",
+            "brightness": 0.75,
+            "enabled": True,
+            "rooms": ["kitchen", "hall"],
+            "scenes": [{"name": "a", "level": 1}, {"name": "b", "level": 2}],
+            "weird key": 1,
+            'quote"s': 'back\\slash and "quotes" and\nnewline\ttab',
+            "unicode": "héllo ✓",
+            "neg": -2.5e-3,
+            "empty": [],
+            "nested": [[1, 2], [3]],
+            "dt": datetime.datetime(2024, 10, 2, 8, 0, tzinfo=datetime.timezone.utc),
+            "schedule": {"on": "07:00", "off": "22:30"},
+            "emptyt": {},
+        },
+    },
+}
+
+EXPECTED = '''top = "level"
+n = 1
+
+[apps.hello_world]
+module = "hello"
+class = "HelloWorld"
+
+[apps.lights]
+module = "lights"
+brightness = 0.75
+enabled = true
+rooms = [
+    "kitchen",
+    "hall",
+]
+scenes = [
+    { name = "a", level = 1 },
+    { name = "b", level = 2 },
+]
+"weird key" = 1
+"quote\\"s" = "back\\\\slash and \\"quotes\\" and\\nnewline\ttab"
+unicode = "héllo ✓"
+neg = -0.0025
+empty = []
+nested = [
+    [
+        1,
+        2,
+    ],
+    [
+        3,
+    ],
+]
+dt = 2024-10-02 08:00:00+00:00
+
+[apps.lights.schedule]
+on = "07:00"
+off = "22:30"
+
+[apps.lights.emptyt]
+'''
+
+
+def test_layout_matches_previous_writer_exactly():
+    assert toml_writer.dumps(SAMPLE) == EXPECTED
+
+
+def test_round_trips_through_the_toml_reader():
+    text = toml_writer.dumps(SAMPLE)
+    assert tomli.loads(text) == SAMPLE
+    assert toml_writer.dumps({"a": {"b": {"c": 1}}, "z": [{"x": 1, "sub": {"y": 2}}]}) == (
+        "z = [\n    { x = 1, sub = { y = 2 } },\n]\n\n[a.b]\nc = 1\n"
+    )
+
+
+def test_inf_nan_and_dates():
+    text = toml_writer.dumps({"i": math.inf, "m": -math.inf, "d": datetime.date(2024, 10, 2), "t": datetime.time(8, 0)})
+    assert text == "i = inf\nm = -inf\nd = 2024-10-02\nt = 08:00:00\n"
+    back = tomli.loads(toml_writer.dumps({"n": math.nan}))
+    assert math.isnan(back["n"])
+
+
+def test_dump_writes_utf8_bytes():
+    buf = io.BytesIO()
+    toml_writer.dump({"k": "héllo"}, buf)
+    assert buf.getvalue() == 'k = "héllo"\n'.encode("utf-8")
+
+
+def test_unsupported_types_raise_type_error():
+    with pytest.raises(TypeError):
+        toml_writer.dumps({"a": None})
+    with pytest.raises(TypeError):
+        toml_writer.dumps({"a": object()})
