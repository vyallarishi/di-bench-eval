+def parse_iso8601(text):
+    """Parse an ISO 8601 timestamp into an aware ``datetime``.
+
+    Accepts ``YYYY-MM-DD`` (or ``YYYYMMDD``) with an optional ``T``/space-separated
+    time (hours, optional minutes, seconds and fraction) and an optional ``Z`` or
+    ``+HH[:MM]`` offset. A timestamp without an offset is taken as UTC, as Home
+    Assistant's ``last_changed`` strings and AppDaemon's own timestamps are.
+    Raises ``ValueError`` for anything else.
+    """
+    m = _ISO8601.match(text or "")
+    if m is None:
+        raise ValueError(f"Unable to parse date string {text!r}")
+    year, month, day, hour, minute, second, fraction, offset = m.groups()
+    tz = datetime.timezone.utc
+    if offset and offset not in ("Z", "z"):
+        sign = -1 if offset[0] == "-" else 1
+        hours, minutes = int(offset[1:3]), int(offset[3:].lstrip(":") or 0)
+        tz = datetime.timezone(sign * datetime.timedelta(hours=hours, minutes=minutes))
+    return datetime.datetime(
+        int(year), int(month), int(day), int(hour or 0), int(minute or 0), int(second or 0),
+        int((fraction or "0").ljust(6, "0")), tzinfo=tz,
+    )
