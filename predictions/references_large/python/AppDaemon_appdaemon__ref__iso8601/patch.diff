+_ISO8601 = re.compile(
+    r"^\s*(\d{4})-?(\d{2})-?(\d{2})"
+    r"(?:[T ](\d{2})(?::?(\d{2})(?::?(\d{2})(?:[.,](\d{1,6})\d*)?)?)?"
+    r"\s*(Z|z|[+-]\d{2}(?::?\d{2})?)?)?\s*$"
