+++ b/tests/test_parse_iso8601.py
@@ -0,0 +1,33 @@
+import datetime
+
+import pytest
+
+from appdaemon import utils
+
+UTC = datetime.timezone.utc
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("2016-07-13T14:24:02.040658-04:00", datetime.datetime(2016, 7, 13, 14, 24, 2, 40658, tzinfo=datetime.timezone(datetime.timedelta(hours=-4)))),
+        ("2024-10-02T08:00:00+01:00", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=datetime.timezone(datetime.timedelta(hours=1)))),
+        ("2024-10-02T08:00:00+0100", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=datetime.timezone(datetime.timedelta(hours=1)))),
+        ("2024-10-02T08:00:00Z", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=UTC)),
+        ("2024-10-02T08:00:00", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=UTC)),
+        ("2024-10-02 08:00:00.5", datetime.datetime(2024, 10, 2, 8, 0, 0, 500000, tzinfo=UTC)),
+        ("2024-10-02T08:00:00.123456789+00:00", datetime.datetime(2024, 10, 2, 8, 0, 0, 123456, tzinfo=UTC)),
+        ("2024-10-02T08:00", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=UTC)),
+        ("2024-10-02T08", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=UTC)),
+        ("2024-10-02", datetime.datetime(2024, 10, 2, tzinfo=UTC)),
+        ("20241002T080000Z", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=UTC)),
+    ],
+)
+def test_parse_iso8601(text, expected):
+    assert utils.parse_iso8601(text) == expected
+
+
+@pytest.mark.parametrize("text", ["never", "", "2024-13-01", "2024-10-02T25:00:00"])
+def test_unparseable_raises_value_error(text):
+    with pytest.raises(ValueError):
+        utils.parse_iso8601(text)
