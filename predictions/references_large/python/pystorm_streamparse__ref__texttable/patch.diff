+def _format_cell(value):
+    """Format a table cell: integral numbers as integers, other numbers to three
+    decimals, magnitudes above 1e8 in scientific notation, anything else via str()."""
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return str(value)
+    try:
+        whole = int(value)
+    except (OverflowError, ValueError):  # inf, nan
+        return str(value)
+    if value != whole:
+        return f"{value:.3f}"
+    if abs(whole) > 1e8:
+        return f"{float(whole):.3e}"
+    return str(whole)
+
+
+def draw_table(columns, rows, aligns, max_width=115):
+    """Render rows as an ASCII table with a centred header.
+
+    Cells are wrapped so the table fits in ``max_width`` columns and each column is
+    aligned by ``aligns`` ('l', 'c' or 'r').
+    """
+    cells = [[str(c) for c in columns]] + [[_format_cell(v) for v in row] for row in rows]
+    widths = [
+        max(len(line) for row in cells for line in row[i].split("\n"))
+        for i in range(len(columns))
+    ]
+    while sum(widths) + 3 * len(widths) + 1 > max_width and max(widths) > 1:
+        widths[widths.index(max(widths))] -= 1
+    hline = "+" + "+".join("-" * (w + 2) for w in widths) + "+"
+    header_line = "+" + "+".join("=" * (w + 2) for w in widths) + "+"
+
+    def render(row, row_aligns):
+        wrapped = [textwrap.wrap(text, widths[i]) or [""] for i, text in enumerate(row)]
+        out = []
+        for n in range(max(len(lines) for lines in wrapped)):
+            parts = []
+            for i, lines in enumerate(wrapped):
+                text = lines[n] if n < len(lines) else ""
+                if row_aligns[i] == "r":
+                    text = text.rjust(widths[i])
+                elif row_aligns[i] == "c":
+                    left = (widths[i] - len(text)) // 2
+                    text = " " * left + text + " " * (widths[i] - len(text) - left)
+                else:
+                    text = text.ljust(widths[i])
+                parts.append(" " + text + " ")
+            out.append("|" + "|".join(parts) + "|")
+        return out
+
+    lines = [hline] + render(cells[0], ["c"] * len(columns)) + [header_line]
+    for row in cells[1:]:
+        lines += render(row, aligns) + [hline]
+    return "\n".join(lines)
+
+
