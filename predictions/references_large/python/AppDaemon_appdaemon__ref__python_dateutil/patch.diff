+++ b/tests/test_str_to_dt.py
@@ -0,0 +1,43 @@
+import datetime
+
+import pytest
+
+from appdaemon import utils
+
+UTC = datetime.timezone.utc
+PLUS1 = datetime.timezone(datetime.timedelta(hours=1))
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("2019-04-16 12:00:03+01:00", datetime.datetime(2019, 4, 16, 12, 0, 3, tzinfo=PLUS1)),
+        ("2024-10-02T08:00:00+01:00", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=PLUS1)),
+        ("2024-10-02T08:00:00+0100", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=PLUS1)),
+        ("2024-10-02T08:00:00-05", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=datetime.timezone(datetime.timedelta(hours=-5)))),
+        ("2024-10-02T08:00:00Z", datetime.datetime(2024, 10, 2, 8, 0, tzinfo=UTC)),
+        ("2024-10-02T08:00:00.123456+00:00", datetime.datetime(2024, 10, 2, 8, 0, 0, 123456, tzinfo=UTC)),
+        ("2024-10-02T08:00:00.5", datetime.datetime(2024, 10, 2, 8, 0, 0, 500000)),
+        ("2024-10-02T08:00:00", datetime.datetime(2024, 10, 2, 8, 0)),
+        ("2024-10-02 08:00:00", datetime.datetime(2024, 10, 2, 8, 0)),
+        ("2024-10-02T08:00", datetime.datetime(2024, 10, 2, 8, 0)),
+        ("2024-10-02", datetime.datetime(2024, 10, 2)),
+        ("1970-01-01T00:00:00", datetime.datetime(1970, 1, 1)),
+    ],
+)
+def test_str_to_dt(text, expected):
+    assert utils.str_to_dt(text) == expected
+
+
+def test_round_trip_with_dt_to_str():
+    now = datetime.datetime(2024, 10, 2, 8, 30, 15, tzinfo=UTC)
+    assert utils.str_to_dt(utils.dt_to_str(now)) == now
+    assert utils.str_to_dt(utils.dt_to_str(now, PLUS1)) == now
+    naive = datetime.datetime(2024, 10, 2, 8, 30, 15)
+    assert utils.str_to_dt(utils.dt_to_str(naive)) == naive
+
+
+@pytest.mark.parametrize("text", ["never", "", "2024-13-45", "08:00:00", "tomorrow", "2024-10-02T08"])
+def test_unparseable_raises_value_error(text):
+    with pytest.raises(ValueError):
+        utils.str_to_dt(text)
