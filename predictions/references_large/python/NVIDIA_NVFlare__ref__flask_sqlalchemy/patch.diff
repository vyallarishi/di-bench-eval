+"""Flask integration for SQLAlchemy, providing what the dashboard models and store use.
+
+``db.Model`` is a declarative base whose subclasses are named after their class in
+snake case and carry a ``query`` property; ``db.Column``, the column types,
+``db.ForeignKey`` and ``db.relationship`` are SQLAlchemy's own; ``db.session`` is a
+scoped session bound to the application's engine and removed when the application
+context ends; ``db.init_app``, ``db.create_all`` and ``db.drop_all`` manage the engine
+configured by ``SQLALCHEMY_DATABASE_URI`` and ``SQLALCHEMY_ECHO``.
+"""
+
+import re
+
+import sqlalchemy
+from flask import current_app
+from sqlalchemy import orm
+
+_CAMEL = re.compile(r"((?<=[a-z0-9])[A-Z]|(?!^)[A-Z](?=[a-z]))")
+
+
+def _snake_case(name: str) -> str:
+    return _CAMEL.sub(r"_\1", name).lower()
+
+
+class _QueryProperty:
+    def __get__(self, _instance, model):
+        return model.database.session.query(model)
+
+
+class Database:
+    Column = sqlalchemy.Column
+    Integer = sqlalchemy.Integer
+    String = sqlalchemy.String
+    DateTime = sqlalchemy.DateTime
+    Boolean = sqlalchemy.Boolean
+    ForeignKey = sqlalchemy.ForeignKey
+    relationship = staticmethod(orm.relationship)
+
+    def __init__(self):
+        self.session = orm.scoped_session(orm.sessionmaker())
+        database = self
+
+        class _ModelBase:
+            database = None
+            query = _QueryProperty()
+
+            @orm.declared_attr.directive
+            def __tablename__(cls):
+                return _snake_case(cls.__name__)
+
+        self.Model = orm.declarative_base(cls=_ModelBase)
+        self.Model.database = database
+
+    def init_app(self, app):
+        engine = sqlalchemy.create_engine(
+            app.config["SQLALCHEMY_DATABASE_URI"], echo=bool(app.config.get("SQLALCHEMY_ECHO", False))
+        )
+        app.extensions["sqlalchemy_engine"] = engine
+        self.session.configure(bind=engine)
+
+        @app.teardown_appcontext
+        def _remove_session(_exc):
+            self.session.remove()
+
+    @property
+    def engine(self):
+        return current_app.extensions["sqlalchemy_engine"]
+
+    def create_all(self):
+        self.Model.metadata.create_all(self.engine)
+
+    def drop_all(self):
+        self.Model.metadata.drop_all(self.engine)
