+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import hashlib
+
+import pytest
+
+from nvflare.dashboard.application.password import check_password_hash, generate_password_hash
+
+
+def test_new_hashes_use_scrypt_in_the_stored_format():
+    h = generate_password_hash("s3cret")
+    method, salt, digest = h.split("$")
+    assert method == "scrypt:32768:8:1"
+    assert len(salt) == 16 and salt.isalnum()
+    assert len(digest) == 128
+    assert (
+        digest
+        == hashlib.scrypt(b"s3cret", salt=salt.encode(), n=32768, r=8, p=1, maxmem=132 * 1024 * 1024, dklen=64).hex()
+    )
+
+
+def test_round_trip_and_salt_uniqueness():
+    h1, h2 = generate_password_hash("pässwörd ✓"), generate_password_hash("pässwörd ✓")
+    assert h1 != h2
+    assert check_password_hash(h1, "pässwörd ✓") and check_password_hash(h2, "pässwörd ✓")
+    assert not check_password_hash(h1, "password")
+
+
+def test_legacy_pbkdf2_hashes_still_verify():
+    # produced by an earlier dashboard version's hasher
+    legacy = "pbkdf2:sha256:1000$8f6OsL0F$be0d3254bdc751bad6f31ab0e053017adb39603a2c1e0b9a6663f5316b722ef5"
+    assert check_password_hash(legacy, "s3cret")
+    assert not check_password_hash(legacy, "nope")
+
+
+@pytest.mark.parametrize("bad", ["", "plain", "scrypt:1:1:1$x", "pbkdf2:sha256:1000$salt", "scrypt:32768:8:1$abc$zz"])
+def test_malformed_hashes_do_not_verify(bad):
+    assert check_password_hash(bad, "s3cret") is False
+
+
+def test_unknown_method_is_an_error():
+    with pytest.raises(ValueError, match="Invalid hash method 'md5'"):
+        check_password_hash("md5$abc$def", "s3cret")
