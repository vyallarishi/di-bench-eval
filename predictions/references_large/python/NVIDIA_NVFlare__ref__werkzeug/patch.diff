+"""Password hashing for dashboard users.
+
+Hashes are stored as ``method$salt$hexdigest``. New hashes use scrypt with the
+parameters the dashboard has always written (``scrypt:32768:8:1``, 16-character
+salt, 64-byte key). Verification also accepts ``pbkdf2:<digest>:<iterations>``
+hashes so users created by earlier dashboard versions can still log in.
+"""
+
+import hashlib
+import hmac
+import secrets
+import string
+
+SCRYPT_N, SCRYPT_R, SCRYPT_P = 32768, 8, 1
+SCRYPT_MAXMEM = 132 * 1024 * 1024
+PBKDF2_DEFAULT_DIGEST, PBKDF2_DEFAULT_ITERATIONS = "sha256", 1000000
+_SALT_CHARS = string.ascii_letters + string.digits
+
+
+def _digest(method: str, salt: str, password: str) -> str:
+    """Hex digest of ``password`` under ``method`` (``scrypt:n:r:p`` or ``pbkdf2[:digest[:iterations]]``)."""
+    parts = method.split(":")
+    pw, salt_bytes = password.encode("utf-8"), salt.encode("utf-8")
+    if parts[0] == "scrypt":
+        n, r, p = (int(x) for x in parts[1:4]) if len(parts) == 4 else (SCRYPT_N, SCRYPT_R, SCRYPT_P)
+        return hashlib.scrypt(pw, salt=salt_bytes, n=n, r=r, p=p, maxmem=SCRYPT_MAXMEM, dklen=64).hex()
+    if parts[0] == "pbkdf2":
+        digest = parts[1] if len(parts) > 1 else PBKDF2_DEFAULT_DIGEST
+        iterations = int(parts[2]) if len(parts) > 2 else PBKDF2_DEFAULT_ITERATIONS
+        return hashlib.pbkdf2_hmac(digest, pw, salt_bytes, iterations).hex()
+    raise ValueError(f"Invalid hash method '{parts[0]}'.")
+
+
+def generate_password_hash(password: str, salt_length: int = 16) -> str:
+    salt = "".join(secrets.choice(_SALT_CHARS) for _ in range(salt_length))
+    method = f"scrypt:{SCRYPT_N}:{SCRYPT_R}:{SCRYPT_P}"
+    return f"{method}${salt}${_digest(method, salt, password)}"
+
+
+def check_password_hash(pwhash: str, password: str) -> bool:
+    try:
+        method, salt, hashval = pwhash.split("$", 2)
+    except ValueError:
+        return False
+    try:
+        return hmac.compare_digest(_digest(method, salt, password), hashval)
+    except ValueError as e:
+        if str(e).startswith("Invalid hash method"):
+            raise
+        return False
