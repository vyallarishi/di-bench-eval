+#!/usr/bin/env python3
+
+# Simple test to verify our wcswidth implementation works
+import sys
+import os
+
+# Add current directory to path
+sys.path.insert(0, '.')
+
+try:
+    from wikitextparser._wikitext import wcswidth
+    print("✅ Successfully imported wcswidth")
+    
+    # Test basic functionality
+    test_cases = [
+        ("hello", 5),
+        ("", 0),
+        (None, 0),
+        ("hello world", 11),
+    ]
+    
+    for text, expected in test_cases:
+        result = wcswidth(text)
+        if result == expected:
+            print(f"✅ wcswidth('{text}') = {result} (expected {expected})")
+        else:
+            print(f"❌ wcswidth('{text}') = {result}, expected {expected}")
+            
+    print("Basic functionality test completed!")
+    
+except Exception as e:
+    print(f"❌ Error: {e}")
+    import traceback
+    traceback.print_exc()
