diff --git a/sqlalchemy_searchable/types.py b/sqlalchemy_searchable/types.py
new file mode 100644
index 0000000..7d9caa7
--- /dev/null
+++ b/sqlalchemy_searchable/types.py
@@ -0,0 +1,23 @@
+import sqlalchemy as sa
+from sqlalchemy.dialects.postgresql import TSVECTOR
+
+
+class TSVectorType(sa.types.TypeDecorator):
+    """
+    Provides additional functionality for PostgreSQL TSVector type.
+
+    This is a minimal reimplementation of the ``TSVectorType`` that used to
+    be provided by the ``sqlalchemy_utils`` package, kept here so that this
+    project no longer depends on that package.
+    """
+
+    impl = TSVECTOR
+    cache_ok = True
+
+    def __init__(self, *args, **kwargs):
+        self.columns = args
+        self.options = {}
+        for option in ("regconfig", "weights", "auto_index"):
+            if option in kwargs:
+                self.options[option] = kwargs.pop(option)
+        super().__init__(**kwargs)
