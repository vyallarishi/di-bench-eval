+def wcswidth(s: str) -> int:
+    """Return the display width of a string.
+
+    This is a lightweight replacement for the third-party `wcwidth`
+    package's `wcswidth` function, using the `unicodedata` module from
+    the standard library. Combining characters are treated as having
+    zero width and East-Asian wide/full-width characters are treated as
+    having a width of two columns; everything else counts as one column.
+    """
+    width = 0
+    for c in s:
+        if combining(c):
+            continue
+        if east_asian_width(c) in ('W', 'F'):
+            width += 2
+        else:
+            width += 1
+    return width
+
