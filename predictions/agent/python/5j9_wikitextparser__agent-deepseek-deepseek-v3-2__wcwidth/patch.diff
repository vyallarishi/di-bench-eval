+# Simple wcswidth replacement for display width calculation
+import unicodedata
 
+def wcswidth(s: str) -> int:
+    """
+    Calculate display width of a string.
+    Simplified version that handles common cases:
+    - ASCII characters: width 1
+    - Zero-width characters (like ZWNJ \u200C): width 0
+    - Combining characters (accents): width 0
+    - Most other characters: width 1
+    This is a simplified replacement for the wcwidth library.
+    """
+    if not s:
+        return 0
+    
+    # Fast path for ASCII
+    try:
+        s.encode('ascii')
+        return len(s)
+    except UnicodeEncodeError:
+        pass
+    
+    width = 0
+    for char in s:
+        # Check for zero-width characters
+        cp = ord(char)
+        
+        # Zero-width joiners and non-joiners
+        if cp == 0x200C or cp == 0x200D:  # ZWNJ and ZWJ
+            continue
+        
+        # Check Unicode category for combining/mark characters
+        category = unicodedata.category(char)
+        if category.startswith('M'):  # Mark characters (combining accents, etc.)
+            continue
+        
+        # Check for other zero-width characters
+        # Variation selectors
+        if 0xFE00 <= cp <= 0xFE0F:  # Variation Selectors
+            continue
+        if 0xE0100 <= cp <= 0xE01EF:  # Variation Selectors Supplement
+            continue
+        
+        # For now, treat all other non-ASCII as width 1
+        # This is a simplification but should work for most cases
+        width += 1
+    
+    return width
