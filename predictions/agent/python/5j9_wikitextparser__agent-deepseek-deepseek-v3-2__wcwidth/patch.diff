+#!/usr/bin/env python3
+"""Test the wcswidth replacement."""
+
+# Import the function from our module
+import sys
+sys.path.insert(0, '.')
+from wikitextparser._wikitext import wcswidth
+
+# Test cases
+test_cases = [
+    ("", 0),
+    ("hello", 5),
+    ("hello world", 11),
+    ("مرحبا", 5),  # Arabic word, each character width 1
+    ("\u200C", 0),  # ZWNJ should be width 0
+    ("a\u200Cb", 2),  # ZWNJ in middle should be ignored
+    ("لا", 2),  # Arabic lam + alef, each width 1
+    ("café", 4),  # ASCII + é (combining might be handled differently)
+    ("caf\u00e9", 4),  # precomposed é
+    ("cafe\u0301", 4),  # e + combining acute accent
+]
+
+print("Testing wcswidth replacement:")
+all_passed = True
+for s, expected in test_cases:
+    result = wcswidth(s)
+    passed = result == expected
+    all_passed = all_passed and passed
+    status = "✓" if passed else "✗"
+    print(f"{status} wcswidth({repr(s)}) = {result} (expected {expected})")
+
+if all_passed:
+    print("\nAll tests passed!")
+else:
+    print("\nSome tests failed!")
+    sys.exit(1)
