+# Custom connection classes that override the _output method to ensure Host header is first
+class RevProxyHTTPConnection(HTTPConnection):
+    def _output(self, s):
+        """Host header should always be first"""
+        if hasattr(self, '_buffer'):
+            if isinstance(s, str):
+                s = s.encode('latin-1')
+            if s.lower().startswith(b'host: '):
+                self._buffer.insert(1, s)
+            else:
+                self._buffer.append(s)
+        else:
+            # Fallback for older Python versions
+            super()._output(s)
 
