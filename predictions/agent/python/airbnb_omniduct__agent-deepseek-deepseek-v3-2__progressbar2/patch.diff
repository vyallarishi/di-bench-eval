+class SimpleProgressBar:
+    """A simple progress bar implementation to replace progressbar2."""
+    
+    def __init__(self, widgets=None, redirect_stderr=True, redirect_stdout=True, max_value=100):
+        self.max_value = max_value
+        self.current_value = 0
+        self.started = False
+        self.finished = False
+        self.start_time = None
+        self.widgets = widgets or []
+        self.redirect_stderr = redirect_stderr
+        self.redirect_stdout = redirect_stdout
+        
+    def start(self):
+        self.started = True
+        self.start_time = time.time()
+        self.update(0)
+        return self
+        
+    def update(self, value):
+        if not self.started:
+            self.start()
+        
+        if value is None:
+            return
+            
+        self.current_value = value
+        if self.current_value > self.max_value:
+            self.current_value = self.max_value
+            
+        # Calculate elapsed time
+        elapsed = time.time() - self.start_time
+        
+        # Build progress bar string
+        bar_str = ""
+        for widget in self.widgets:
+            if isinstance(widget, str):
+                bar_str += widget
+            elif hasattr(widget, '__call__'):
+                bar_str += widget(self.current_value, self.max_value, elapsed)
+        
+        # Print progress bar
+        if self.redirect_stderr:
+            print(f"\r{bar_str}", end="", file=sys.stderr, flush=True)
+        elif self.redirect_stdout:
+            print(f"\r{bar_str}", end="", file=sys.stdout, flush=True)
+            
+        return self
+        
+    def finish(self, end="\n"):
+        self.finished = True
+        if end:
+            if self.redirect_stderr:
+                print(end, file=sys.stderr, end="", flush=True)
+            elif self.redirect_stdout:
+                print(end, file=sys.stdout, end="", flush=True)
+
+
+class RotatingMarker:
+    """A simple rotating marker widget for indeterminate progress bars."""
+    
+    def __init__(self):
+        self.markers = ['|', '/', '-', '\\']
+        self.index = 0
+        
+    def __call__(self, current_value, max_value, elapsed):
+        marker = self.markers[self.index]
+        self.index = (self.index + 1) % len(self.markers)
+        return marker
+
+
+class Bar:
+    """A simple bar widget for determinate progress bars."""
+    
+    def __init__(self, width=20):
+        self.width = width
+        
+    def __call__(self, current_value, max_value, elapsed):
+        if max_value == 0:
+            return "[{}]".format(" " * self.width)
+        
+        progress = int(self.width * current_value / max_value)
+        bar = "=" * progress + " " * (self.width - progress)
+        return f"[{bar}]"
+
+
+class Timer:
+    """A simple timer widget."""
+    
+    def __init__(self, format=" %(elapsed)s"):
+        self.format = format
+        
+    def __call__(self, current_value, max_value, elapsed):
+        # Format elapsed time
+        if elapsed < 60:
+            elapsed_str = f"{elapsed:.1f}s"
+        elif elapsed < 3600:
+            minutes = elapsed // 60
+            seconds = elapsed % 60
+            elapsed_str = f"{minutes:.0f}m{seconds:.0f}s"
+        else:
+            hours = elapsed // 3600
+            minutes = (elapsed % 3600) // 60
+            elapsed_str = f"{hours:.0f}h{minutes:.0f}m"
+            
+        return self.format % {"elapsed": elapsed_str}
+
