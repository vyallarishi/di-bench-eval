diff --git a/run_tests.py b/run_tests.py
new file mode 100644
index 0000000..6530b29
--- /dev/null
+++ b/run_tests.py
@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+import subprocess
+import sys
+import os
+
+# Install package in development mode
+result = subprocess.run([sys.executable, "-m", "pip", "install", "-e", "."], 
+                       capture_output=True, text=True)
+if result.returncode != 0:
+    print("Failed to install package:")
+    print(result.stderr)
+    sys.exit(1)
+
+# Run the unit tests
+result = subprocess.run([sys.executable, "-m", "unittest", "discover", "-v", "-s", "test"], 
+                       capture_output=True, text=True)
+print("STDOUT:")
+print(result.stdout)
+print("STDERR:")
+print(result.stderr)
+print("Return code:", result.returncode)
