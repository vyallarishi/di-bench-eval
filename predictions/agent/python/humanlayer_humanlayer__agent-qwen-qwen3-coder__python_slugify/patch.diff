+    ("My Agent Name", "my-agent-name"),
+    ("TestAgent", "testagent"),
+    ("Agent with !@# Special Chars", "agent-with-special-chars"),
+    ("", ""),
+    ("  spaces  ", "spaces"),
+    ("Multiple   Spaces", "multiple-spaces"),
+]
+
+print("Testing slugify implementation:")
+all_passed = True
+for input_val, expected in test_cases:
+    result = slugify(input_val)
+    status = "PASS" if result == expected else "FAIL"
+    if status == "FAIL":
+        all_passed = False
+    print(f"{status}: slugify('{input_val}') -> '{result}' (expected: '{expected}')")
