+#!/usr/bin/env python3
+
+# Test our custom slugify implementation
+import sys
+import os
+
+# Add the current directory to the path so we can import from humanlayer
+sys.path.insert(0, '.')
+
+from humanlayer.core.approval import slugify
+
+def test_slugify():
+    # Test basic functionality
+    print(f"slugify('My Agent Name'): '{slugify('My Agent Name')}'")
+    print(f"slugify('Agent123'): '{slugify('Agent123')}'")
+    print(f"slugify('Test Agent!@#$%^&*()'): '{slugify('Test Agent!@#$%^&*()')}'")
+    print(f"slugify(''): '{slugify('')}'")
+    print(f"slugify('  spaces  '): '{slugify('  spaces  ')}'")
+    print(f"slugify('multiple   spaces'): '{slugify('multiple   spaces')}'")
+    print(f"slugify('special-chars_underscore'): '{slugify('special-chars_underscore')}'")
+    
+    # Verify expected outputs
+    assert slugify("My Agent Name") == "my-agent-name"
+    assert slugify("Agent123") == "agent123"
+    assert slugify("Test Agent!@#$%^&*()") == "test-agent"
+    assert slugify("") == ""
+    assert slugify("  spaces  ") == "spaces"
+    assert slugify("multiple   spaces") == "multiple-spaces"
+    assert slugify("special-chars_underscore") == "special-chars-underscore"
+    
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_slugify()
