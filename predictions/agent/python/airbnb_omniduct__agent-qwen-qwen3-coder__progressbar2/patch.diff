+#!/usr/bin/env python
+
+import sys
+import os
+sys.path.insert(0, os.path.dirname(__file__))
+
+from omniduct.utils.debug import StatusLogger
+
+def test_status_logger_progress():
+    """Test that StatusLogger progress functionality works without progressbar2"""
+    logger = StatusLogger()
+    
+    # Test basic progress functionality
+    logger.progress(0)
+    logger.progress(50)
+    logger.progress(100, complete=True)
+    
+    # Test indeterminate progress
+    logger.progress(0, indeterminate=True)
+    logger.progress(complete=True)
+    
+    print("All progress tests passed!")
+
+if __name__ == "__main__":
+    test_status_logger_progress()
