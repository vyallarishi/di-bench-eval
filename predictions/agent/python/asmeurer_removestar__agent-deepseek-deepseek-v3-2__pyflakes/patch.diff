+# Magic globals that are built-in or special
+MAGIC_GLOBALS = {
+    "__name__", "__doc__", "__package__", "__loader__", "__spec__", "__file__",
+    "__cached__", "__builtins__", "__annotations__", "__all__", "quit", "exit"
+}
+
+class StarImportVisitor(ast.NodeVisitor):
+    """AST visitor to find star imports and track used names."""
+    def __init__(self):
+        self.star_imports = []  # List of module names with star imports
+        self.used_names = set()  # Names used from star imports
+        self.current_star_imports = set()  # Modules with star imports in current scope
+        
+    def visit_ImportFrom(self, node):
+        # Check if this is a star import
+        if node.level > 0:
+            # Relative import
+            module_parts = []
+            if node.module:
+                module_parts.append(node.module)
+            module_name = "." * node.level + (node.module or "")
+        else:
+            # Absolute import
+            module_name = node.module or ""
+            
+        for alias in node.names:
+            if alias.name == "*":
+                self.star_imports.append(module_name)
+                self.current_star_imports.add(module_name)
+        self.generic_visit(node)
+    
+    def visit_Name(self, node):
+        # Track name usage
+        if isinstance(node.ctx, ast.Load):
+            self.used_names.add(node.id)
+        self.generic_visit(node)
+    
+    def visit_Attribute(self, node):
+        # For attribute access like module.name, we need to track the attribute name
+        # but only if it's from a star-imported module
+        self.generic_visit(node)
+
+
+def names_to_replace(tree):
+    """Get names that are used from star imports."""
+    visitor = StarImportVisitor()
+    visitor.visit(tree)
+    return visitor.used_names
+
+
+def star_imports(tree):
+    """Get list of modules that have star imports."""
+    visitor = StarImportVisitor()
+    visitor.visit(tree)
+    return visitor.star_imports
