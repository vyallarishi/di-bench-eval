+def get_html_element_for_code(state, element, html_element) -> HtmlElement:
+    result = CSS_PROFILES["strict"]["pre"].copy()
+    result.display = "inline"
+    return result
+
+
+def test_custom_html_tag_handling():
+    """Use Inscriptis to deal with (mostly Markdown) content that mixes
+    HTML tags and text.
+    """
+
+    # instruct Inscriptis to map the span.mark elements to the corresponding
+    # html element
+    parser_config = ParserConfig(css_weight=HTML_ATTRIBUTES)
+
+    parser_config.css["span"]["class"]["code"] = get_html_element_for_code
+
+    html_tree = fromstring(HTML)
+
+    # and render the HTML content accordingly
+    parser = Inscriptis(html_tree, parser_config)
+
+    result = parser.get_text()
+
+    assert "CSS for code span:" in result
+    assert "Use red for version control." in result
+    assert "Or gitlab for online collaboration." in result
