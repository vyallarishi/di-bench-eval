+class SchemaError(Exception):
+    """Validation error used instead of the `schema` library.
+
+    Tests and calling code previously used ``schema.SchemaError``.
+    Keep a compatible name and behavior but without the dependency.
+    """
+
+
+class _Missing:
+    pass
+
+
+_MISSING = _Missing()
+
+
+def _ensure_type(value: Any, expected, path: str) -> None:
+    if expected is Any:
+        return
+    if getattr(expected, "__origin__", None) is Union:
+        if not any(isinstance(value, t) for t in expected.__args__ if t is not type(None)):
+            raise SchemaError(f"{path} has invalid type")
+        return
+    if not isinstance(value, expected):
+        raise SchemaError(f"{path} has invalid type")
+
+
+def _require(obj: dict, key: str, expected, path: str):
+    value = obj.get(key, _MISSING)
+    if value is _MISSING:
+        raise SchemaError(f"missing key: {path}{key}")
+    _ensure_type(value, expected, f"{path}{key}")
+    return value
 
 
