+class TftpClient:
+    """
+    Minimal TFTP client implementation for downloading files
+    """
+    
+    # TFTP opcodes
+    OP_RRQ = 1  # Read request
+    OP_WRQ = 2  # Write request
+    OP_DATA = 3  # Data packet
+    OP_ACK = 4  # Acknowledgement
+    OP_ERROR = 5  # Error
+    
+    # TFTP error codes
+    ERR_NOT_DEFINED = 0
+    ERR_FILE_NOT_FOUND = 1
+    ERR_ACCESS_VIOLATION = 2
+    ERR_DISK_FULL = 3
+    ERR_ILLEGAL_OPERATION = 4
+    ERR_UNKNOWN_TID = 5
+    ERR_FILE_EXISTS = 6
+    ERR_NO_SUCH_USER = 7
+    
+    def __init__(self, host, port=69, timeout=5):
+        self.host = host
+        self.port = port
+        self.timeout = timeout
+        self.block_size = 512  # Standard TFTP block size
+        
+    def download(self, filename):
+        """
+        Download a file from the TFTP server
+        Returns the file content as bytes
+        """
+        # Create UDP socket
+        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        sock.settimeout(self.timeout)
+        
+        try:
+            # Send read request (RRQ)
+            rrq_packet = self._build_rrq(filename)
+            sock.sendto(rrq_packet, (self.host, self.port))
+            
+            # Get the server's response which will include a new port
+            data, server_addr = sock.recvfrom(516)  # Max TFTP packet size
+            
+            # Parse the response
+            opcode = struct.unpack('!H', data[:2])[0]
+            
+            if opcode == self.OP_ERROR:
+                error_code = struct.unpack('!H', data[2:4])[0]
+                error_msg = data[4:].decode('ascii', errors='ignore')
+                raise Exception(f"TFTP Error {error_code}: {error_msg}")
+            
+            elif opcode == self.OP_DATA:
+                # Extract block number and data
+                block_num = struct.unpack('!H', data[2:4])[0]
+                file_data = data[4:]
+                
+                # Send ACK for the first data packet
+                ack_packet = self._build_ack(block_num)
+                sock.sendto(ack_packet, server_addr)
+                
+                # Continue receiving data packets
+                while len(file_data) == self.block_size + 4:  # Header + data
+                    data, server_addr = sock.recvfrom(516)
+                    opcode = struct.unpack('!H', data[:2])[0]
+                    
+                    if opcode == self.OP_ERROR:
+                        error_code = struct.unpack('!H', data[2:4])[0]
+                        error_msg = data[4:].decode('ascii', errors='ignore')
+                        raise Exception(f"TFTP Error {error_code}: {error_msg}")
+                    
+                    elif opcode == self.OP_DATA:
+                        block_num = struct.unpack('!H', data[2:4])[0]
+                        file_data += data[4:]
+                        
+                        # Send ACK
+                        ack_packet = self._build_ack(block_num)
+                        sock.sendto(ack_packet, server_addr)
+                    else:
+                        raise Exception(f"Unexpected opcode: {opcode}")
+                
+                return file_data
+            else:
+                raise Exception(f"Unexpected opcode: {opcode}")
+                
+        finally:
+            sock.close()
+    
+    def _build_rrq(self, filename):
+        """Build a read request packet"""
+        # Format: opcode(2) + filename(0-terminated) + mode(0-terminated)
+        rrq = struct.pack('!H', self.OP_RRQ)
+        rrq += filename.encode('ascii') + b'\x00'
+        rrq += b'netascii' + b'\x00'  # Use netascii mode
+        return rrq
+    
+    def _build_ack(self, block_num):
+        """Build an acknowledgement packet"""
+        return struct.pack('!HH', self.OP_ACK, block_num)
 
 
