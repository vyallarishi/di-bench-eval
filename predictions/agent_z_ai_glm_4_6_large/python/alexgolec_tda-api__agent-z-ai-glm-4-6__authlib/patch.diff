 TOKEN_ENDPOINT = 'https://api.tdameritrade.com/v1/oauth2/token'
 
 
+class OAuth2Client:
+    """Simple OAuth2 client implementation using httpx."""
+    
+    def __init__(self, client_id, token=None, token_endpoint=None, 
+                 auto_refresh_url=None, auto_refresh_kwargs=None, 
+                 update_token=None):
+        self.client_id = client_id
+        self.token = token or {}
+        self.token_endpoint = token_endpoint or TOKEN_ENDPOINT
+        self.auto_refresh_url = auto_refresh_url
+        self.auto_refresh_kwargs = auto_refresh_kwargs or {}
+        self.update_token = update_token
+        self.session = httpx.Client()
+    
+    def fetch_token(self, token_endpoint, authorization_response=None, 
+                   access_type=None, client_id=None, include_client_id=None,
+                   redirect_uri=None, code=None, **kwargs):
+        """Fetch OAuth2 token."""
+        data = {
+            'grant_type': 'authorization_code',
+            'client_id': client_id or self.client_id,
+        }
+        
+        if authorization_response:
+            parsed = urllib.parse.urlparse(authorization_response)
+            query_params = urllib.parse.parse_qs(parsed.query)
+            if 'code' in query_params:
+                code = query_params['code'][0]
+        
+        if code:
+            data['code'] = code
+        
+        if redirect_uri:
+            data['redirect_uri'] = redirect_uri
+            
+        if access_type:
+            data['access_type'] = access_type
+            
+        response = self.session.post(token_endpoint or self.token_endpoint, data=data)
+        response.raise_for_status()
+        
+        token_data = response.json()
+        self.token.update(token_data)
+        return token_data
+    
+    def refresh_token(self, token_url=None, **kwargs):
+        """Refresh OAuth2 token."""
+        if not self.auto_refresh_url:
+            return self.token
+            
+        data = {
+            'grant_type': 'refresh_token',
+            'refresh_token': self.token.get('refresh_token'),
+            'client_id': self.auto_refresh_kwargs.get('client_id', self.client_id),
+        }
+        
+        response = self.session.post(self.auto_refresh_url, data=data)
+        response.raise_for_status()
+        
+        token_data = response.json()
+        self.token.update(token_data)
+        
+        if self.update_token:
+            self.update_token(token_data)
+            
+        return token_data
+
+
+class AsyncOAuth2Client:
+    """Async OAuth2 client implementation using httpx."""
+    
+    def __init__(self, client_id, token=None, token_endpoint=None, 
+                 auto_refresh_url=None, auto_refresh_kwargs=None, 
+                 update_token=None):
+        self.client_id = client_id
+        self.token = token or {}
+        self.token_endpoint = token_endpoint or TOKEN_ENDPOINT
+        self.auto_refresh_url = auto_refresh_url
+        self.auto_refresh_kwargs = auto_refresh_kwargs or {}
+        self.update_token = update_token
+        self.session = httpx.AsyncClient()
+    
+    async def fetch_token(self, token_endpoint, authorization_response=None, 
+                         access_type=None, client_id=None, include_client_id=None,
+                         redirect_uri=None, code=None, **kwargs):
+        """Fetch OAuth2 token asynchronously."""
+        data = {
+            'grant_type': 'authorization_code',
+            'client_id': client_id or self.client_id,
+        }
+        
+        if authorization_response:
+            parsed = urllib.parse.urlparse(authorization_response)
+            query_params = urllib.parse.parse_qs(parsed.query)
+            if 'code' in query_params:
+                code = query_params['code'][0]
+        
+        if code:
+            data['code'] = code
+        
+        if redirect_uri:
+            data['redirect_uri'] = redirect_uri
+            
+        if access_type:
+            data['access_type'] = access_type
+            
+        response = await self.session.post(token_endpoint or self.token_endpoint, data=data)
+        response.raise_for_status()
+        
+        token_data = response.json()
+        self.token.update(token_data)
+        return token_data
+    
+    async def refresh_token(self, token_url=None, **kwargs):
+        """Refresh OAuth2 token asynchronously."""
+        if not self.auto_refresh_url:
+            return self.token
+            
+        data = {
+            'grant_type': 'refresh_token',
+            'refresh_token': self.token.get('refresh_token'),
+            'client_id': self.auto_refresh_kwargs.get('client_id', self.client_id),
+        }
+        
+        response = await self.session.post(self.auto_refresh_url, data=data)
+        response.raise_for_status()
+        
+        token_data = response.json()
+        self.token.update(token_data)
+        
+        if self.update_token:
+            await self.update_token(token_data)
+            
+        return token_data
+
+
