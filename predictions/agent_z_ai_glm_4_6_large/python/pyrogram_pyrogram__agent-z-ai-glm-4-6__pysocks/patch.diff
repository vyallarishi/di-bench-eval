+
+import asyncio
+import ipaddress
+import logging
+import socket
+import struct
+from concurrent.futures import ThreadPoolExecutor
+from urllib.parse import urlparse
+
+log = logging.getLogger(__name__)
+
+class TCP:
+    TIMEOUT = 10
+
+    def __init__(self, ipv6: bool, proxy: dict):
+        self.socket = None
+
+        self.reader = None
+        self.writer = None
+
+        self.lock = asyncio.Lock()
+        self.loop = asyncio.get_event_loop()
+
+        self.proxy = proxy
+
+        if proxy:
+            hostname = proxy.get("hostname")
+            scheme = proxy.get("scheme", "").lower()
+            
+            try:
+                ip_address = ipaddress.ip_address(hostname)
+                is_ip = True
+            except ValueError:
+                is_ip = False
+
+            # Create standard socket
+            if is_ip and isinstance(ip_address, ipaddress.IPv6Address):
+                self.socket = socket.socket(socket.AF_INET6)
+            else:
+                self.socket = socket.socket(socket.AF_INET)
+
+            # Set up proxy using HTTP CONNECT method for HTTP proxies
+            if scheme in ("http", "https"):
+                self.socket.setblocking(True)
+                self.socket.settimeout(TCP.TIMEOUT)
+                
+                # Connect to proxy
+                proxy_addr = (hostname, proxy.get("port", 8080))
+                self.socket.connect(proxy_addr)
+                
+                # Send CONNECT request
+                target_host, target_port = None, None  # Will be set in connect()
+                
+                username = proxy.get("username")
+                password = proxy.get("password")
+                
+                # Store proxy info for connect() method
+                self._proxy_info = {
+                    "scheme": scheme,
+                    "username": username,
+                    "password": password
+                }
+                
+                log.info("Using HTTP proxy %s", hostname)
+            elif scheme == "socks4":
+                # SOCKS4 proxy support
+                self.socket.setblocking(True)
+                self.socket.settimeout(TCP.TIMEOUT)
+                
+                proxy_addr = (hostname, proxy.get("port", 1080))
+                self.socket.connect(proxy_addr)
+                
+                # Store proxy info for connect() method
+                self._proxy_info = {
+                    "scheme": scheme,
+                    "username": proxy.get("username", ""),
+                    "proxy_addr": proxy_addr
+                }
+                
+                log.info("Using SOCKS4 proxy %s", hostname)
+            elif scheme == "socks5":
+                # SOCKS5 proxy support
+                self.socket.setblocking(True)
+                self.socket.settimeout(TCP.TIMEOUT)
+                
+                proxy_addr = (hostname, proxy.get("port", 1080))
+                self.socket.connect(proxy_addr)
+                
+                # Store proxy info for connect() method
+                self._proxy_info = {
+                    "scheme": scheme,
+                    "username": proxy.get("username"),
+                    "password": proxy.get("password"),
+                    "proxy_addr": proxy_addr
+                }
+                
+                log.info("Using SOCKS5 proxy %s", hostname)
+            else:
+                raise ValueError(f"Unsupported proxy scheme: {scheme}")
+        else:
+            self.socket = socket.socket(
+                socket.AF_INET6 if ipv6
+                else socket.AF_INET
+            )
+
+            self.socket.setblocking(False)
+
+    async def connect(self, address: tuple):
+        if self.proxy:
+            target_host, target_port = address
+            scheme = self._proxy_info["scheme"]
+            
+            if scheme in ("http", "https"):
+                # Send CONNECT request
+                connect_request = f"CONNECT {target_host}:{target_port} HTTP/1.1\r\nHost: {target_host}:{target_port}\r\n"
+                
+                username = self._proxy_info.get("username")
+                password = self._proxy_info.get("password")
+                
+                if username and password:
+                    import base64
+                    credentials = f"{username}:{password}"
+                    encoded_credentials = base64.b64encode(credentials.encode()).decode()
+                    connect_request += f"Proxy-Authorization: Basic {encoded_credentials}\r\n"
+                
+                connect_request += "\r\n"
+                self.socket.send(connect_request.encode())
+                
+                # Read response
+                response = self.socket.recv(4096).decode()
+                if not response.startswith("HTTP/1.1 200") and not response.startswith("HTTP/1.0 200"):
+                    raise OSError(f"Proxy connection failed: {response}")
+                
+                self.socket.setblocking(False)
+            elif scheme == "socks4":
+                # SOCKS4 connect request
+                try:
+                    target_ip = ipaddress.ip_address(target_host)
+                    if isinstance(target_ip, ipaddress.IPv6Address):
+                        raise ValueError("SOCKS4 does not support IPv6")
+                    dest_addr = socket.inet_aton(target_host)
+                except ValueError:
+                    # SOCKS4a for domain names
+                    dest_addr = socket.inet_aton("0.0.0.0")
+                
+                username = self._proxy_info.get("username", "") or "\x00"
+                
+                # SOCKS4 connect request
+                request = struct.pack("!HH", 4, 1) + dest_addr + struct.pack("!H", target_port) + username.encode() + b"\x00"
+                
+                if dest_addr == socket.inet_aton("0.0.0.0"):
+                    # SOCKS4a - append domain name
+                    request += target_host.encode() + b"\x00"
+                
+                self.socket.send(request)
+                response = self.socket.recv(8)
+                
+                if len(response) != 8 or response[0] != 0 or response[1] != 0x5a:
+                    raise OSError(f"SOCKS4 connection failed: {response}")
+                
+                self.socket.setblocking(False)
+            elif scheme == "socks5":
+                # SOCKS5 authentication
+                username = self._proxy_info.get("username")
+                password = self._proxy_info.get("password")
+                
+                if username and password:
+                    # Username/password authentication
+                    self.socket.send(b"\x05\x02\x00\x02")
+                    auth_method = self.socket.recv(2)
+                    if auth_method != b"\x05\x02":
+                        raise OSError("SOCKS5 authentication method not supported")
+                    
+                    # Send credentials
+                    cred_request = b"\x01" + bytes([len(username)]) + username.encode() + bytes([len(password)]) + password.encode()
+                    self.socket.send(cred_request)
+                    auth_response = self.socket.recv(2)
+                    if auth_response != b"\x01\x00":
+                        raise OSError("SOCKS5 authentication failed")
+                else:
+                    # No authentication
+                    self.socket.send(b"\x05\x01\x00")
+                    auth_method = self.socket.recv(2)
+                    if auth_method != b"\x05\x00":
+                        raise OSError("SOCKS5 no authentication method not supported")
+                
+                # SOCKS5 connect request
+                try:
+                    target_ip = ipaddress.ip_address(target_host)
+                    if isinstance(target_ip, ipaddress.IPv4Address):
+                        addr_type = 1
+                        addr_bytes = socket.inet_aton(target_host)
+                    else:  # IPv6
+                        addr_type = 4
+                        addr_bytes = socket.inet_pton(socket.AF_INET6, target_host)
+                except ValueError:
+                    # Domain name
+                    addr_type = 3
+                    addr_bytes = bytes([len(target_host)]) + target_host.encode()
+                
+                connect_request = b"\x05\x01\x00" + bytes([addr_type]) + addr_bytes + struct.pack("!H", target_port)
+                self.socket.send(connect_request)
+                
+                # Read response
+                response = self.socket.recv(10)
+                if len(response) < 2 or response[0] != 5 or response[1] != 0:
+                    raise OSError(f"SOCKS5 connection failed: {response}")
+                
+                # Read additional bytes for domain name responses
+                if response[3] == 3:
+                    domain_len = response[4]
+                    self.socket.recv(domain_len + 2)
+                elif response[3] == 4:
+                    self.socket.recv(2)
+                
+                self.socket.setblocking(False)
+        else:
+            try:
+                await asyncio.wait_for(asyncio.get_event_loop().sock_connect(self.socket, address), TCP.TIMEOUT)
+            except asyncio.TimeoutError:  # Re-raise as TimeoutError. asyncio.TimeoutError is deprecated in 3.11
+                raise TimeoutError("Connection timed out")
+
+        self.reader, self.writer = await asyncio.open_connection(sock=self.socket)
+
+    async def close(self):
+        try:
+            if self.writer is not None:
+                self.writer.close()
+                await asyncio.wait_for(self.writer.wait_closed(), TCP.TIMEOUT)
+        except Exception as e:
+            log.info("Close exception: %s %s", type(e).__name__, e)
+
+    async def send(self, data: bytes):
+        async with self.lock:
+            try:
+                if self.writer is not None:
+                    self.writer.write(data)
+                    await self.writer.drain()
+            except Exception as e:
+                log.info("Send exception: %s %s", type(e).__name__, e)
+                raise OSError(e)
+
+    async def recv(self, length: int = 0):
+        data = b""
+
+        while len(data) < length:
+            try:
+                chunk = await asyncio.wait_for(
+                    self.reader.read(length - len(data)),
+                    TCP.TIMEOUT
+                )
+            except (OSError, asyncio.TimeoutError):
+                return None
+            else:
+                if chunk:
+                    data += chunk
+                else:
+                    return None
+
+        return data
