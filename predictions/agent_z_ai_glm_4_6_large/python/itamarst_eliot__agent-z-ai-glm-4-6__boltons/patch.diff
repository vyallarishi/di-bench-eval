+"""
+Utility functions for parsing log entries.
+"""
+
+from ._util import saferepr
+
+
+def _extract_field(message, field_name, required=False):
+    """
+    Extract a field from a parsed message.
+
+    @param message: A dictionary representing a parsed log entry.
+    @param field_name: The name of the field to extract.
+    @param required: If True, raise KeyError if the field is missing.
+    @return: The field value or None if not found and not required.
+    """
+    if field_name in message:
+        return message[field_name]
+    elif required:
+        raise KeyError(f"Required field '{field_name}' not found in message")
+    else:
+        return None
