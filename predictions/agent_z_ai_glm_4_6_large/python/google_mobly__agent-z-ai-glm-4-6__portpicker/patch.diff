+_REAL_SELF = {os.path.realpath(p) for p in _SELF}
+_VENV = ("/.venv/", "/venv/", "/.tox/", "/.nox/", "/.eggs/", "/node_modules/", "/.git/")
+_STDLIB = os.path.dirname(os.__file__)
+_MARK = "(blocked: dependency %s was removed)" % _DEP
+_cache = {}
