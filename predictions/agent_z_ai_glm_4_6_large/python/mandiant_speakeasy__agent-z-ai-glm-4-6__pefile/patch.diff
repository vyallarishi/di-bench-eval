+    def _get_memory_mapped_image(self):
+        """Create memory mapped image"""
+        image_size = self.OPTIONAL_HEADER.SizeOfImage
+        mapped = bytearray(image_size)
+        
+        # Copy headers
+        header_size = self.OPTIONAL_HEADER.SizeOfHeaders
+        mapped[:header_size] = self.__data__[:header_size]
+        
+        # Copy sections
+        for section in self.sections:
+            if section.PointerToRawData > 0 and section.SizeOfRawData > 0:
+                src_start = section.PointerToRawData
+                src_end = min(src_start + section.SizeOfRawData, len(self.__data__))
+                dst_start = section.VirtualAddress
+                dst_end = dst_start + (src_end - src_start)
+                
+                if dst_end <= len(mapped):
+                    mapped[dst_start:dst_end] = self.__data__[src_start:src_end]
+        
+        return bytes(mapped)
