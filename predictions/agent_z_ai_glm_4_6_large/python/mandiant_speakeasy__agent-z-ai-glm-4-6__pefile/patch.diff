+        self.FILE_HEADER.NumberOfSections = int.from_bytes(self.__data__[fh_offset+2:fh_offset+4], 'little')
+        self.FILE_HEADER.TimeDateStamp = int.from_bytes(self.__data__[fh_offset+4:fh_offset+8], 'little')
+        self.FILE_HEADER.PointerToSymbolTable = int.from_bytes(self.__data__[fh_offset+8:fh_offset+12], 'little')
