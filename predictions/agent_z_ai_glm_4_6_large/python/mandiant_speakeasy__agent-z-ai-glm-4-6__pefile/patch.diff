+        self.FILE_HEADER.SizeOfOptionalHeader = int.from_bytes(self.__data__[fh_offset+16:fh_offset+18], 'little')
+        self.FILE_HEADER.Characteristics = int.from_bytes(self.__data__[fh_offset+18:fh_offset+20], 'little')
