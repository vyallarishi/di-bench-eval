+class OAuth1:
+    """OAuth 1.0a authentication for requests"""
+    
+    def __init__(self, client_key, client_secret=None, resource_owner_key=None,
+                 resource_owner_secret=None, signature_method='HMAC-SHA1',
+                 signature_type='auth_header', callback_uri=None, verifier=None,
+                 decoding='utf-8', realm=None, client=None, resource_owner=None):
+        self.client_key = client_key
+        self.client_secret = client_secret
+        self.resource_owner_key = resource_owner_key
+        self.resource_owner_secret = resource_owner_secret
+        self.signature_method = signature_method
+        self.signature_type = signature_type
+        self.callback_uri = callback_uri
+        self.verifier = verifier
+        self.decoding = decoding
+        self.realm = realm
+        self.client = client
+        self.resource_owner = resource_owner
+    
+    def __call__(self, r):
+        if self.signature_type == 'auth_header':
+            r.headers['Authorization'] = self.generate_authorization_header(r)
+        elif self.signature_type == 'query':
+            r.url = self.add_signature_to_url(r.url, r.body)
+        return r
+    
+    def generate_authorization_header(self, request):
+        oauth_params = self._get_oauth_params(request)
+        auth_header = 'OAuth ' + ', '.join(
+            f'{quote(k)}="{quote(v)}"' for k, v in oauth_params.items()
+        )
+        return auth_header
+    
+    def _get_oauth_params(self, request):
+        params = {
+            'oauth_consumer_key': self.client_key,
+            'oauth_nonce': self._generate_nonce(),
+            'oauth_signature_method': self.signature_method,
+            'oauth_timestamp': str(int(time.time())),
+            'oauth_version': '1.0',
+        }
+        
+        if self.resource_owner_key:
+            params['oauth_token'] = self.resource_owner_key
+        if self.callback_uri:
+            params['oauth_callback'] = self.callback_uri
+        if self.verifier:
+            params['oauth_verifier'] = self.verifier
+        if self.realm:
+            params['realm'] = self.realm
+            
+        # Generate signature
+        base_string = self._generate_base_string(request, params)
+        params['oauth_signature'] = self._generate_signature(base_string)
+        
+        return params
+    
+    def _generate_nonce(self):
+        return base64.b64encode(hashlib.sha1(str(time.time()).encode()).digest()).decode()
+    
+    def _generate_base_string(self, request, params):
+        method = request.method.upper()
+        url = request.url.split('?')[0]
+        
+        # Collect all parameters
+        all_params = params.copy()
+        if request.body:
+            body_params = urllib.parse.parse_qs(request.body)
+            for k, v in body_params.items():
+                all_params[k] = v[0] if v else ''
+        
+        # Sort parameters
+        sorted_params = sorted(all_params.items())
+        
+        # Create parameter string
+        param_string = '&'.join(f'{quote(k)}={quote(v)}' for k, v in sorted_params)
+        
+        # Create base string
+        base_string = f'{quote(method)}&{quote(url)}&{quote(param_string)}'
+        
+        return base_string
+    
+    def _generate_signature(self, base_string):
+        key = f'{quote(self.client_secret or "")}&{quote(self.resource_owner_secret or "")}'
+        hashed = hmac.new(key.encode(), base_string.encode(), hashlib.sha1)
+        return base64.b64encode(hashed.digest()).decode()
+
+
+def quote(s):
+    if isinstance(s, bytes):
+        s = s.decode('utf-8')
+    return urllib.parse.quote(s, safe='')
+
