diff --git a/streamparse/pystorm_replacements.py b/streamparse/pystorm_replacements.py
new file mode 100644
index 0000000..8ac809b
--- /dev/null
+++ b/streamparse/pystorm_replacements.py
@@ -0,0 +1,113 @@
+"""
+Replacements for pystorm classes to remove dependency on pystorm package.
+These provide the minimal interface needed by streamparse.
+"""
+
+import json
+import sys
+from typing import Any, Dict, List, Optional
+
+
+class Tuple:
+    """Replacement for pystorm.Tuple"""
+    
+    def __init__(self, task_id: int, values: List[Any], stream: str = 'default', 
+                 component: str = '', task: int = 0):
+        self.task = task
+        self.component = component
+        self.stream = stream
+        self.task_id = task_id
+        self.values = values
+    
+    def __repr__(self) -> str:
+        return f"Tuple(values={self.values}, stream={self.stream}, component={self.component})"
+
+
+class Component:
+    """Base replacement for pystorm.component.Component"""
+    
+    def __init__(self):
+        self._context = None
+        self._pending_commands = []
+        self._topology_config = {}
+    
+    def initialize(self, storm_conf, context):
+        """Initialize the component with Storm configuration and context"""
+        self._topology_config = storm_conf
+        self._context = context
+    
+    @property
+    def context(self):
+        return self._context
+    
+    def read_handshake(self):
+        """Read handshake from stdin"""
+        return json.loads(sys.stdin.readline())
+    
+    def read_message(self):
+        """Read message from stdin"""
+        return json.loads(sys.stdin.readline())
+    
+    def send_message(self, message: Dict[str, Any]):
+        """Send message to stdout"""
+        self._pending_commands.append(message)
+    
+    def sync(self):
+        """Sync pending commands"""
+        for command in self._pending_commands:
+            json.dump(command, sys.stdout)
+            sys.stdout.write('\n')
+            sys.stdout.flush()
+        self._pending_commands = []
+
+
+class StormHandler:
+    """Replacement for pystorm.component.StormHandler"""
+    
+    def __init__(self, component):
+        self.component = component
+        self._running = False
+    
+    def run(self):
+        """Main run loop"""
+        self._running = True
+        handshake = self.component.read_handshake()
+        self.component.initialize(handshake.get('conf', {}), handshake.get('context', {}))
+        
+        # Send initial sync
+        self.component.sync()
+        
+        while self._running:
+            try:
+                message = self.component.read_message()
+                command = message.get('command')
+                
+                if command == 'heartbeat':
+                    self.component.send_message({'command': 'sync'})
+                elif command == 'tuple':
+                    # Handle tuple message
+                    tuple_data = message.get('tuple', [])
+                    stream = message.get('stream', 'default')
+                    component = message.get('component', '')
+                    task = message.get('task', 0)
+                    task_id = message.get('id')
+                    
+                    tup = Tuple(task_id, tuple_data, stream, component, task)
+                    self.component.process(tup)
+                elif command == 'shutdown':
+                    self._running = False
+                    break
+                
+                self.component.sync()
+                
+            except (EOFError, KeyboardInterrupt):
+                break
+
+
+# Serializers
+_SERIALIZERS = {
+    'json': json,
+    'str': str,
+    'int': int,
+    'float': float,
+}
