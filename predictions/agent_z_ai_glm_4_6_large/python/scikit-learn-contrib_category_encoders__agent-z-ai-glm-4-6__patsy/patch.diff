+"""Utilities for contrast coding without patsy dependency"""
+import numpy as np
+
+
+class ContrastMatrix:
+    """Simple replacement for patsy.contrasts.ContrastMatrix"""
+    def __init__(self, matrix, column_suffixes):
+        self.matrix = matrix
+        self.column_suffixes = column_suffixes
+
+
+def helmert_contrast(levels):
+    """Generate Helmert contrast coding matrix"""
+    n = len(levels)
+    if n < 2:
+        return ContrastMatrix(np.empty((n, 0)), [])
+    
+    matrix = np.zeros((n, n - 1))
+    for i in range(1, n):
+        matrix[:i, i-1] = 1
+        matrix[i, i-1] = -i
+    
+    column_suffixes = [str(i) for i in range(n - 1)]
+    return ContrastMatrix(matrix, column_suffixes)
+
+
+def backward_difference_contrast(levels):
+    """Generate backward difference contrast coding matrix"""
+    n = len(levels)
+    if n < 2:
+        return ContrastMatrix(np.empty((n, 0)), [])
+    
+    matrix = np.zeros((n, n - 1))
+    for i in range(n - 1):
+        matrix[i, i] = 1
+        matrix[i+1, i] = -1
+    
+    column_suffixes = [str(i) for i in range(n - 1)]
+    return ContrastMatrix(matrix, column_suffixes)
+
+
+def sum_contrast(levels):
+    """Generate sum contrast coding matrix"""
+    n = len(levels)
+    if n < 2:
+        return ContrastMatrix(np.empty((n, 0)), [])
+    
+    matrix = np.zeros((n, n - 1))
+    for i in range(n - 1):
+        matrix[i, i] = 1
+        matrix[n-1, i] = -1
+    
+    column_suffixes = [str(i) for i in range(n - 1)]
+    return ContrastMatrix(matrix, column_suffixes)
+
+
+def polynomial_contrast(levels):
+    """Generate polynomial contrast coding matrix"""
+    n = len(levels)
+    if n < 2:
+        return ContrastMatrix(np.empty((n, 0)), [])
+    
+    # Create orthogonal polynomial contrasts
+    matrix = np.zeros((n, n - 1))
+    for degree in range(n - 1):
+        # Use simple polynomial basis
+        for i, level in enumerate(levels):
+            matrix[i, degree] = (level - np.mean(levels)) ** degree
+    
+    # Apply Gram-Schmidt to make orthogonal
+    for col in range(n - 1):
+        for prev_col in range(col):
+            dot_product = np.dot(matrix[:, col], matrix[:, prev_col])
+            norm_squared = np.dot(matrix[:, prev_col], matrix[:, prev_col])
+            if norm_squared > 0:
+                matrix[:, col] -= (dot_product / norm_squared) * matrix[:, prev_col]
+        
+        # Normalize
+        norm = np.linalg.norm(matrix[:, col])
+        if norm > 0:
+            matrix[:, col] /= norm
+    
+    column_suffixes = [str(i) for i in range(n - 1)]
+    return ContrastMatrix(matrix, column_suffixes)
