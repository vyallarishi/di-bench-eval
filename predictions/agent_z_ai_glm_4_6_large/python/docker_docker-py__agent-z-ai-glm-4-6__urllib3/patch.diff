+# Simple LRU cache implementation to replace urllib3._collections.RecentlyUsedContainer
+class RecentlyUsedContainer:
+    def __init__(self, maxsize, dispose_func=None):
+        self.maxsize = maxsize
+        self.dispose_func = dispose_func
+        self.cache = {}
+        self.lock = type('Lock', (), {'__enter__': lambda self: None, '__exit__': lambda self, *args: None})()
+    
+    def get(self, key):
+        return self.cache.get(key)
+    
+    def __setitem__(self, key, value):
+        if len(self.cache) >= self.maxsize:
+            # Remove oldest item (simple FIFO)
+            oldest_key = next(iter(self.cache))
+            old_value = self.cache.pop(oldest_key)
+            if self.dispose_func:
+                self.dispose_func(old_value)
+        self.cache[key] = value
 
