+# Simple replacement for jmp.Policy
+class Policy:
+  """Replacement for jmp.Policy with minimal interface."""
+  
+  def __init__(self, compute_dtype, param_dtype, output_dtype):
+    self.compute_dtype = compute_dtype
+    self.param_dtype = param_dtype
+    self.output_dtype = output_dtype
+  
+  def cast_to_compute(self, x):
+    """Cast inputs to compute dtype."""
+    return jax.tree_util.tree_map(lambda v: v.astype(self.compute_dtype) if hasattr(v, 'astype') else v, x)
+  
+  def cast_to_output(self, x):
+    """Cast outputs to output dtype."""
+    return jax.tree_util.tree_map(lambda v: v.astype(self.output_dtype) if hasattr(v, 'astype') else v, x)
+
+
+def get_policy(policy_str: str) -> Policy:
+  """Parse a policy string and return a Policy object.
+  
+  Args:
+    policy_str: String like 'params=float32,compute=float16,output=float32'
+                or 'p=f32,c=f16,o=f32'
+  
+  Returns:
+    A Policy object.
+  """
+  # Default values
+  param_dtype = jnp.float32
+  compute_dtype = jnp.float32
+  output_dtype = jnp.float32
+  
+  # Parse the policy string
+  parts = policy_str.split(',')
+  for part in parts:
+    if '=' not in part:
+      continue
+    key, value = part.split('=', 1)
+    key = key.strip()
+    value = value.strip()
+    
+    if key in ('params', 'p'):
+      if value == 'f32' or value == 'float32':
+        param_dtype = jnp.float32
+      elif value == 'f16' or value == 'float16':
+        param_dtype = jnp.float16
+      elif value == 'bf16' or value == 'bfloat16':
+        param_dtype = jnp.bfloat16
+    elif key in ('compute', 'c'):
+      if value == 'f32' or value == 'float32':
+        compute_dtype = jnp.float32
+      elif value == 'f16' or value == 'float16':
+        compute_dtype = jnp.float16
+      elif value == 'bf16' or value == 'bfloat16':
+        compute_dtype = jnp.bfloat16
+    elif key in ('output', 'o'):
+      if value == 'f32' or value == 'float32':
+        output_dtype = jnp.float32
+      elif value == 'f16' or value == 'float16':
+        output_dtype = jnp.float16
+      elif value == 'bf16' or value == 'bfloat16':
+        output_dtype = jnp.bfloat16
+  
+  return Policy(compute_dtype, param_dtype, output_dtype)
 
