+class BidirectionalDict:
+    """A simple bidirectional dictionary implementation."""
+    
+    def __init__(self):
+        self._forward = {}
+        self._inverse = {}
+    
+    def __setitem__(self, key, value):
+        # Remove existing mappings if any
+        if key in self._forward:
+            old_value = self._forward[key]
+            del self._inverse[old_value]
+        if value in self._inverse:
+            old_key = self._inverse[value]
+            del self._forward[old_key]
+        
+        self._forward[key] = value
+        self._inverse[value] = key
+    
+    def __getitem__(self, key):
+        return self._forward[key]
+    
+    def __delitem__(self, key):
+        if key not in self._forward:
+            raise KeyError(key)
+        value = self._forward[key]
+        del self._forward[key]
+        del self._inverse[value]
+    
+    def __contains__(self, key):
+        return key in self._forward
+    
+    def get(self, key, default=None):
+        return self._forward.get(key, default)
+    
+    def copy(self):
+        result = BidirectionalDict()
+        result._forward = self._forward.copy()
+        result._inverse = self._inverse.copy()
+        return result
+    
+    def __len__(self):
+        return len(self._forward)
+    
+    def items(self):
+        return self._forward.items()
+    
+    @property
+    def _fwdm(self):
+        """Forward mapping - for compatibility with bidict"""
+        return self._forward
+    
+    @property
+    def _invm(self):
+        """Inverse mapping - for compatibility with bidict"""
+        return self._inverse
+
+
