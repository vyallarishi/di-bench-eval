diff --git a/src/_forward_flask.py b/src/_forward_flask.py
new file mode 100644
index 0000000..ae99e6a
--- /dev/null
+++ b/src/_forward_flask.py
@@ -0,0 +1,32 @@
+"""Forwarding shim for flask: every call reaches the library."""
+import flask as _lib
+
+Blueprint = getattr(_lib, 'Blueprint', None)
+Flask = getattr(_lib, 'Flask', None)
+MethodView = getattr(_lib, 'MethodView', None)
+Response = getattr(_lib, 'Response', None)
+__init__ = getattr(_lib, '__init__', None)
+abort = getattr(_lib, 'abort', None)
+add_url_rule = getattr(_lib, 'add_url_rule', None)
+app_context = getattr(_lib, 'app_context', None)
+as_view = getattr(_lib, 'as_view', None)
+before_request = getattr(_lib, 'before_request', None)
+current_app = getattr(_lib, 'current_app', None)
+dumps = getattr(_lib, 'dumps', None)
+errorhandler = getattr(_lib, 'errorhandler', None)
+from_object = getattr(_lib, 'from_object', None)
+g = getattr(_lib, 'g', None)
+get = getattr(_lib, 'get', None)
+jsonify = getattr(_lib, 'jsonify', None)
+make_response = getattr(_lib, 'make_response', None)
+redirect = getattr(_lib, 'redirect', None)
+register_blueprint = getattr(_lib, 'register_blueprint', None)
+render_template = getattr(_lib, 'render_template', None)
+request = getattr(_lib, 'request', None)
+send_from_directory = getattr(_lib, 'send_from_directory', None)
+session = getattr(_lib, 'session', None)
+stream_with_context = getattr(_lib, 'stream_with_context', None)
+test_client = getattr(_lib, 'test_client', None)
+test_request_context = getattr(_lib, 'test_request_context', None)
+url_for = getattr(_lib, 'url_for', None)
+wsgi_app = getattr(_lib, 'wsgi_app', None)
