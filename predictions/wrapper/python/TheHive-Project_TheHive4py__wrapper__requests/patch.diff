+__init__ = getattr(_lib, '__init__', None)
+get = getattr(_lib, 'get', None)
+iter_content = getattr(_lib, 'iter_content', None)
+json = getattr(_lib, 'json', None)
+mount = getattr(_lib, 'mount', None)
+request = getattr(_lib, 'request', None)
