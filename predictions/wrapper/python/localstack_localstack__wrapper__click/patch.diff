@@ -0,0 +1,14 @@
+"""Forwarding shim for click: every call reaches the library."""
+import click as _lib
+
+ClickException = getattr(_lib, 'ClickException', None)
+__init__ = getattr(_lib, '__init__', None)
+argument = getattr(_lib, 'argument', None)
+command = getattr(_lib, 'command', None)
+echo = getattr(_lib, 'echo', None)
+get_text_stderr = getattr(_lib, 'get_text_stderr', None)
+group = getattr(_lib, 'group', None)
+invoke = getattr(_lib, 'invoke', None)
+option = getattr(_lib, 'option', None)
+pass_context = getattr(_lib, 'pass_context', None)
+version_option = getattr(_lib, 'version_option', None)
