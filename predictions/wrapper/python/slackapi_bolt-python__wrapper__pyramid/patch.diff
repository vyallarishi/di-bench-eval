diff --git a/examples/_forward_pyramid.py b/examples/_forward_pyramid.py
new file mode 100644
index 0000000..cb26db7
--- /dev/null
+++ b/examples/_forward_pyramid.py
@@ -0,0 +1,9 @@
+"""Forwarding shim for pyramid: every call reaches the library."""
+import pyramid as _lib
+
+Configurator = getattr(_lib, 'Configurator', None)
+Request = getattr(_lib, 'Request', None)
+Response = getattr(_lib, 'Response', None)
+__init__ = getattr(_lib, '__init__', None)
+setUp = getattr(_lib, 'setUp', None)
+tearDown = getattr(_lib, 'tearDown', None)
