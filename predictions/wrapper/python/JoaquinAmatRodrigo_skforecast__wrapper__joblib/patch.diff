new file mode 100644
index 0000000..b59db59
--- /dev/null
+++ b/skforecast/_forward_joblib.py
@@ -0,0 +1,11 @@
+"""Forwarding shim for joblib: every call reaches the library."""
+import joblib as _lib
+
+Parallel = getattr(_lib, 'Parallel', None)
+__call__ = getattr(_lib, '__call__', None)
+__init__ = getattr(_lib, '__init__', None)
+cpu_count = getattr(_lib, 'cpu_count', None)
+delayed = getattr(_lib, 'delayed', None)
+dump = getattr(_lib, 'dump', None)
+hash = getattr(_lib, 'hash', None)
+load = getattr(_lib, 'load', None)
