index 0000000..d2f7936
--- /dev/null
+++ b/examples/_forward_falcon.py
@@ -0,0 +1,15 @@
+"""Forwarding shim for falcon: every call reaches the library."""
+import falcon as _lib
+
+Lock = getattr(_lib, 'Lock', None)
+Request = getattr(_lib, 'Request', None)
+Response = getattr(_lib, 'Response', None)
+__init__ = getattr(_lib, '__init__', None)
+add_route = getattr(_lib, 'add_route', None)
+create_default_options = getattr(_lib, 'create_default_options', None)
+create_method_not_allowed = getattr(_lib, 'create_method_not_allowed', None)
+iscoroutinefunction = getattr(_lib, 'iscoroutinefunction', None)
+simulate_get = getattr(_lib, 'simulate_get', None)
+simulate_post = getattr(_lib, 'simulate_post', None)
+update_wrapper = getattr(_lib, 'update_wrapper', None)
+version = getattr(_lib, 'version', None)
