index 0000000..5ebed19
--- /dev/null
+++ b/tzlocal/_forward_backports_zoneinfo.py
@@ -0,0 +1,7 @@
+"""Forwarding shim for backports_zoneinfo: every call reaches the library."""
+import backports as _lib
+
+find_tzfile = getattr(_lib, 'find_tzfile', None)
