--- /dev/null
+++ b/wikitextparser/_forward_regex.py
@@ -0,0 +1,16 @@
+"""Forwarding shim for regex: every call reaches the library."""
+import regex as _lib
+
+DOTALL = getattr(_lib, 'DOTALL', None)
+IGNORECASE = getattr(_lib, 'IGNORECASE', None)
+MULTILINE = getattr(_lib, 'MULTILINE', None)
+Match = getattr(_lib, 'Match', None)
+REVERSE = getattr(_lib, 'REVERSE', None)
+VERBOSE = getattr(_lib, 'VERBOSE', None)
+compile = getattr(_lib, 'compile', None)
+escape = getattr(_lib, 'escape', None)
+findall = getattr(_lib, 'findall', None)
+finditer = getattr(_lib, 'finditer', None)
+fullmatch = getattr(_lib, 'fullmatch', None)
+match = getattr(_lib, 'match', None)
+search = getattr(_lib, 'search', None)
