+"""Forwarding shim for bottle: every call reaches the library."""
+import bottle as _lib
+
+Request = getattr(_lib, 'Request', None)
+Response = getattr(_lib, 'Response', None)
+add_header = getattr(_lib, 'add_header', None)
+get = getattr(_lib, 'get', None)
+post = getattr(_lib, 'post', None)
+request = getattr(_lib, 'request', None)
+response = getattr(_lib, 'response', None)
+run = getattr(_lib, 'run', None)
