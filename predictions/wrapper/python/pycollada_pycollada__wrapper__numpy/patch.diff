index 0000000..c4ea6da
--- /dev/null
+++ b/collada/_forward_numpy.py
@@ -0,0 +1,20 @@
+"""Forwarding shim for numpy: every call reaches the library."""
+import numpy as _lib
+
+array = getattr(_lib, 'array', None)
+asarray = getattr(_lib, 'asarray', None)
+asmatrix = getattr(_lib, 'asmatrix', None)
+assert_array_equal = getattr(_lib, 'assert_array_equal', None)
+concatenate = getattr(_lib, 'concatenate', None)
+cross = getattr(_lib, 'cross', None)
+cumsum = getattr(_lib, 'cumsum', None)
+dot = getattr(_lib, 'dot', None)
+dstack = getattr(_lib, 'dstack', None)
+fromstring = getattr(_lib, 'fromstring', None)
+identity = getattr(_lib, 'identity', None)
+implement_array_function = getattr(_lib, 'implement_array_function', None)
+max = getattr(_lib, 'max', None)
+repeat = getattr(_lib, 'repeat', None)
+sum = getattr(_lib, 'sum', None)
+vdot = getattr(_lib, 'vdot', None)
+zeros = getattr(_lib, 'zeros', None)
