new file mode 100644
index 0000000..a84ef32
--- /dev/null
+++ b/tests/test_wcwidth.py
@@ -0,0 +1,27 @@
+from wikitextparser._wcwidth import wcswidth, wcwidth
+
+
+def test_ascii_and_arabic_count_one_per_letter():
+    assert wcswidth('Shopping List') == 13
+    assert wcswidth('\u0627\u0644\u0641') == 3
+
+
+def test_zero_width_characters():
+    assert (
+        wcswidth('\u0646\u06cc\u0645\u200c\u0641\u0627\u0635\u0644\u0647') == 8
+    )
+    assert wcwidth('\u0301') == 0  # combining acute
+    assert wcwidth('\u200b') == 0  # zero-width space
+    assert wcwidth('\u1160') == 0  # Hangul jungseong filler
+
+
+def test_wide_characters():
+    assert wcswidth('\u3042') == 2
+    assert wcswidth('\u6f22\u5b57') == 4
+    assert wcwidth('\uff21') == 2  # fullwidth A
+
+
+def test_control_characters_are_not_printable():
+    assert wcswidth('a\tb') == -1
+    assert wcwidth('\x00') == 0
+    assert wcwidth('\xad') == 1  # soft hyphen is visible
