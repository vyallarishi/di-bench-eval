index 0000000..6cb0111
--- /dev/null
+++ b/wikitextparser/_wcwidth.py
@@ -0,0 +1,57 @@
+"""Terminal column widths of strings, for aligning table cells and template arguments."""
+
+import unicodedata
+
+# Format characters that are visible despite their category (Unicode's
+# Prepended_Concatenation_Mark characters and the soft hyphen).
+_VISIBLE_FORMAT = {
+    0x00AD,
+    0x0600,
+    0x0601,
+    0x0602,
+    0x0603,
+    0x0604,
+    0x0605,
+    0x06DD,
+    0x070F,
+    0x08E2,
+    0x110BD,
+    0x110CD,
+}
+# Characters that occupy no column beyond the combining and format categories:
+# Hangul jamo that attach to a preceding syllable, the Hangul fillers, and the
+# line/paragraph separators.
+_ZERO_EXTRA = {0x3164, 0xFFA0, 0x2028, 0x2029}
+
+
+def wcwidth(ch):
+    """Columns occupied by one character on a terminal: 0, 1, 2, or -1 if not printable."""
+    code = ord(ch)
+    if code == 0:
+        return 0
+    if code < 32 or 0x7F <= code < 0xA0:
+        return -1
+    if code in _VISIBLE_FORMAT:
+        return 1
+    category = unicodedata.category(ch)
+    if (
+        category in ('Mn', 'Mc', 'Me', 'Cf')
+        or 0x1160 <= code <= 0x11FF
+        or 0xD7B0 <= code <= 0xD7FF
+        or code in _ZERO_EXTRA
+    ):
+        return 0
+    if category != 'Cn' and unicodedata.east_asian_width(ch) in ('W', 'F'):
+        return 2
+    return 1
+
+
+def wcswidth(s):
+    """Columns occupied by a string, or -1 if it contains a non-printable character."""
+    total = 0
+    for ch in s:
+        w = wcwidth(ch)
+        if w < 0:
+            return -1
+        total += w
+    return total
