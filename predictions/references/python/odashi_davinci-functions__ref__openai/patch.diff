@@ -0,0 +1,47 @@
+"""The OpenAI completions endpoint, without the SDK.
+
+``create(**request)`` posts a request to ``/v1/completions`` and returns the
+decoded JSON response (``response["choices"][0]["text"]`` is the completion).
+Credentials come from the module attributes ``api_key`` and ``organization``,
+which default to the ``OPENAI_API_KEY`` and ``OPENAI_ORGANIZATION`` environment
+variables.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import urllib.request
+from typing import Any
+
+api_base = "https://api.openai.com/v1"
+api_key: str | None = os.environ.get("OPENAI_API_KEY")
+organization: str | None = os.environ.get("OPENAI_ORGANIZATION")
+
+
+def set_api_key(key: str, organization: str | None = None) -> None:
+    """Set the OpenAI credentials used by every function in this package."""
+    global api_key
+    api_key = key
+    if organization is not None:
+        globals()["organization"] = organization
+
+
+def create(**request: Any) -> dict[str, Any]:
+    """Request a completion; ``request`` holds ``model``, ``prompt``, ``max_tokens`` and friends."""
+    if not api_key:
+        raise RuntimeError(
+            "No OpenAI API key: set davinci_functions.api_key or the OPENAI_API_KEY environment variable."
+        )
+    headers = {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}
+    if organization:
+        headers["OpenAI-Organization"] = organization
+    req = urllib.request.Request(
+        f"{api_base}/completions",
+        data=json.dumps(request).encode("utf-8"),
+        headers=headers,
+        method="POST",
+    )
+    with urllib.request.urlopen(req) as response:
+        body: dict[str, Any] = json.loads(response.read().decode("utf-8"))
+    return body
