+_REAL_ROOT = os.path.realpath(_ROOT)
+_SELF = {os.path.abspath(__file__),
+         os.path.join(_ROOT, "sitecustomize.py"), os.path.join(_ROOT, "conftest.py")}
+_REAL_SELF = {os.path.realpath(p) for p in _SELF}
