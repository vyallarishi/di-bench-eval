+"""Command-line parsing for ``tbump``, matching the usage text in ``tbump.cli``.
+
+``parse_cli_args`` returns the same dictionary shape the usage text implies: one
+key per option (``False``/``None`` when absent), one per positional
+(``<new_version>``, ``<current_version>``), one per command (``init``,
+``current-version``). ``-h``/``--help`` prints the usage and exits 0; any other
+problem prints the usage to stderr and exits 1.
+"""
+
+import sys
+from typing import Dict, List, Optional, Union
+
+FLAGS = {
+    "-h": "--help",
+    "--help": "--help",
+    "-v": "--version",
+    "--version": "--version",
+    "--non-interactive": "--non-interactive",
+    "--dry-run": "--dry-run",
+    "--only-patch": "--only-patch",
+    "--no-tag": "--no-tag",
+    "--no-push": "--no-push",
+    "--no-tag-push": "--no-tag-push",
+    "--pyproject": "--pyproject",
+}
+VALUED = {
+    "-C": "--cwd",
+    "--cwd": "--cwd",
+    "-c": "--config",
+    "--config": "--config",
+    "--tag-message": "--tag-message",
+}
+LONG_NAMES = sorted(
+    name for name in list(FLAGS) + list(VALUED) if name.startswith("--")
+)
+
+OptDict = Dict[str, Union[bool, Optional[str]]]
+
+
+class UsageError(SystemExit):
+    def __init__(self, usage: str, message: str = "") -> None:
+        super().__init__((message + "\n" if message else "") + usage.strip())
+
+
+def _resolve_long(name: str, usage: str) -> str:
+    """Accept any unambiguous prefix of a long option, as docopt did."""
+    if name in FLAGS or name in VALUED:
+        return name
+    matches = [full for full in LONG_NAMES if full.startswith(name)]
+    if len(matches) == 1:
+        return matches[0]
+    raise UsageError(
+        usage,
+        f"{name} is not a unique prefix: {', '.join(matches)}?" if matches else "",
+    )
+
+
+def _empty() -> OptDict:
+    opts: OptDict = {name: False for name in set(FLAGS.values())}
+    opts.update({name: None for name in set(VALUED.values())})
+    opts.update(
+        {
+            "<new_version>": None,
+            "<current_version>": None,
+            "init": False,
+            "current-version": False,
+        }
+    )
+    return opts
+
+
+def parse_cli_args(usage: str, argv: List[str]) -> OptDict:
+    opts = _empty()
+    positionals: List[str] = []
+    tokens = list(argv)
+    while tokens:
+        token = tokens.pop(0)
+        if token == "--":
+            raise UsageError(usage)
+        if token.startswith("--"):
+            name, eq, inline = token.partition("=")
+            name = _resolve_long(name, usage)
+            if name in FLAGS:
+                if eq:
+                    raise UsageError(usage, f"{name} must not have an argument")
+                opts[FLAGS[name]] = True
+            else:
+                if eq:
+                    value = inline
+                elif tokens:
+                    value = tokens.pop(0)
+                else:
+                    raise UsageError(usage, f"{name} requires argument")
+                opts[VALUED[name]] = value
+        elif token.startswith("-") and token != "-":
+            short, rest = token[:2], token[2:]
+            if short in FLAGS:
+                opts[FLAGS[short]] = True
+                if rest:
+                    tokens.insert(0, "-" + rest)
+            elif short in VALUED:
+                if rest:
+                    value = rest
+                elif tokens:
+                    value = tokens.pop(0)
+                else:
+                    raise UsageError(usage, f"{short} requires argument")
+                opts[VALUED[short]] = value
+            else:
+                raise UsageError(usage)
+        else:
+            positionals.append(token)
+    if opts["--help"]:
+        print(usage.strip())
+        sys.exit()
+    others = any(
+        opts[name]
+        for name in (
+            "--non-interactive",
+            "--dry-run",
+            "--only-patch",
+            "--no-tag",
+            "--no-push",
+            "--no-tag-push",
+            "--pyproject",
+            "--cwd",
+            "--config",
+            "--tag-message",
+        )
+    )
+    if len(positionals) == 1 and not opts["--version"]:
+        opts["<new_version>"] = positionals[0]
+    elif len(positionals) == 2 and positionals[0] == "init" and not opts["--version"]:
+        opts["init"] = True
+        opts["<current_version>"] = positionals[1]
+    elif opts["--version"] and not positionals and not others:
+        pass
+    else:
+        raise UsageError(usage)
+    return opts
