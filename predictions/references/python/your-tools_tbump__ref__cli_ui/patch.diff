+"""Console output for tbump: coloured tokens, headings, counters, errors and a
+yes/no prompt, with the output format the tool has always had.
+
+Colours are emitted when ``setup(color="always")`` was called, or in ``auto`` mode
+when stdout is a terminal. ``debug`` prints only after ``setup(verbose=True)``.
+"""
+
+import sys
+from typing import Any, Optional, TextIO
+
+CONFIG = {"verbose": False, "color": "auto"}
+
+
+class Color:
+    def __init__(self, name: str, code: int) -> None:
+        self.name = name
+        self.code = code
+
+    def __repr__(self) -> str:
+        return f"Color({self.name})"
+
+
+class UnicodeSequence:
+    """A coloured symbol: rendered as a reset, its colour, the text, then a reset."""
+
+    def __init__(self, color: Color, text: str) -> None:
+        self.color = color
+        self.text = text
+
+
+reset = Color("reset", 0)
+bold = Color("bold", 1)
+red = Color("red", 31)
+green = Color("green", 32)
+blue = Color("blue", 34)
+yellow = Color("yellow", 33)
+darkgray = Color("darkgray", 30)
+lightgray = Color("lightgray", 37)
+check = UnicodeSequence(green, "✓")
+
+
+def setup(*, verbose: bool = False, color: str = "auto", **_ignored: Any) -> None:
+    CONFIG["verbose"] = verbose
+    CONFIG["color"] = color
+
+
+def tabs(num: int) -> str:
+    return "  " * num
+
+
+def _use_color(fileobj: TextIO) -> bool:
+    if CONFIG["color"] == "always":
+        return True
+    if CONFIG["color"] == "never":
+        return False
+    return bool(getattr(fileobj, "isatty", lambda: False)())
+
+
+def _render(tokens: Any, sep: str, end: str, fileobj: TextIO) -> str:
+    """Join the tokens: text tokens are separated by ``sep`` (none after the last
+    token), colours become escape codes when colour is on, and a colour run always
+    ends with a reset after ``end``."""
+    color = _use_color(fileobj)
+    flat: list = []
+    for token in tokens:
+        if isinstance(token, UnicodeSequence):
+            flat += [reset, token.color, token.text, reset]
+        else:
+            flat.append(token)
+    out = ""
+    for i, token in enumerate(flat):
+        if isinstance(token, Color):
+            out += f"\033[{token.code}m" if color else ""
+        else:
+            out += str(token)
+            if i != len(flat) - 1:
+                out += sep
+    out += end
+    if color:
+        out += "\033[0m"
+    return out
+
+
+def _message(
+    *tokens: Any, sep: str = " ", end: str = "\n", fileobj: Optional[TextIO] = None
+) -> None:
+    fileobj = fileobj or sys.stdout
+    fileobj.write(_render(tokens, sep, end, fileobj))
+    fileobj.flush()
+
+
+def info(*tokens: Any, **kwargs: Any) -> None:
+    _message(*tokens, **kwargs)
+
+
+def info_1(*tokens: Any, **kwargs: Any) -> None:
+    _message(bold, blue, "::", reset, *tokens, **kwargs)
+
+
+def info_2(*tokens: Any, **kwargs: Any) -> None:
+    _message(bold, blue, "=>", reset, *tokens, **kwargs)
+
+
+def info_3(*tokens: Any, **kwargs: Any) -> None:
+    _message(bold, blue, "*", reset, *tokens, **kwargs)
+
+
+def info_count(i: int, n: int, *rest: Any, **kwargs: Any) -> None:
+    num_digits = len(str(n))
+    counter = f"({i + 1:{num_digits}d}/{n})"
+    _message(green, "*", reset, counter, reset, *rest, **kwargs)
+
+
+def error(*tokens: Any, **kwargs: Any) -> None:
+    kwargs.setdefault("fileobj", sys.stderr)
+    _message(bold, red, "Error:", *tokens, **kwargs)
+
+
+def debug(*tokens: Any, **kwargs: Any) -> None:
+    if CONFIG["verbose"]:
+        _message(*tokens, **kwargs)
+
+
+def ask_yes_no(*question: Any, default: bool = False) -> bool:
+    """Ask a yes/no question; an empty answer gives ``default``."""
+    while True:
+        _message(green, "::", reset, *question, reset, "(Y/n)" if default else "(y/N)")
+        _message(green, "> ", end="")
+        answer = input()
+        if answer.lower() in ("y", "yes"):
+            return True
+        if answer.lower() in ("n", "no"):
+            return False
+        if not answer:
+            return default
+        _message(
+            yellow,
+            "Warning:",
+            "Please answer by 'y' (yes) or 'n' (no) ",
+            fileobj=sys.stderr,
+        )
