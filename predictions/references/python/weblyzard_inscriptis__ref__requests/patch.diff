+
+def _encoding_from_headers(headers: Message) -> Optional[str]:
+    """Return the declared charset, else ISO-8859-1 for text and UTF-8 for JSON."""
+    content_type = headers.get("content-type", "")
+    charset = headers.get_content_charset()
+    if charset:
+        return charset
+    if "text" in content_type:
+        return "ISO-8859-1"
+    if "application/json" in content_type:
+        return "utf-8"
+    return None
+
