+"""Load a .env file into the process environment."""
+
+import os
+import re
+from typing import Iterator, Mapping, MutableMapping, Optional, Tuple
+
+_VAR = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?::-([^}]*))?\}")
+_ESCAPES = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\", '"': '"', "'": "'", "$": "$"}
+
+
+def _closing(body: str, quote: str) -> int:
+    """Index of the closing quote, skipping backslash-escaped ones in double quotes."""
+    i = 0
+    while i < len(body):
+        if body[i] == "\\" and quote == '"':
+            i += 2
+            continue
+        if body[i] == quote:
+            return i
+        i += 1
+    return -1
+
+
+def _parse(text: str) -> Iterator[Tuple[str, Optional[str], bool]]:
+    """Yield (key, value) pairs; value is None for a bare key, quoted is a flag."""
+    pos, n = 0, len(text)
+    while pos < n:
+        end = text.find("\n", pos)
+        end = n if end < 0 else end
+        line = text[pos:end].strip()
+        pos = end + 1
+        if not line or line.startswith("#"):
+            continue
+        if line.startswith("export "):
+            line = line[7:].lstrip()
+        key, sep, rest = line.partition("=")
+        key = key.strip()
+        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
+            continue
+        if not sep:
+            yield key, None, False
+            continue
+        rest = rest.lstrip()
+        if rest[:1] in ("'", '"'):
+            quote = rest[0]
+            body = rest[1:]
+            close = _closing(body, quote)
+            while close < 0 and pos < n:  # quoted value continues on the next line
+                nxt = text.find("\n", pos)
+                nxt = n if nxt < 0 else nxt
+                body += "\n" + text[pos:nxt].rstrip("\r")
+                pos = nxt + 1
+                close = _closing(body, quote)
+            if close < 0:
+                yield key, rest.rstrip(), False
+                continue
+            trailing = body[close + 1 :].strip()
+            if trailing and not trailing.startswith("#"):
+                continue  # malformed line: python-dotenv skips it
+            value = body[:close]
+            if quote == '"':
+                value = re.sub(r"\\(.)", lambda m: _ESCAPES.get(m.group(1), "\\" + m.group(1)), value)
+            yield key, value, quote == "'"
+        else:
+            value = re.split(r"\s#", rest, maxsplit=1)[0].strip()
+            yield key, value, False
+
+
+def _expand(value: str, scope: Mapping[str, str]) -> str:
+    return _VAR.sub(lambda match: scope.get(match.group(1), match.group(2) or ""), value)
+
+
+def load_dotenv(
+    dotenv_path: "str | os.PathLike[str]", override: bool = False, environ: Optional[MutableMapping[str, str]] = None
+) -> bool:
+    """Load KEY=VALUE pairs from a .env file into the environment.
+
+    Existing variables win unless ``override`` is true. ``${VAR}`` and
+    ``${VAR:-default}`` in unquoted and double-quoted values are expanded from the
+    environment and from values set earlier in the file.
+    """
+    environ = os.environ if environ is None else environ
+    try:
+        with open(dotenv_path, encoding="utf-8") as f:
+            text = f.read()
+    except OSError:
+        return False
+    loaded: dict[str, str] = {}
+    for key, value, literal in _parse(text):
+        if value is None:
+            continue
+        if not literal:
+            scope = {**loaded, **environ} if not override else {**environ, **loaded}
+            value = _expand(value, scope)
+        loaded[key] = value
+        if override or key not in environ:
+            environ[key] = value
+    return True
