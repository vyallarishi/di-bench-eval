index 0000000..928a1c2
--- /dev/null
+++ b/humanlayer/cli/test_env_file.py
@@ -0,0 +1,23 @@
+from pathlib import Path
+
+from humanlayer.cli.env_file import load_dotenv
+
+
+def test_loads_values_without_overriding_existing(tmp_path: Path) -> None:
+    env_file = tmp_path / ".env"
+    env_file.write_text(
+        'export A=1\nB="two \\"quoted\\"\\nlines"\n# comment\nC=\'$A literal\'\nD=${A}-${MISSING:-x}\nE=trailing # comment\n'
+    )
+    environ = {"A": "already"}
+    assert load_dotenv(env_file, environ=environ) is True
+    assert environ == {
+        "A": "already",
+        "B": 'two "quoted"\nlines',
+        "C": "$A literal",
+        "D": "already-x",
+        "E": "trailing",
+    }
+
+
+def test_missing_file_is_not_an_error(tmp_path: Path) -> None:
+    assert load_dotenv(tmp_path / "absent.env", environ={}) is False
