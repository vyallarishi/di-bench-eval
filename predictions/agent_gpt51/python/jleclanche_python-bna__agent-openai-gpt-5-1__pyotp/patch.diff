+def _hotp(secret: str, counter: int, digits: int = 6) -> str:
+	"""Generate an HOTP code (RFC 4226) using a base32 secret.
+
+	Implementation is compatible with pyotp for TOTP/HOTP generation.
+	"""
+	key = base64.b32decode(secret, casefold=True)
+	msg = struct.pack(">Q", counter)
+	# HMAC-SHA1
+	import hmac
+	import hashlib
+
+	hmac_hash = hmac.new(key, msg, hashlib.sha1).digest()
+	offset = hmac_hash[-1] & 0x0F
+	code = (
+		((hmac_hash[offset] & 0x7F) << 24)
+		| ((hmac_hash[offset + 1] & 0xFF) << 16)
+		| ((hmac_hash[offset + 2] & 0xFF) << 8)
+		| (hmac_hash[offset + 3] & 0xFF)
+	) % (10 ** digits)
+	return str(code).zfill(digits)
+
+
+def get_totp(secret: str, digits: int = 6, interval: int = 30, for_time: int | None = None) -> str:
+	"""Return the TOTP value for a given base32 secret.
+
+	`for_time` can be provided for testing; by default current time is used.
+	"""
+	if for_time is None:
+		for_time = int(time.time())
+	counter = int(for_time / interval)
+	return _hotp(secret, counter, digits=digits)
+
