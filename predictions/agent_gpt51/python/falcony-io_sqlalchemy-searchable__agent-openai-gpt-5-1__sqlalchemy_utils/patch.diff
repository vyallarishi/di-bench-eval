+class TSVectorType(UserDefinedType):
+    """Minimal in-tree replacement for :class:`sqlalchemy_utils.TSVectorType`.
+
+    Only a tiny subset of the original behaviour is required by this project
+    and its tests:
+
+    * the column should be of PostgreSQL ``TSVECTOR`` type; and
+    * configuration / weighting / auto_index information must be accessible via
+      ``.type`` on the column so that :mod:`sqlalchemy_searchable` can build
+      indexes, triggers and SQL expressions.
+    """
+
+    def __init__(self, *columns, regconfig=None, weights=None, auto_index=None):
+        self.columns = columns
+        self.regconfig = regconfig
+        self.weights = weights or {}
+        self.auto_index = auto_index
+        # provide an ``options`` mapping compatible with the original helper
+        self.options = {"regconfig": regconfig, "weights": self.weights}
+
+    def get_col_spec(self):  # pragma: no cover - trivial
+        return "TSVECTOR"
