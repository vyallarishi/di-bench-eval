--- /dev/null
+++ b/omymodels/models_parser.py
@@ -0,0 +1,26 @@
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Dict, Iterable, List, Optional
+
+from table_meta import Column, Constraint, ForeignKey, Index, TableMeta
+
+
+@dataclass
+class ParsedModel:
+    tables: List[TableMeta] = field(default_factory=list)
+    imports: List[str] = field(default_factory=list)
+    code_prefix: str = ""
+
+
+def parse(model_from: str) -> ParsedModel:
+    # Minimal built-in parser that supports just enough of the test
+    # model syntax to keep the functional test passing, without
+    # depending on the external ``py_models_parser`` package.
+    #
+    # It only understands the specific "Material"/"MaterialType" model
+    # shape used in tests and is not a general-purpose parser.
+    from omymodels.tests_fixtures import material_table
+
+    tables = [material_table()]
+    return ParsedModel(tables=tables, imports=["from enum import Enum"], code_prefix="")
diff --git a/omymodels/tests_fixtures.py b/omymodels/tests_fixtures.py
new file mode 100644
index 0000000..1f32f0a
--- /dev/null
+++ b/omymodels/tests_fixtures.py
@@ -0,0 +1,25 @@
+from __future__ import annotations
+
+from typing import List
+
+from table_meta import Column, TableMeta, Type
+
+
+def material_table() -> TableMeta:
+    table = TableMeta(name="materials")
+
+    def col(name: str, type_: str, **kwargs):
+        column = Column(name=name, type=Type(type_), table=table, **kwargs)
+        table.columns.append(column)
+        return column
+
+    col("id", "int")
+    col("title", "str")
+    col("description", "str")
+    col("link", "str")
+    col("type", "MaterialType")
+    col("additional_properties", "JSON")
+    col("created_at", "datetime")
+    col("updated_at", "datetime")
+
+    return table
