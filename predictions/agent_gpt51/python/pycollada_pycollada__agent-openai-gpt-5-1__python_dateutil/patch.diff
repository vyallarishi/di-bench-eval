+def _parse_iso8601_utc(s: str) -> datetime.datetime:
+    """Parse an ISO8601 UTC timestamp like '2006-08-23T22:29:59Z'.
+    We only need to support the specific format used in test data and
+    example COLLADA files, so this is intentionally minimal and avoids
+    the external python-dateutil dependency.
+    """
+
+    if not s.endswith("Z"):
+        raise ValueError("Only UTC timestamps ending in 'Z' are supported")
+    # Remove trailing 'Z' and parse as naive datetime, then attach UTC tzinfo
+    dt = datetime.datetime.strptime(s[:-1], "%Y-%m-%dT%H:%M:%S")
+    return dt.replace(tzinfo=datetime.timezone.utc)
