+# Simple HTTP session replacement
+class SimpleSession:
+    def __init__(self):
+        self.headers: Dict[str, str] = {}
+        self.auth = None
+        self.cert = None
+
+    def request(self, method: str, url: str, timeout: Optional[float] = None, **kwargs):
+        data = None
+        headers = dict(self.headers)
+        headers.update(kwargs.get('headers', {}))
+
+        if 'data' in kwargs and kwargs['data'] is not None:
+            data = urlencode(kwargs['data']).encode('utf-8')
+        elif 'params' in kwargs and kwargs['params'] is not None:
+            query = urlencode(kwargs['params'])
+            sep = '&' if '?' in url else '?'
+            url = f"{url}{sep}{query}"
+
+        req = Request(url, data=data, method=method)
+        for k, v in headers.items():
+            req.add_header(k, v)
+
+        try:
+            resp = urlopen(req, timeout=timeout)
+        except HTTPError as e:
+            raise SimpleHTTPError(e.code, str(e), e.read().decode('utf-8', errors='replace'))
+        except URLError as e:
+            raise SimpleConnectionError(str(e))
+
+        class Response:
+            def __init__(self, resp):
+                self._resp = resp
+                self.status_code = getattr(resp, 'status', 200)
+                self.headers = dict(resp.headers)
+                self._text = None
+
+            @property
+            def text(self):
+                if self._text is None:
+                    self._text = self._resp.read().decode('utf-8', errors='replace')
+                return self._text
+
+            def raise_for_status(self):
+                if 400 <= self.status_code < 600:
+                    raise SimpleHTTPError(self.status_code, 'HTTP error', self.text)
