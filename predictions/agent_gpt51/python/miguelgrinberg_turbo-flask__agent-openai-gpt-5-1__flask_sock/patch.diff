+class ConnectionClosed(Exception):
+    """Fallback ConnectionClosed exception for WebSocket integrations.
+
+    WebSocket objects used with Turbo-Flask only need to implement ``receive``
+    and ``send`` methods, and may raise this exception (or ``BrokenPipeError``)
+    when the connection is closed.  In earlier versions this exception was
+    imported from :mod:`flask_sock`; to avoid that dependency we provide a
+    minimal local definition instead.  Third-party WebSocket extensions are
+    free to subclass or replace it.
+    """
+
+
 class Turbo:
     def __init__(self, app=None):
         self.user_id_callback = self.default_user_id
@@ -21,7 +32,21 @@ class Turbo:
         ws_route = app.config.setdefault('TURBO_WEBSOCKET_ROUTE',
                                          '/turbo-stream')
         if ws_route:
-            self.sock = Sock()
+            # ``sock`` is expected to be an object exposing a ``route`` decorator
+            # compatible with :class:`flask_sock.Sock`.  It must be initialised
+            # by the application and attached to ``app.extensions['turbo-sock']``
+            # before :meth:`init_app` is called.  This indirection allows the
+            # project to avoid a hard dependency on :mod:`flask_sock` while
+            # keeping backwards-compatible behaviour for applications that use
+            # it or provide an equivalent implementation.
+            self.sock = app.extensions.get('turbo-sock')
+
+            if self.sock is None:
+                raise RuntimeError(
+                    'A WebSocket extension must be provided in '
+                    "app.extensions['turbo-sock'] for Turbo-Flask to "
+                    'handle WebSocket connections.'
+                )
 
             @self.sock.route(ws_route)
             def turbo_stream(ws):
