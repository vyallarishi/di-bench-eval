+def _unpinbench_pytest_fd(config):
+    # Loaded through conftest.py rather than sitecustomize.py, this module is
+    # imported after pytest has already redirected fd 1, so the dup above
+    # points at the capture file and every trace line is swallowed. pytest
+    # keeps the real console on its FDCapture.targetfd_save; switch to it.
+    global _TRACE_FD
+    try:
+        cap = config.pluginmanager.get_plugin("capturemanager")
+        out = getattr(getattr(cap, "_global_capturing", None), "out", None)
+        saved = getattr(out, "targetfd_save", None)
+        if saved is not None:
+            _TRACE_FD = saved
+            os.write(_TRACE_FD, ("UnpinBench recorder active (pytest saved fd %d): targets=%r"
+                                 % (saved, _TARGETS) + chr(10)).encode("utf-8", "replace"))
+    except Exception:
+        pass
+
+
+pytest_configure = _unpinbench_pytest_fd
