-from category_encoders.base_contrast_encoder import BaseContrastEncoder
+from category_encoders.base_contrast_encoder import BaseContrastEncoder, ContrastMatrix
 
 __author__ = 'paulwestenthanner'
 
@@ -72,7 +71,39 @@ class PolynomialEncoder(BaseContrastEncoder):
 
     .. [2] Gregory Carey (2003). Coding Categorical Variables, from
     http://ibgwww.colorado.edu/~carey/p5741ndir/Coding_Categorical_Variables.pdf
-    
+        
     """
     def get_contrast_matrix(self, values_to_encode: np.array) -> ContrastMatrix:
-        return Poly().code_without_intercept(values_to_encode)
+        # Polynomial contrasts correspond to orthogonal polynomials in the
+        # (integer) level indices. We reproduce patsy's behaviour by using
+        # centered integer scores and the Gram-Schmidt process.
+        n_levels = len(values_to_encode)
+        if n_levels <= 1:
+            return ContrastMatrix(np.zeros((n_levels, 0)), [])
+
+        # Use equally spaced scores 0, 1, ..., n_levels-1
+        x = np.arange(n_levels, dtype=float)
+        x_mean = x.mean()
+        x = x - x_mean
+
+        # Build design matrix with powers of x, then orthogonalise columns
+        # and drop the intercept column.
+        X = np.vstack([x ** k for k in range(n_levels)]).T
+
+        Q = np.zeros_like(X)
+        for j in range(n_levels):
+            v = X[:, j].copy()
+            for i in range(j):
+                proj = np.dot(Q[:, i], v) / np.dot(Q[:, i], Q[:, i])
+                v = v - proj * Q[:, i]
+            Q[:, j] = v
+
+        # Drop the first column (intercept-like) and normalise remaining
+        Q = Q[:, 1:]
+        # Normalise columns to unit length to match typical contrast behaviour
+        norms = np.linalg.norm(Q, axis=0)
+        norms[norms == 0] = 1.0
+        Q = Q / norms
+
+        suffixes = list(range(Q.shape[1]))
+        return ContrastMatrix(Q, suffixes)
