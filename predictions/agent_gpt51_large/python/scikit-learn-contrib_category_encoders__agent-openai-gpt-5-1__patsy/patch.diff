     """
 
     def get_contrast_matrix(self, values_to_encode: np.array) -> ContrastMatrix:
-        return Sum().code_without_intercept(values_to_encode.tolist())
+        # Sum contrasts: each coded column sums to zero across levels.
+        n_levels = len(values_to_encode)
+        if n_levels <= 1:
+            return ContrastMatrix(np.zeros((n_levels, 0)), [])
+
+        # Use the first (n_levels - 1) standard basis vectors and set the last
