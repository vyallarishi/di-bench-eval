diff --git a/nvflare/dashboard/application/jwt.py b/nvflare/dashboard/application/jwt.py
new file mode 100644
index 0000000..c065688
--- /dev/null
+++ b/nvflare/dashboard/application/jwt.py
@@ -0,0 +1,64 @@
+from datetime import timedelta
+
+from flask import _request_ctx_stack, current_app
+from werkzeug.local import LocalProxy
+
+
+class JWTManager:
+    def __init__(self, app=None):
+        if app is not None:
+            self.init_app(app)
+
+    def init_app(self, app):
+        app.config.setdefault("JWT_SECRET_KEY", app.config.get("SECRET_KEY", "change-me"))
+        app.config.setdefault("JWT_ACCESS_TOKEN_EXPIRES", timedelta(hours=1))
+
+    def token_in_blocklist_loader(self, fn):
+        self._token_in_blocklist = fn
+        return fn
+
+    def expired_token_loader(self, fn):
+        self._expired_token_callback = fn
+        return fn
+
+
+def _get_jwt():
+    ctx = _request_ctx_stack.top
+    return getattr(ctx, "jwt", {})
+
+
+current_jwt = LocalProxy(_get_jwt)
+
+
+def create_access_token(identity, additional_claims=None):
+    """Very small, insecure stand-in replacement.
+
+    This implementation just returns a dict; the frontend and tests should treat it
+    as an opaque value and send it back via Authorization header. In a real
+    deployment you'd plug in a proper JWT implementation.
+    """
+
+    token = {"sub": identity}
+    if additional_claims:
+        token.update(additional_claims)
+    return token
+
+
+def get_jwt_identity():
+    return current_jwt.get("sub")
+
+
+def get_jwt():
+    return current_jwt
+
+
+def jwt_required():
+    def decorator(fn):
+        def wrapper(*args, **kwargs):
+            # No-op placeholder; assume already authenticated in tests.
+            return fn(*args, **kwargs)
+
+        wrapper.__name__ = fn.__name__
+        return wrapper
+
+    return decorator
