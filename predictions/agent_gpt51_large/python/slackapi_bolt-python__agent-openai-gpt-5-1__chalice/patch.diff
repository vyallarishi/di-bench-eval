+class MockResponse:
+    def __init__(self, body: str, status_code: int = 200, headers: Dict[str, str] | None = None):
+        self.body = body
+        self.status_code = status_code
+        self.headers = headers or {"Content-Type": "application/json"}
+
+
+class MockRequest:
+    def __init__(self, method: str, path: str, headers: Dict[str, str], body: str):
+        self.method = method
+        self.context = {"resourcePath": path}
+        self.headers = headers
+        self.raw_body = body.encode("utf-8")
+        self.query_params = {}
+
+
+class MockConfig:
+    pass
+
+
+class MockLocalGateway:
+    def __init__(self, app: "MockChaliceApp", config: MockConfig | None = None):
+        self.app = app
+        self.config = config or MockConfig()
+
+    def handle_request(self, method: str, path: str, body: str, headers: Dict[str, str]) -> Dict[str, Any]:
+        return self.app.handle_request(method=method, path=path, body=body, headers=headers)
+
+
+class MockChaliceApp:
+    def __init__(self, app_name: str):
+        self.app_name = app_name
+        self.current_request: MockRequest | None = None
+        self._routes: Dict[str, Dict[str, Any]] = {}
+
+    def route(self, path: str, methods: List[str] | None = None, content_types: List[str] | None = None):
+        methods = methods or ["GET"]
+
+        def decorator(func: Callable[[MockRequest], MockResponse]):
+            self._routes[path] = {"methods": methods, "func": func, "content_types": content_types}
+            return func
+
+        return decorator
+
+    def handle_request(self, method: str, path: str, body: str, headers: Dict[str, str]) -> Dict[str, Any]:
+        if path not in self._routes or method not in self._routes[path]["methods"]:
+            return {"statusCode": 404, "headers": {}, "body": "Not Found"}
+
+        self.current_request = MockRequest(method=method, path=path, headers=headers, body=body)
+        func = self._routes[path]["func"]
+        response: MockResponse = func()
+        return {"statusCode": response.status_code, "headers": response.headers, "body": response.body}
+
+
+LocalGateway = MockLocalGateway
+Config = MockConfig
+Request = MockRequest
+Response = MockResponse
+
