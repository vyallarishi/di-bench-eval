+++ b/tweepy/_auth_helpers.py
@@ -0,0 +1,61 @@
+import requests
+from urllib.parse import parse_qs
+
+from oauthlib.oauth1 import SIGNATURE_HMAC, Client as OAuth1Client
+from oauthlib.oauth2 import WebApplicationClient as OAuth2Client
+
+from tweepy.errors import TweepyException
+
+
+class OAuth1UserAuth(requests.auth.AuthBase):
+    def __init__(self, consumer_key, consumer_secret, access_token=None, access_token_secret=None):
+        self.client = OAuth1Client(
+            client_key=consumer_key,
+            client_secret=consumer_secret,
+            resource_owner_key=access_token,
+            resource_owner_secret=access_token_secret,
+            signature_method=SIGNATURE_HMAC,
+            decoding=None,
+        )
+
+    def __call__(self, r):
+        uri, headers, body = self.client.sign(
+            r.url,
+            http_method=r.method,
+            body=r.body,
+            headers=r.headers,
+        )
+        r.url = uri
+        r.headers.update(headers)
+        return r
+
+
+class OAuth2UserSession:
+    def __init__(self, client_id, redirect_uri, scope):
+        self.client = OAuth2Client(client_id=client_id, redirect_uri=redirect_uri, scope=scope)
+
+    def create_authorization_url(self):
+        code_verifier = self.client.create_code_verifier(128)
+        code_challenge = self.client.create_code_challenge(code_verifier, "S256")
+        uri, state = self.client.prepare_request_uri(
+            "https://twitter.com/i/oauth2/authorize",
+            code_challenge=code_challenge,
+            code_challenge_method="S256",
+        )
+        self.code_verifier = code_verifier
+        return uri
+
+    def fetch_token(self, authorization_response, auth=None):
+        token_url = "https://api.twitter.com/2/oauth2/token"
+        body = self.client.prepare_request_body(
+            authorization_response=authorization_response,
+            include_client_id=True,
+            code_verifier=self.code_verifier,
+        )
+        headers = {"Content-Type": "application/x-www-form-urlencoded"}
+        response = requests.post(token_url, data=body, headers=headers, auth=auth)
+        if response.status_code >= 400:
+            raise TweepyException(f"Error fetching token: {response.status_code} {response.text}")
+        token = response.json()
+        self.client.parse_request_body_response(response.text)
+        return token
