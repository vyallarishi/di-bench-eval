+class ItemSortedDict(SortedDict):
+    """A dictionary that maintains items sorted by a key function of (key, value).
+
+    This replicates the minimal behavior of ``sortedcollections.recipes.ItemSortedDict``
+    that is used in this project: ``peekitem(0)`` returns the item with the
+    *smallest* sort key.
+    """
+
+    def __init__(self, key):
+        super().__init__()
+        self._key = key
+
+    def __setitem__(self, k, v):
+        # store by computed sort key; value is (original_key, original_value)
+        sort_key = self._key(k, v)
+        super().__setitem__(sort_key, (k, v))
+
+    def update(self, other=(), **kwargs):  # type: ignore[override]
+        if isinstance(other, ItemSortedDict):
+            for k, v in other.items():
+                self[k] = v
+        elif isinstance(other, collections.abc.Mapping):
+            for k, v in other.items():
+                self[k] = v
+        else:
+            for k, v in other:
+                self[k] = v
+        for k, v in kwargs.items():
+            self[k] = v
+
+    def items(self):  # type: ignore[override]
+        for _sort_key, (k, v) in super().items():
+            yield k, v
+
+    def values(self):  # type: ignore[override]
+        for _sort_key, (k, v) in super().values():
+            yield v
+
+    def keys(self):  # type: ignore[override]
+        for _sort_key, (k, _v) in super().items():
+            yield k
+
+    def popitem(self, index=-1):  # type: ignore[override]
+        # maintain API compatibility though only index=0 is used
+        if index not in (0, -1):
+            raise NotImplementedError("ItemSortedDict.popitem only supports index 0 or -1")
+        if index == 0:
+            key = self.iloc[0]
+        else:
+            key = self.iloc[-1]
+        (_sort_key, (k, v)) = super().popitem(key)
+        return k, v
+
+    def peekitem(self, index=-1):
+        if index not in (0, -1):
+            raise NotImplementedError("ItemSortedDict.peekitem only supports index 0 or -1")
+        if index == 0:
+            key = self.iloc[0]
+        else:
+            key = self.iloc[-1]
+        _sort_key, (k, v) = super().peekitem(key)
+        return k, v
+
