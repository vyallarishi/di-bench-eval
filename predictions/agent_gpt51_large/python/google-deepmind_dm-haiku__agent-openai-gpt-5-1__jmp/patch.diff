+class LossScale:
+  """Minimal loss scaling helper replacing jmp.LossScale."""
+
+  def __init__(self, value: float):
+    self._value = float(value)
+
+  @property
+  def loss_scale(self) -> float:
+    return self._value
+
+  def scale(self, loss: jax.Array) -> jax.Array:
+    return loss * self._value
+
+  def unscale(self, grads):
+    inv = 1.0 / self._value
+    return jax.tree.map(lambda g: g * inv, grads)
+
+  def adjust(self, grads_finite: bool) -> "LossScale":
+    if not grads_finite:
+      return LossScale(max(self._value / 2.0, 1.0))
+    return self
+
