+class CustomExpiryTTLCache:
+    """Simple TTL cache with per-key expiry, replacing cachetools.TTLCache.
+
+    The interface is intentionally minimal: it only provides methods actually
+    used in the code base (``__contains__``, ``__getitem__``, ``get``,
+    ``__setitem__``, and :meth:`set_expiry`).
+    """
+
+    def __init__(self, maxsize: int = 128):
+        self.maxsize = maxsize
+        self._store: Dict[Any, Any] = {}
+        self._expiry: Dict[Any, float] = {}
+
+    def _purge_expired(self):
+        now = time.time()
+        expired_keys = [k for k, exp in self._expiry.items() if exp <= now]
+        for k in expired_keys:
+            self._store.pop(k, None)
+            self._expiry.pop(k, None)
+
+    def __contains__(self, key: Any) -> bool:
+        self._purge_expired()
+        return key in self._store
+
+    def __getitem__(self, key: Any) -> Any:
+        self._purge_expired()
+        return self._store[key]
+
+    def get(self, key: Any, default: Any = None) -> Any:
+        self._purge_expired()
+        return self._store.get(key, default)
+
+    def __setitem__(self, key: Any, value: Any):
+        self._purge_expired()
+        if len(self._store) >= self.maxsize and key not in self._store:
+            # evict arbitrary key (no strict LRU requirements here)
+            oldest_key = next(iter(self._store.keys()))
+            self._store.pop(oldest_key, None)
+            self._expiry.pop(oldest_key, None)
+        self._store[key] = value
 
