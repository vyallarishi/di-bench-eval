+class LRUCache(dict):
+    """A very small LRU cache implementation so we don't depend on cachetools.
+
+    This implements only the behaviour relied on by our code: a mapping with a
+    fixed ``maxsize`` that evicts the least-recently-used item when adding a new
+    one after the cache is full. It supports ``get`` and ``__getitem__`` access
+    patterns used in the code base.
+    """
+
+    def __init__(self, maxsize: int = 128):
+        super().__init__()
+        self.maxsize = maxsize
+        self._order: List[Any] = []
+
+    def __getitem__(self, key):
+        value = super().__getitem__(key)
+        self._mark_used(key)
+        return value
+
+    def get(self, key, default=None):
+        if key in self:
+            return self[key]
+        return default
+
+    def __setitem__(self, key, value):
+        if key in self:
+            super().__setitem__(key, value)
+            self._mark_used(key)
+            return
+
+        if len(self) >= self.maxsize:
+            # evict least recently used
+            lru_key = self._order.pop(0)
+            super().__delitem__(lru_key)
+
+        super().__setitem__(key, value)
+        self._order.append(key)
+
+    def _mark_used(self, key):
+        try:
+            self._order.remove(key)
+        except ValueError:
+            pass
+        self._order.append(key)
+
