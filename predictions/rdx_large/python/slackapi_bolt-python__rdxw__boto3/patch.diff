+                   "calls": cap(st["calls"], 60), "ccalls": cap(st["ccalls"], 60),
+                   "dfn": cap(st["dfn"], 80), "dmod": st["dmod"], "imp": st["imp"],
+                   "n_calls": sum(st["calls"].values()), "n_ccalls": sum(st["ccalls"].values()),
+                   "n_dfn": len(st["dfn"])}
