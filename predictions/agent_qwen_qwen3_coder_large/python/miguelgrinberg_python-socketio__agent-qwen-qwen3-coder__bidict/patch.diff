+#!/usr/bin/env python3
+
+import sys
+import os
+# Add src to path so we can import socketio
+sys.path.insert(0, 'src')
+
+try:
+    from socketio.base_manager import BaseManager
+    print("Import successful - custom Bidict implementation works!")
+except Exception as e:
+    print(f"Import failed: {e}")
+    sys.exit(1)
+
+# Test the Bidict class directly
+try:
+    from socketio.base_manager import Bidict, ValueDuplicationError
+    
+    # Test basic functionality
+    bd = Bidict()
+    bd['a'] = 1
+    bd['b'] = 2
+    
+    assert bd._fwdm['a'] == 1
+    assert bd._invm[1] == 'a'
+    assert bd._fwdm['b'] == 2
+    assert bd._invm[2] == 'b'
+    
+    # Test ValueDuplicationError
+    try:
+        bd['c'] = 1  # This should raise ValueDuplicationError
+        print("ERROR: ValueDuplicationError was not raised!")
+        sys.exit(1)
+    except ValueDuplicationError:
+        print("ValueDuplicationError correctly raised")
+    
+    # Test deletion
+    del bd['a']
+    assert 'a' not in bd._fwdm
+    assert 1 not in bd._invm
+    
+    print("All Bidict tests passed!")
+    
+except Exception as e:
+    print(f"Bidict tests failed: {e}")
+    sys.exit(1)
