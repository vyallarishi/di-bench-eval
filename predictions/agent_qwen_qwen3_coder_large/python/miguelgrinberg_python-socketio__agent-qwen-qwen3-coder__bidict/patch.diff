@@ -1,7 +1,52 @@
 import itertools
 import logging
 
-from bidict import bidict, ValueDuplicationError
+class ValueDuplicationError(Exception):
+    """Exception raised when attempting to add a duplicate value to a bidict."""
+    pass
+
+
+class Bidict:
+    """A simple bidirectional dictionary implementation."""
+    
+    def __init__(self):
+        self._fwdm = {}  # forward mapping (key -> value)
+        self._invm = {}  # inverse mapping (value -> key)
+    
+    def __setitem__(self, key, value):
+        # Check if value already exists in inverse mapping with a different key
+        if value in self._invm and self._invm[value] != key:
+            raise ValueDuplicationError(f"Value '{value}' already exists with key '{self._invm[value]}'")
+        
+        # Remove old mappings if key already exists
+        if key in self._fwdm:
+            old_value = self._fwdm[key]
+            self._invm.pop(old_value, None)
+        
+        # Update both mappings
+        self._fwdm[key] = value
+        self._invm[value] = key
+    
+    def __delitem__(self, key):
+        if key in self._fwdm:
+            value = self._fwdm[key]
+            del self._fwdm[key]
+            self._invm.pop(value, None)
+    
+    def __contains__(self, key):
+        return key in self._fwdm
+    
+    def __len__(self):
+        return len(self._fwdm)
+    
+    def get(self, key, default=None):
+        return self._fwdm.get(key, default)
+    
+    def copy(self):
+        new_bidict = Bidict()
+        new_bidict._fwdm = self._fwdm.copy()
+        new_bidict._invm = self._invm.copy()
+        return new_bidict
 
