+import sys
+import subprocess
+import os
+
+# Change to the repository directory
+os.chdir("/workspace")
+
+print("=== Testing DNS Changes ===")
+
+# Test importing the modified module
+print("\n1. Testing import of modified net module...")
+try:
+    from localstack.utils.net import send_dns_query
+    print("✓ Successfully imported send_dns_query")
+except Exception as e:
+    print(f"✗ Failed to import send_dns_query: {e}")
+    sys.exit(1)
+
+# Test that the function works
+print("\n2. Testing send_dns_query function...")
+try:
+    # Test with a simple query - this should return bytes or empty bytes
+    result = send_dns_query("example.com", "A", "8.8.8.8", 1.0)
+    if isinstance(result, bytes):
+        print("✓ send_dns_query returned bytes as expected")
+    else:
+        print(f"✗ send_dns_query returned unexpected type: {type(result)}")
+        sys.exit(1)
+except Exception as e:
+    print(f"✓ send_dns_query handled exception gracefully: {e}")
+
+print("\n3. Running DNS server tests...")
+result = subprocess.run([
+    sys.executable, "-m", "pytest", 
+    "tests/unit/test_dns_server.py", 
+    "-v", "--tb=short"
+], capture_output=True, text=True)
+
+if result.returncode == 0:
+    print("✓ DNS server tests passed")
+else:
+    print("✗ DNS server tests failed:")
+    print(result.stdout)
+    print(result.stderr)
+    sys.exit(1)
+
+print("\n=== All tests passed! ===")
