@@ -0,0 +1,149 @@
+"""
+Compatibility layer for plux functionality.
+This replaces the third-party plux package with a minimal implementation.
+"""
+
+import inspect
+from typing import Any, Callable, Dict, List, Optional
+
+
+class PluginSpec:
+    """Specification for a plugin."""
+
+    def __init__(self, namespace: str, name: str, factory: Callable):
+        self.namespace = namespace
+        self.name = name
+        self.factory = factory
+
+
+class Plugin:
+    """Base class for plugins."""
+
+    namespace: Optional[str] = None
+    name: Optional[str] = None
+
+    def load(self, *args, **kwargs):
+        """Load the plugin."""
+        return self
+
+
+def plugin(namespace: str, name: Optional[str] = None):
+    """Decorator to create a plugin."""
+
+    def wrapper(fn_or_class):
+        if inspect.isclass(fn_or_class):
+            # It's a class, set namespace and name as class attributes
+            if namespace:
+                fn_or_class.namespace = namespace
+            if name:
+                fn_or_class.name = name
+        else:
+            # It's a function, store metadata in function attributes
+            fn_or_class.plugin_namespace = namespace
+            fn_or_class.plugin_name = name or fn_or_class.__name__
+        return fn_or_class
+
+    return wrapper
+
+
+class PluginManager:
+    """Manage plugins for a namespace."""
+
+    def __init__(self, namespace: str):
+        self.namespace = namespace
+        self._plugins: Dict[str, PluginSpec] = {}
+
+    def load(self, name: str) -> Any:
+        """Load a plugin by name."""
+        # In a real implementation, this would discover and load plugins
+        # For now, we just return None to indicate not found
+        return None
+
+    def load_all(self, propagate_exceptions=True) -> List[Any]:
+        """Load all plugins."""
+        # In a real implementation, this would discover and load all plugins
+        # For now, we return an empty list
+        return []
+
+    def list_plugin_specs(self) -> List[PluginSpec]:
+        """List all plugin specifications."""
+        # In a real implementation, this would discover plugin specs
+        # For now, we return an empty list
+        return []
+
+
+class FunctionPlugin:
+    """Wrapper for function plugins."""
+
+    def __init__(self, fn, namespace=None, name=None):
+        self.fn = fn
+        self.namespace = namespace
+        self.name = name or fn.__name__
+
+    def __call__(self, *args, **kwargs):
+        return self.fn(*args, **kwargs)
+
+
+# CLI-related utilities
+class spec_to_entry_point:
+    """Utility for converting plugin specs to entry points."""
+
+    def __init__(self, spec):
+        self.spec = spec
+
+    @property
+    def value(self):
+        return f"{self.spec.factory.__module__}:{self.spec.factory.__name__}"
+
+
+# Build utilities
+class find_plugins:
+    """Utility for finding plugins."""
+
+    def __init__(self, where, exclude=(), include=("*",)):
+        pass
+
+    def items(self):
+        return []
+
+
+# Additional utilities needed by the CLI
+def resolve_entrypoints(entry_points):
+    """Resolve entry points - dummy implementation."""
+    return []
+
+
+def import_class(location_string):
+    """Import a class from a location string - dummy implementation."""
+    return None
+
+    def __init__(self, fn, namespace=None, name=None):
+        self.fn = fn
+        self.namespace = namespace
+        self.name = name or fn.__name__
+
+    def __call__(self, *args, **kwargs):
+        return self.fn(*args, **kwargs)
+
+
+# CLI-related utilities
+class spec_to_entry_point:
+    """Utility for converting plugin specs to entry points."""
+
+    def __init__(self, spec):
+        self.spec = spec
+
+    @property
+    def value(self):
+        return f"{self.spec.factory.__module__}:{self.spec.factory.__name__}"
+
