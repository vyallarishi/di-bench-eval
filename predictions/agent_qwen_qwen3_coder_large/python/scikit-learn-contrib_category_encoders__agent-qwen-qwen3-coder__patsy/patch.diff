+import numpy as np
+from category_encoders.contrasts import Helmert, Diff, Sum, Poly
+
+# Test Helmert
+levels = ['A', 'B', 'C']
+helmert = Helmert()
+result = helmert.code_without_intercept(levels)
+print("Helmert matrix shape:", result.matrix.shape)
+print("Helmert matrix:\n", result.matrix)
+print("Column suffixes:", result.column_suffixes)
+
+# Test Diff
+diff = Diff()
+result = diff.code_without_intercept(levels)
+print("\nDiff matrix shape:", result.matrix.shape)
+print("Diff matrix:\n", result.matrix)
+print("Column suffixes:", result.column_suffixes)
+
+# Test Sum
+sum_coding = Sum()
+result = sum_coding.code_without_intercept(levels)
+print("\nSum matrix shape:", result.matrix.shape)
+print("Sum matrix:\n", result.matrix)
+print("Column suffixes:", result.column_suffixes)
+
+# Test Poly
+poly = Poly()
+result = poly.code_without_intercept(levels)
+print("\nPoly matrix shape:", result.matrix.shape)
+print("Poly matrix:\n", result.matrix)
+print("Column suffixes:", result.column_suffixes)
