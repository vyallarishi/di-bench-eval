+"""Replacement for patsy.contrasts module"""
+
+import numpy as np
+from typing import List, Union
+
+
+class ContrastMatrix:
+    """A class representing contrast matrices."""
+    
+    def __init__(self, matrix: np.ndarray, column_suffixes: List[str]):
+        self.matrix = matrix
+        self.column_suffixes = column_suffixes
+
+
+class Helmert:
+    """Helmert contrast coding."""
+    
+    def code_without_intercept(self, levels: Union[List, np.ndarray]) -> ContrastMatrix:
+        """Generate Helmert contrast matrix without intercept."""
+        n = len(levels)
+        if n == 1:
+            # Single level case - return empty matrix
+            matrix = np.empty((1, 0))
+            suffixes = []
+        else:
+            # Create Helmert contrast matrix
+            matrix = np.zeros((n, n - 1))
+            for i in range(n - 1):
+                # Each column represents comparison with mean of previous levels
+                matrix[i + 1:, i] = 1.0 / (i + 1)
+                matrix[:i + 1, i] = -1.0
+            
+            # Generate column suffixes
+            suffixes = [f"_{i}" for i in range(n - 1)]
+        
+        return ContrastMatrix(matrix, suffixes)
+
+
+class Diff:
+    """Backward difference contrast coding."""
+    
+    def code_without_intercept(self, levels: Union[List, np.ndarray]) -> ContrastMatrix:
+        """Generate backward difference contrast matrix without intercept."""
+        n = len(levels)
+        if n == 1:
+            # Single level case - return empty matrix
+            matrix = np.empty((1, 0))
+            suffixes = []
+        else:
+            # Create backward difference contrast matrix
+            matrix = np.zeros((n, n - 1))
+            for i in range(n - 1):
+                # Each column compares current level to previous level
+                matrix[:i + 1, i] = -1.0 / (n - 1)
+                matrix[i + 1:, i] = 1.0 / (n - 1)
+            
+            # Generate column suffixes
+            suffixes = [f"_{i}" for i in range(n - 1)]
+        
+        return ContrastMatrix(matrix, suffixes)
+
+
+class Sum:
+    """Sum contrast coding (deviation coding)."""
+    
+    def code_without_intercept(self, levels: Union[List, np.ndarray]) -> ContrastMatrix:
+        """Generate sum contrast matrix without intercept."""
+        levels = list(levels) if not isinstance(levels, list) else levels
+        n = len(levels)
+        if n == 1:
+            # Single level case - return empty matrix
+            matrix = np.empty((1, 0))
+            suffixes = []
+        else:
+            # Create sum contrast matrix
+            matrix = np.zeros((n, n - 1))
+            for i in range(n - 1):
+                matrix[i, i] = 1.0
+                matrix[n - 1, i] = -1.0
+            
+            # Generate column suffixes
+            suffixes = [f"_{i}" for i in range(n - 1)]
+        
+        return ContrastMatrix(matrix, suffixes)
+
+
+class Poly:
+    """Polynomial contrast coding."""
+    
+    def code_without_intercept(self, levels: Union[List, np.ndarray]) -> ContrastMatrix:
+        """Generate polynomial contrast matrix without intercept."""
+        n = len(levels)
+        if n == 1:
+            # Single level case - return empty matrix
+            matrix = np.empty((1, 0))
+            suffixes = []
+        else:
+            # Create orthogonal polynomial contrast matrix
+            # Based on R's contr.poly function
+            scores = np.arange(1, n + 1)
+            matrix = np.zeros((n, n - 1))
+            
+            # Generate orthogonal polynomials using QR decomposition approach
+            for i in range(n - 1):
+                # Simple linear trend for first order
+                if i == 0:
+                    poly = scores - np.mean(scores)
+                # Quadratic trend for second order
+                elif i == 1:
+                    poly = (scores - np.mean(scores)) ** 2 - np.var(scores)
+                # Higher orders
+                else:
+                    poly = (scores - np.mean(scores)) ** (i + 1)
+                
+                # Orthogonalize against previous polynomials
+                for j in range(i):
+                    coef = np.dot(poly, matrix[:, j]) / np.dot(matrix[:, j], matrix[:, j])
+                    poly = poly - coef * matrix[:, j]
+                
+                matrix[:, i] = poly
+            
+            # Normalize
+            for i in range(n - 1):
+                norm = np.sqrt(np.sum(matrix[:, i] ** 2))
+                if norm > 0:
+                    matrix[:, i] /= norm
+            
+            # Generate column suffixes
+            suffixes = [f"_{i}" for i in range(n - 1)]
+        
+        return ContrastMatrix(matrix, suffixes)
