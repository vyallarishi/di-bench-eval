+def to_chalice_response(resp: BoltResponse) -> Any:
+    # Return a chalice Response if chalice is available, otherwise a dict
+    if CHALICE_AVAILABLE:
+        return Response(
+            status_code=resp.status,
+            body=resp.body,
+            headers=resp.first_headers(),  # type: ignore[arg-type]
+        )
+    else:
+        # Return a dict representation for compatibility
+        return {
+            "statusCode": resp.status,
+            "body": resp.body,
+            "headers": resp.first_headers()
+        }
+
+
+def not_found() -> Any:
+    if CHALICE_AVAILABLE:
+        return Response(
+            status_code=404,
+            body="Not found",
+            headers={},
+        )
+    else:
+        return {
+            "statusCode": 404,
+            "body": "Not found",
+            "headers": {}
+        }
