+def lambda_handler(event: Dict[str, Any], context: Any) -> Dict[str, Any]:
+    """AWS Lambda handler function"""
+    # Convert API Gateway event to something that looks like a chalice request
+    class MockRequest:
+        def __init__(self, event_data):
+            self.method = event_data.get('httpMethod', 'POST')
+            self.raw_body = event_data.get('body', '').encode('utf-8') if event_data.get('body') else b''
+            self.headers = event_data.get('headers', {})
+            self.query_params = event_data.get('queryStringParameters') or {}
+            
+        def to_dict(self):
+            return {
+                'method': self.method,
+                'headers': self.headers,
+                'query_params': self.query_params
+            }
+    
+    request = MockRequest(event)
+    response = slack_handler.handle(request)
+    
+    # Ensure response is in the correct format for API Gateway
+    if isinstance(response, dict) and 'statusCode' in response:
+        return response
+    else:
+        # Convert chalice Response to dict format
+        return {
+            'statusCode': getattr(response, 'status_code', 200),
+            'body': getattr(response, 'body', ''),
+            'headers': getattr(response, 'headers', {})
+        }
+
+
