+#!/usr/bin/env python3
+"""Test script to verify that our pip-related changes work correctly."""
+
+import sys
+import os
+
+# Add the chalice directory to the path so we can import from it
+sys.path.insert(0, '.')
+
+def test_pip_import_string_handles_missing_pip():
+    """Test that pip_import_string works even when pip is not importable."""
+    from chalice.compat import pip_import_string
+    
+    # Save the original __import__ function
+    if isinstance(__builtins__, dict):
+        original_import = __builtins__['__import__']
+    else:
+        original_import = __builtins__.__import__
+    
+    # Mock __import__ to simulate pip not being importable
+    def mock_import(name, *args, **kwargs):
+        if name == 'pip':
+            raise ImportError("Mocked: pip not available")
+        return original_import(name, *args, **kwargs)
+    
+    # Temporarily replace __import__
+    if isinstance(__builtins__, dict):
+        __builtins__['__import__'] = mock_import
+    else:
+        __builtins__.__import__ = mock_import
+    
+    try:
+        # This should not raise an exception
+        result = pip_import_string()
+        print(f"pip_import_string returned: {result}")
+        # Should return a fallback string
+        assert isinstance(result, str)
+        assert len(result) > 0
+        print("SUCCESS: pip_import_string handled missing pip gracefully")
+    finally:
+        # Restore the original __import__
+        if isinstance(__builtins__, dict):
+            __builtins__['__import__'] = original_import
+        else:
+            __builtins__.__import__ = original_import
+
+
+def test_pip_import_string_with_pip():
+    """Test that pip_import_string works when pip is available."""
+    from chalice.compat import pip_import_string
+    
+    # This should work normally when pip is available
+    result = pip_import_string()
+    print(f"pip_import_string with real pip returned: {result}")
+    assert isinstance(result, str)
+    assert len(result) > 0
+    print("SUCCESS: pip_import_string worked with real pip")
+if __name__ == '__main__':
+    print("Testing pip compatibility changes...")
+    
+    # Test with real pip first
+    try:
+        test_pip_import_string_with_pip()
+    except Exception as e:
+        print(f"Note: Real pip test failed: {e}")
+    
+    # Test with mocked missing pip
+    try:
+        test_pip_import_string_handles_missing_pip()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        sys.exit(1)
+    assert len(result) > 0
+    print("SUCCESS: pip_import_string worked with real pip")
+
+if __name__ == '__main__':
+    print("Testing pip compatibility changes...")
+    
+    # Test with real pip first
+    try:
+        test_pip_import_string_with_pip()
+    except Exception as e:
+        print(f"Note: Real pip test failed: {e}")
+    
+    # Test with mocked missing pip
+    test_pip_import_string_handles_missing_pip()
+    
+    print("All tests passed!")
