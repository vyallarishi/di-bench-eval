+#!/usr/bin/env python
+"""Final verification test"""
+
+import sys
+
+print("=== Final Verification ===")
+
+# Test 1: Import should work
+try:
+    from category_encoders import GLMMEncoder
+    print("✓ GLMMEncoder import successful")
+except Exception as e:
+    print(f"✗ Import failed: {e}")
+    sys.exit(1)
+
+# Test 2: Using it should raise ImportError when statsmodels is not available
+try:
+    import pandas as pd
+    import numpy as np
+    
+    # Create minimal test data
+    data = pd.DataFrame({
+        'col1': ['A', 'B', 'C'],
+        'target': [1, 0, 1]
+    })
+    
+    encoder = GLMMEncoder()
+    encoder.fit(data[['col1']], data['target'])
+    print("✗ ERROR: Should have raised ImportError!")
