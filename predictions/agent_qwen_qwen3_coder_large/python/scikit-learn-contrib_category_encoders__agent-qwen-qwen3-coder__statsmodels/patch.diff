+#!/usr/bin/env python
+# Test script to verify GLMMEncoder behaves correctly without statsmodels
+
+import sys
+import unittest
+
+try:
+    import statsmodels
+    STATSMODELS_AVAILABLE = True
+except ImportError:
+    STATSMODELS_AVAILABLE = False
+
+if not STATSMODELS_AVAILABLE:
+    print("statsmodels not available - testing import error handling")
+    
+    # Test that importing works but using raises ImportError
+    try:
+        from category_encoders import GLMMEncoder
+        print("Import successful")
+    except Exception as e:
+        print(f"Import failed: {e}")
+        sys.exit(1)
+        
+    # Test that using the encoder raises ImportError
+    try:
+        import pandas as pd
+        import numpy as np
+        
+        # Create sample data
+        data = pd.DataFrame({
+            'col1': ['A', 'B', 'C', 'A', 'B'],
+            'target': [1, 0, 1, 0, 1]
+        })
+        
+        encoder = GLMMEncoder()
+        encoder.fit(data[['col1']], data['target'])
+        print("ERROR: Should have raised ImportError!")
+        sys.exit(1)
+    except ImportError as e:
+        if "statsmodels is required" in str(e):
+            print("Correctly raised ImportError for missing statsmodels")
+        else:
+            print(f"Wrong ImportError message: {e}")
+            sys.exit(1)
+    except Exception as e:
+        print(f"Unexpected error: {e}")
+        sys.exit(1)
+else:
+    print("statsmodels available - skipping import error tests")
+
+print("All tests passed!")
