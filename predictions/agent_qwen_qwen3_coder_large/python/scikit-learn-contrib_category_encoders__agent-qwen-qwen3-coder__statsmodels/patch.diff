+#!/usr/bin/env python
+"""Final verification test"""
+
+import sys
+
+print("=== Final Verification ===")
+
+# Test 1: Import should work
+try:
+    from category_encoders import GLMMEncoder
+    print("✓ GLMMEncoder import successful")
+except Exception as e:
+    print(f"✗ Import failed: {e}")
+    sys.exit(1)
+
+# Test 2: Using it should raise ImportError when statsmodels is not available
+try:
+    import pandas as pd
+    import numpy as np
+    
+    # Create minimal test data
+    data = pd.DataFrame({
+        'col1': ['A', 'B', 'C'],
+        'target': [1, 0, 1]
+    })
+    
+    encoder = GLMMEncoder()
+    encoder.fit(data[['col1']], data['target'])
+    print("✗ ERROR: Should have raised ImportError!")
+    sys.exit(1)
+except ImportError as e:
+    if "statsmodels is required" in str(e):
+        print("✓ Correctly raised ImportError for missing statsmodels")
+    else:
+        print(f"✗ Wrong ImportError: {e}")
+        sys.exit(1)
+except Exception as e:
+    print(f"✗ Unexpected error: {e}")
+    sys.exit(1)
+
+print("✓ All tests passed!")
+print("")
+print("Summary:")
+print("- GLMMEncoder can be imported without statsmodels")
+print("- GLMMEncoder raises helpful ImportError when used without statsmodels")
+print("- Other encoders continue to work normally")
+print("- Requirements.txt no longer includes statsmodels")
