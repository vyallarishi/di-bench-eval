@@ -0,0 +1,258 @@
+"""
+Data utilities to replace pandas functionality with native Python data structures.
+"""
+
+from collections import defaultdict
+from typing import Dict, List, Any, Optional, Union
+import math
+
+
+class DataFrame:
+    """
+    A simple DataFrame implementation that mimics pandas DataFrame functionality
+    needed for this project.
+    """
+    
+    def __init__(self, data=None, columns=None):
+        """
+        Initialize DataFrame from dictionary or list of dictionaries.
+        
+        Args:
+            data: Either a dict of lists/columns or list of row dicts
+            columns: Column names (optional when data is dict)
+        """
+        if data is None:
+            self._data = {}
+            self.columns = columns or []
+            return
+            
+        if isinstance(data, dict):
+            # Dictionary of columns
+            self._data = data
+            self.columns = list(data.keys()) if columns is None else columns
+        elif isinstance(data, list):
+            # List of dictionaries (rows)
+            if not data:
+                self._data = {}
+                self.columns = columns or []
+            else:
+                # Infer columns from first row if not provided
+                if columns is None:
+                    columns = list(data[0].keys())
+                
+                self.columns = columns
+                self._data = {col: [] for col in columns}
+                
+                # Populate data
+                for row in data:
+                    for col in columns:
+                        self._data[col].append(row.get(col, None))
+        else:
+            raise ValueError("Data must be dict or list")
+            
+        # Ensure all columns exist
+        for col in self.columns:
+            if col not in self._data:
+                self._data[col] = []
+                
+    def __len__(self):
+        """Return number of rows."""
+        if not self.columns:
+            return 0
+        return len(self._data[self.columns[0]])
+        
+    def __getitem__(self, key):
+        """Get column or filter by condition."""
+        if isinstance(key, str):
+            # Return column as list
+            return self._data[key]
+        elif isinstance(key, list):
+            # Return subset of columns
+            new_data = {col: self._data[col] for col in key}
+            return DataFrame(new_data)
+        else:
+            # Assume boolean indexing
+            indices = [i for i, cond in enumerate(key) if cond]
+            new_data = {}
+            for col in self.columns:
+                new_data[col] = [self._data[col][i] for i in indices]
+            return DataFrame(new_data, self.columns)
+            
+    def __setitem__(self, key, value):
+        """Set column values."""
+        if isinstance(value, list):
+            if len(value) != len(self):
+                raise ValueError("Length mismatch")
+            self._data[key] = value
+            if key not in self.columns:
+                self.columns.append(key)
+        else:
+            # Broadcast single value
+            self._data[key] = [value] * len(self)
+            if key not in self.columns:
+                self.columns.append(key)
+                
+    def append(self, other):
+        """Append another DataFrame (concatenate vertically)."""
+        if not self.columns:
+            self.columns = other.columns[:]
+            self._data = {col: vals[:] for col, vals in other._data.items()}
+            return
+            
+        if set(self.columns) != set(other.columns):
+            raise ValueError("Columns don't match")
+            
+        for col in self.columns:
+            self._data[col].extend(other._data[col])
+            
+    def copy(self):
+        """Create a copy of the DataFrame."""
+        new_data = {col: vals[:] for col, vals in self._data.items()}
+        return DataFrame(new_data, self.columns[:])
+        
+    def drop(self, columns):
+        """Drop specified columns."""
+        new_data = {col: vals for col, vals in self._data.items() if col not in columns}
+        new_columns = [col for col in self.columns if col not in columns]
+        return DataFrame(new_data, new_columns)
+        
+    def fillna(self, value, inplace=False):
+        """Fill NaN values."""
+        if inplace:
+            target = self
+        else:
+            target = self.copy()
+            
+        for col in target.columns:
+            target._data[col] = [value if val is None else val for val in target._data[col]]
+            
+        return None if inplace else target
+        
+    def groupby(self, column):
+        """Group by column and return GroupBy object."""
+        return GroupBy(self, column)
+        
+    def join(self, other, on=None, how='left'):
+        """Join with another DataFrame."""
+        if on is None:
+            raise ValueError("Must specify 'on' column for join")
+            
+        # Create mapping from other DataFrame
+        if isinstance(on, str):
+            left_on = right_on = on
+        elif isinstance(on, tuple):
+            left_on, right_on = on
+        else:
+            raise ValueError("'on' must be string or tuple")
+            
+        # Build lookup table from other DataFrame
+        other_lookup = {}
+        other_indices = {}
+        for i, key_val in enumerate(other._data[right_on]):
+            if key_val not in other_lookup:
+                other_lookup[key_val] = {}
+                other_indices[key_val] = i
+            # Store the first occurrence of each key
+            if key_val not in other_lookup or i == other_indices[key_val]:
+                for col in other.columns:
+                    if col != right_on:  # Don't duplicate the join column
+                        other_lookup[key_val][col] = other._data[col][i]
+                        
+        # Perform join
+        result_data = {col: [] for col in self.columns}
+        joined_cols = []
+        
+        # Add columns from other DataFrame (except the join column which already exists)
+        for col in other.columns:
+            if col != right_on:
+                result_data[col] = []
+                joined_cols.append(col)
+                
+        for i in range(len(self)):
+            key_val = self._data[left_on][i]
+            result_data[left_on].append(key_val)
+            
+            if key_val in other_lookup:
+                # Found matching row
+                for col in self.columns:
+                    if col != left_on:
+                        result_data[col].append(self._data[col][i])
+                for col in joined_cols:
+                    result_data[col].append(other_lookup[key_val].get(col, None))
+            elif how == 'left':
+                # Left join - keep row with None for missing values
+                for col in self.columns:
+                    if col != left_on:
+                        result_data[col].append(self._data[col][i])
+                for col in joined_cols:
+                    result_data[col].append(None)
+            # For inner join, we would skip unmatched rows
+                    
+        result_columns = self.columns + joined_cols
+        return DataFrame(result_data, result_columns)
+        
+    def transform(self, func):
+        """Apply function to each element."""
+        result_data = {}
+        for col in self.columns:
+            result_data[col] = [func(val) for val in self._data[col]]
+        return DataFrame(result_data, self.columns)
+
+
+class GroupBy:
+    """Simple GroupBy implementation."""
+    
+    def __init__(self, df, column):
+        self.df = df
+        self.column = column
+        # Group indices by column value
+        self.groups = defaultdict(list)
+        for i, val in enumerate(df._data[column]):
+            self.groups[val].append(i)
+            
+    def transform(self, func_name):
+        """Apply aggregation function to each group."""
+        if func_name == "size":
+            result = []
+            for val in self.df._data[self.column]:
+                result.append(len(self.groups[val]))
+            return result
+        else:
+            raise ValueError(f"Unsupported transform function: {func_name}")
+            
+    def agg(self, func_name):
+        """Aggregate each group."""
+        if func_name == "sum":
+            result_data = {col: [] for col in self.df.columns}
+            keys = []
+            for key, indices in self.groups.items():
+                keys.append(key)
+                for col in self.df.columns:
+                    if col == self.column:
+                        result_data[col].append(key)
+                    else:
+                        result_data[col].append(sum(self.df._data[col][i] for i in indices))
+            return DataFrame(result_data, self.df.columns)
+        else:
+            raise ValueError(f"Unsupported agg function: {func_name}")
+
+
+def concat(dfs):
+    """Concatenate list of DataFrames."""
+    if not dfs:
+        return DataFrame()
+        
+    result = dfs[0].copy()
+    for df in dfs[1:]:
+        result.append(df)
+    return result
+
+
+def isna(val):
+    """Check if value is NaN-like."""
+    return val is None or (isinstance(val, float) and math.isnan(val))
+
+
+def merge(left, right, on, how='inner'):
+    """Merge two DataFrames."""
+    return left.join(right, on=on, how=how)
