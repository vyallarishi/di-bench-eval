@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+
+"""
+Test script to verify pefile removal works correctly
+"""
+
+def test_pefile_not_available():
+    """Test that the system handles missing pefile gracefully"""
+    try:
+        import speakeasy.speakeasy as se
+        print("Speakeasy imported successfully")
+        
+        # Try to create an instance - this should fail gracefully if pefile is missing
+        try:
+            # This would normally require pefile
+            s = se.Speakeasy()
+            print("Speakeasy instance created")
+        except RuntimeError as e:
+            if "pefile library is required" in str(e):
+                print("Correctly handled missing pefile dependency")
+            else:
+                print(f"Unexpected error: {e}")
+        except Exception as e:
+            print(f"Other error occurred: {e}")
+            
+    except Exception as e:
+        print(f"Failed to import speakeasy: {e}")
+
+if __name__ == "__main__":
+    test_pefile_not_available()
