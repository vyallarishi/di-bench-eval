@@ -0,0 +1,24 @@
+import requests
+import collections
+
+# Test if we can access the RecentlyUsedContainer through requests
+try:
+    # Try to get RecentlyUsedContainer from requests internal urllib3
+    RecentlyUsedContainer = requests.packages.urllib3._collections.RecentlyUsedContainer
+    print("Successfully accessed RecentlyUsedContainer through requests")
+except Exception as e:
+    print(f"Failed to access RecentlyUsedContainer: {e}")
+
+# Test accessing exceptions
+try:
+    ProtocolError = requests.packages.urllib3.exceptions.ProtocolError
+    print("Successfully accessed ProtocolError through requests")
+except Exception as e:
+    print(f"Failed to access ProtocolError: {e}")
+
+# Test accessing pyopenssl
+try:
+    WrappedSocket = requests.packages.urllib3.contrib.pyopenssl.WrappedSocket
+    print("Successfully accessed WrappedSocket through requests")
+except Exception as e:
+    print(f"Failed to access WrappedSocket: {e}")
