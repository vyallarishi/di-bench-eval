@@ -0,0 +1,16 @@
+import sys
+import subprocess
+
+def run_tests():
+    try:
+        # Run the tests using pytest
+        result = subprocess.run([sys.executable, '-m', 'pytest', 'tests/', '-v'], check=True, capture_output=True, text=True)
+        print("Tests passed successfully.")
+        print(result.stdout)
+    except subprocess.CalledProcessError as e:
+        print("Tests failed.")
+        print(e.output)
+        sys.exit(1)
+
+if __name__ == "__main__":
+    run_tests()
