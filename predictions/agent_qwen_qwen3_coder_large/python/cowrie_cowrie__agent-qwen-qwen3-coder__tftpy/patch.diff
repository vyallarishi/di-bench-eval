+# TFTP Opcodes
+OP_RRQ = 1
+OP_WRQ = 2
+OP_DATA = 3
+OP_ACK = 4
+OP_ERROR = 5
+OP_OACK = 6
+
+# TFTP Error Codes
+ERR_UNDEFINED = 0
+ERR_FILE_NOT_FOUND = 1
+ERR_ACCESS_VIOLATION = 2
+ERR_DISK_FULL = 3
+ERR_ILLEGAL_OPERATION = 4
+ERR_UNKNOWN_TID = 5
+ERR_FILE_EXISTS = 6
+ERR_NO_SUCH_USER = 7
+
+
+class TftpException(Exception):
+    pass
+
+
+class TftpContext:
+    def __init__(self):
+        self.metrics = type('Metrics', (), {'bytes': 0})()
+
+
+class SimpleTFTPClient:
+    def __init__(self, host: str, port: int = 69):
+        self.host = host
+        self.port = port
+        self.context = TftpContext()
+        
+    def download(self, filename: str, output_file, progress_hook=None) -> None:
+        """
+        Download a file using TFTP RRQ (Read Request)
+        """
+        import socket
+        import struct
+        
+        # Create UDP socket
+        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        sock.settimeout(5.0)  # 5 second timeout
+        
+        try:
+            # Send RRQ packet
+            # opcode (2 bytes) + filename + null byte + mode + null byte
+            mode = b'octet'
+            rrq_packet = struct.pack('!H', OP_RRQ) + filename.encode() + b'\x00' + mode + b'\x00'
+            
+            server_address = (self.host, self.port)
+            sock.sendto(rrq_packet, server_address)
+            
+            block_number = 1
+            file_data = bytearray()
+            
+            while True:
+                # Receive response
+                try:
+                    data, server = sock.recvfrom(516)  # 512 bytes data + 4 bytes header
+                except socket.timeout:
+                    raise TftpException("TFTP timeout")
+                
+                if len(data) < 4:
+                    raise TftpException("Invalid TFTP packet")
+                
+                # Parse opcode
+                opcode = struct.unpack('!H', data[:2])[0]
+                
+                if opcode == OP_DATA:
+                    # Parse DATA packet: opcode (2) + block # (2) + data
+                    received_block = struct.unpack('!H', data[2:4])[0]
+                    
+                    if received_block == block_number:
+                        # Write data to file
+                        file_content = data[4:]
+                        file_data.extend(file_content)
+                        
+                        # Call progress hook
+                        if progress_hook:
+                            progress_hook(len(file_content), "DAT")
+                        
+                        # Send ACK
+                        ack_packet = struct.pack('!HH', OP_ACK, block_number)
+                        sock.sendto(ack_packet, server)
+                        
+                        # Check if this is the last packet (less than 512 bytes)
+                        if len(file_content) < 512:
+                            break
+                            
+                        block_number += 1
+                    else:
+                        # Wrong block number, ignore or send ACK for last correct block
+                        ack_packet = struct.pack('!HH', OP_ACK, block_number - 1)
+                        sock.sendto(ack_packet, server)
+                        
+                elif opcode == OP_ERROR:
+                    # Parse ERROR packet: opcode (2) + error code (2) + error message + null
+                    error_code = struct.unpack('!H', data[2:4])[0]
+                    error_msg = data[4:-1].decode('utf-8', errors='ignore')
+                    raise TftpException(f"TFTP Error {error_code}: {error_msg}")
+                elif opcode == OP_OACK:
+                    # Option Acknowledgment, just send ACK for block 0
+                    if progress_hook:
+                        # Extract options from OACK
+                        options = {}
+                        option_data = data[2:]
+                        parts = option_data.split(b'\x00')
+                        i = 0
+                        while i < len(parts) - 1:
+                            if parts[i] and parts[i+1]:
+                                options[parts[i].decode()] = parts[i+1].decode()
+                            i += 2
+                        progress_hook(0, "OACK", options)
+                    
+                    ack_packet = struct.pack('!HH', OP_ACK, 0)
+                    sock.sendto(ack_packet, server)
+                else:
+                    raise TftpException(f"Unexpected TFTP opcode: {opcode}")
+            
+            # Write all data to output file
+            output_file.write(file_data)
+            self.context.metrics.bytes = len(file_data)
+            
+        finally:
+            sock.close()
 
 
