+#!/usr/bin/env python
+"""Test script to verify our changes work correctly."""
+
+import sys
+import os
+from unittest.mock import patch, MagicMock
+try:
+    from StringIO import StringIO
+except ImportError:
+    from io import StringIO
+
+# Add the chalice directory to the path so we can import from it
+sys.path.insert(0, '.')
+
+def test_getting_started_prompt():
+    """Test that our new implementation works correctly."""
+    from chalice.cli.newproj import getting_started_prompt
+    
+    # Mock input to simulate user responses
+    inputs = ['myproject', '1']  # Project name, then first project type
+    input_counter = 0
+    
+    def mock_input(prompt):
+        nonlocal input_counter
+        print(f"Prompt: {prompt}")
+        response = inputs[input_counter]
+        input_counter += 1
+        print(f"Response: {response}")
+        return response
+    
+    # Mock the input function and test
+    with patch('builtins.input', side_effect=mock_input):
+        with patch('chalice.cli.newproj.print') as mock_print:
+            result = getting_started_prompt()
+            
+    print("Result:", result)
+    assert 'project_name' in result
+    assert 'project_type' in result
+    assert result['project_name'] == 'myproject'
+    print("Test passed!")
+
+if __name__ == '__main__':
+    test_getting_started_prompt()
