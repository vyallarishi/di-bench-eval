diff --git a/localstack-core/localstack/utils/ttlcache.py b/localstack-core/localstack/utils/ttlcache.py
new file mode 100644
index 0000000..bf3f0b8
--- /dev/null
+++ b/localstack-core/localstack/utils/ttlcache.py
@@ -0,0 +1,99 @@
+import time
+import functools
+from typing import Any, Callable, Dict, Optional, Union
+from collections import OrderedDict
+
+
+class TTLCache:
+    """
+    Simple TTL cache implementation to replace cachetools.TTLCache
+    """
+    
+    def __init__(self, maxsize: int, ttl: Union[int, float]):
+        self.maxsize = maxsize
+        self.ttl = ttl
+        self._cache = OrderedDict()  # key -> (value, expiry_time)
+        
+    def __getitem__(self, key):
+        if key not in self._cache:
+            raise KeyError(key)
+            
+        value, expiry = self._cache[key]
+        if time.time() > expiry:
+            del self._cache[key]
+            raise KeyError(key)
+            
+        # Move to end for LRU behavior
+        self._cache.move_to_end(key)
+        return value
+        
+    def __setitem__(self, key, value):
+        expiry = time.time() + self.ttl
+        self._cache[key] = (value, expiry)
+        self._cache.move_to_end(key)
+        
+        # Remove expired entries
+        self._remove_expired()
+        
+        # Enforce maxsize
+        if len(self._cache) > self.maxsize:
+            self._cache.popitem(last=False)
+            
+    def __delitem__(self, key):
+        del self._cache[key]
+        
+    def __contains__(self, key):
+        try:
+            self.__getitem__(key)
+            return True
+        except KeyError:
+            return False
+            
+    def __len__(self):
+        self._remove_expired()
+        return len(self._cache)
+        
+    def clear(self):
+        self._cache.clear()
+        
+    def _remove_expired(self):
+        now = time.time()
+        expired_keys = []
+        for key, (_, expiry) in self._cache.items():
+            if now > expiry:
+                expired_keys.append(key)
+                
+        for key in expired_keys:
+            del self._cache[key]
+            
+    def get(self, key, default=None):
+        try:
+            return self.__getitem__(key)
+        except KeyError:
+            return default
+
+
+def cached(cache: TTLCache, key: Optional[Callable] = None):
+    """
+    Decorator to cache function results with TTL.
+    Replacement for cachetools.cached
+    """
+    def decorator(func):
+        @functools.wraps(func)
+        def wrapper(*args, **kwargs):
+            # Generate cache key
+            if key is None:
+                cache_key = str(args) + str(sorted(kwargs.items()))
+            else:
+                cache_key = key(*args, **kwargs)
+                
+            # Check cache
+            if cache_key in cache:
+                return cache[cache_key]
+                
+            # Call function and cache result
+            result = func(*args, **kwargs)
+            cache[cache_key] = result
+            return result
+        return wrapper
+    return decorator
