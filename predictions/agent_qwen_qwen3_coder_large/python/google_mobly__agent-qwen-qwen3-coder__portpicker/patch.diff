-    port = portpicker.pick_unused_port()
+    # Create a socket and bind to port 0, which requests the OS to allocate
+    # an available port. Then close the socket immediately to free the port.
+    # This is a more reliable way to get an available port than other methods.
+    try:
+      s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+      s.bind(('localhost', 0))
+      port = s.getsockname()[1]
+      s.close()
+      
+      if not adb.is_adb_available():
+        return port
+      # Make sure adb is not using this port so we don't accidentally
+      # interrupt ongoing runs by trying to bind to the port.
+      if port not in adb.list_occupied_adb_ports():
+        return port
+    except socket.error:
+      # If there's an error creating or binding the socket, continue to retry
+      continue
+      
